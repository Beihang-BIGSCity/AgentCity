print(f"\\nResults saved to: {results_file}")\n        return results_file\n    \n    def print_summary(self):\n        """Print summary of tuning results"""\n        print(f"\\n{\'=\'*80}")\n        print(f"STD-MAE Tuning Summary")\n        print(f"{\'=\'*80}")\n        print(f"Total Trials: {len(self.results)}")\n        \n        completed = sum(1 for r in self.results if r.get(\'status\') == \'completed\')\n        failed = sum(1 for r in self.results if r.get(\'status\') == \'failed\')\n        timeout = sum(1 for r in self.results if r.get(\'status\') == \'timeout\')\n        error = sum(1 for r in self.results if r.get(\'status\') == \'error\')\n        \n        print(f"Completed: {completed}")\n        print(f"Failed: {failed}")\n        print(f"Timeout: {timeout}")\n        print(f"Error: {error}")\n        \n        if self.results:\n            avg_time = sum(r.get(\'elapsed_time\', 0) for r in self.results) / len(self.results)\n            print(f"Average Time per Trial: {avg_time:.1f}s")\n        \n        print(f"{\'=\'*80}\\n")\n\n\nif __name__ == "__main__":\n    tuner = STDMAETuner(libcity_path)\n    \n    # Execute Phase 1\n    print("Initializing STD-MAE Tuner...")\n    tuner.execute_phase1()\n    tuner.save_results()\n    tuner.print_summary()\n    \n    print(f"\\nTuning output directory: {tuner.output_dir}")\nEOF\npython /tmp/stdmae_tuning.py\n', 'description': 'Create and execute STD-MAE tuning script', 'timeout': 300000}
