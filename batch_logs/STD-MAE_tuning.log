     }\n    \n    def generate_trials(self):\n        """Generate all trial combinations"""\n        search_space = self.create_search_space()\n        fixed = self.create_fixed_params()\n        \n        # Generate all combinations\n        param_names = list(search_space.keys())\n        param_values = [search_space[k] for k in param_names]\n        \n        trials = []\n        for combination in itertools.product(*param_values):\n            trial_params = dict(zip(param_names, combination))\n            trial_params.update(fixed)\n            trials.append(trial_params)\n        \n        return trials\n    \n    def run_trial(self, trial_id, params):\n        """Execute a single trial"""\n        base_config = self.load_base_config()\n        base_config.update(params)\n        \n        trial_dir = os.path.join(self.output_dir, f"trial_{trial_id}")\n        Path(trial_dir).mkdir(parents=True, exist_ok=True)\n        \n        # Save config for this trial\n        config_file = os.path.join(trial_dir, "config.json")\n        with open(config_file, \'w\') as f:\n            json.dump(base_config, f, indent=2)\n        \n        # Copy to standard location temporarily\n        backup_config = self.config_path + ".backup"\n        shutil.copy(self.config_path, backup_config)\n        \n        try:\n            shutil.copy(config_file, self.config_path)\n            \n            print(f"\\n{\'=\'*80}")\n            print(f"Trial {trial_id}: Starting")\n            print(f"{\'=\'*80}")\n            print(f"Learning Rate: {params.get(\'learning_rate\', \'N/A\')}")\n            print(f"Batch Size: {params.get(\'batch_size\', \'N/A\')}")\n            print(f"Dropout: {params.get(\'dropout\', \'N/A\')}")\n            print(f"Residual Channels: {params.get(\'residual_channels\', \'N/A\')}")\n            print(f"Skip Channels: {params.get(\'skip_channels\', \'N/A\')}")\n            print(f"Config saved to: {config_file}")\n            print(f"Trial dir: {trial_dir}")