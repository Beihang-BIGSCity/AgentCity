ch": 100,\n            "mlp_ratio": 4\n        }\n    \n    def generate_trials(self):\n        """Generate all trial combinations"""\n        search_space = self.create_search_space()\n        fixed = self.create_fixed_params()\n        \n        # Generate all combinations\n        param_names = list(search_space.keys())\n        param_values = [search_space[k] for k in param_names]\n        \n        trials = []\n        for combination in itertools.product(*param_values):\n            trial_params = dict(zip(param_names, combination))\n            trial_params.update(fixed)\n            trials.append(trial_params)\n        \n        return trials\n    \n    def run_trial(self, trial_id, params):\n        """Execute a single trial"""\n        base_config = self.load_base_config()\n        base_config.update(params)\n        \n        trial_dir = os.path.join(self.output_dir, f"trial_{trial_id}")\n        Path(trial_dir).mkdir(parents=True, exist_ok=True)\n        \n        # Save config for this trial\n        config_file = os.path.join(trial_dir, "config.json")\n        with open(config_file, \'w\') as f:\n            json.dump(base_config, f, indent=2)\n        \n        # Copy to standard location temporarily\n        backup_config = self.config_path + ".backup"\n        shutil.copy(self.config_path, backup_config)\n        \n        try:\n            shutil.copy(config_file, self.config_path)\n            \n            print(f"\\n{\'=\'*80}")\n            print(f"Trial {trial_id}: Starting")\n            print(f"{\'=\'*80}")\n            print(f"Learning Rate: {params.get(\'learning_rate\', \'N/A\')}")\n            print(f"Batch Size: {params.get(\'batch_size\', \'N/A\')}")\n            print(f"Dropout: {params.get(\'dropout\', \'N/A\')}")\n            print(f"Residual Channels: {params.get(\'residual_channels\', \'N/A\')}")\n            print(f"Skip Channels: {params.get(\'skip_channels\', \'N/A\')}")\n            print(f"Config saved to: {config_file}")\n            print(f"Trial dir: {trial_dir}")\n            \n            # Run training using run_model.py with correct boolean argument\n            run_script = os.path.join(self.libcity_root, "run_model.py")\n            cmd = [\n                "python", run_script,\n                "--task", "traffic_state_pred",\n                "--model", "STDMAE",\n                "--dataset", "METR_LA",\n                "--gpu", "True",  # Corrected: use True instead of "0"\n                "--gpu_id", "0",\n                "--train", "True",\n                "--saved_model", "True",\n                "--max_epoch", str(params.get(\'max_epoch\', 100))\n            ]\n            \n            start_time = time.time()\n            result = subprocess.run(cmd, cwd=self.libcity_root, capture_output=True, text=True, timeout=7200)\n            elapsed_time = time.time() - start_time\n            \n            # Parse results\n            trial_result = {\n                "trial_id": trial_id,\n                "params": params,\n                "elapsed_time": elapsed_time,\n                "status": "completed" if result.returncode == 0 else "failed",\n                "stdout": result.stdout[-2000:] if result.stdout else "",\n                "stderr": result.stderr[-2000:] if result.stderr else ""\n            }\n            \n            # Try to extract metrics from output\n            if result.returncode == 0:\n                print(f"Trial {trial_id}: COMPLETED in {elapsed_time:.1f}s")\n                # Parse metrics if available\n                self._parse_metrics(trial_result, result.stdout)\n            else:\n                print(f"Trial {trial_id}: FAILED")\n                print(f"Error: {result.stderr[-500:]}")\n            \n            self.results.append(trial_result)\n            return trial_result\n            \n        except subprocess.TimeoutExpired:\n            trial_result = {\n                "trial_id": trial_id,\n                "params": params,\n                "elapsed_time": 7200,\n                "status": "timeout",\n                "stdout": "",\n                "stderr": "Trial timed out after 2 hours"\n            }\n            self.results.append(trial_result)\n            print(f"Trial {trial_id}: TIMEOUT")\n            return trial_result\n        \n        except Exception as e:\n            trial_result = {\n                "trial_id": trial_id,\n                "params": params,\n                "elapsed_time": 0,\n                "status": "error",\n                "stdout": "",\n                "stderr": str(e)\n            }\n            self.results.append(trial_result)\n            print(f"Trial {trial_id}: ERROR - {e}")\n            return trial_result\n        \n        finally:\n            # Restore backup\n            if os.path.exists(backup_config):\n                shutil.move(backup_config, self.config_path)\n    \n    def _parse_metrics(self, trial_result, stdout):\n        """Try to parse metrics from training output"""\n        # Look for common metric patterns\n        if "MAE" in stdout or "mae" in stdout:\n            trial_result["has_metrics"] = True\n    \n    def execute_phase1(self, max_trials=None):\n        """Execute Phase 1 tuning"""\n        trials = self.generate_trials()\n        \n        if max_trials:\n            trials = trials[:max_trials]\n        \n        print(f"\\n{\'=\'*80}")\n        print(f"STD-MAE Phase 1 Hyperparameter Tuning")\n        print(f"{\'=\'*80}")\n        print(f"Total Trials: {len(trials)}")\n        print(f"Output Directory: {self.output_dir}")\n        print(f"{\'=\'*80}\\n")\n        \n        for trial_id, params in enumerate(trials, 1):\n            try:\n                self.run_trial(trial_id, params)\n            except KeyboardInterrupt:\n                print(f"\\nTuning interrupted at trial {trial_id}")\n                break\n            except Exception as e:\n                print(f"Error in trial {trial_id}: {e}")\n                continue\n        \n        return self.results\n    \n    def save_results(self):\n        """Save all results to JSON"""\n        results_file = os.path.join(self.output_dir, "tuning_results.json")\n        with open(results_file, \'w\') as f:\n            json.dump({\n                "timestamp": self.timestamp,\n                "total_trials": len(self.results),\n                "output_dir": self.output_dir,\n                "results": self.results\n            }, f, indent=2)\n        \n        print(f"\\nResults saved to: {results_file}")\n        return results_file\n    \n    def print_summary(self):\n        """Print summary of tuning results"""\n        print(f"\\n{\'=\'*80}")\n        print(f"STD-MAE Tuning Summary")\n        print(f"{\'=\'*80}")\n        print(f"Total Trials: {len(self.results)}")\n        \n        completed = sum(1 for r in self.results if r.get(\'status\') == \'completed\')\n        failed = sum(1 for r in self.results if r.get(\'status\') == \'failed\')\n        timeout = sum(1 for r in self.results if r.get(\'status\') == \'timeout\')\n        error = sum(1 for r in self.results if r.get(\'status\') == \'error\')\n        \n        print(f"Completed: {completed}")\n        print(f"Failed: {failed}")\n        print(f"Timeout: {timeout}")\n        print(f"Error: {error}")\n        \n        if self.results:\n            avg_time = sum(r.get(\'elapsed_time\', 0) for r in self.results) / len(self.results)\n            print(f"Average Time per Trial: {avg_time:.1f}s")\n        \n        print(f"{\'=\'*80}\\n")\n\n\nif __name__ == "__main__":\n    tuner = STDMAETuner(libcity_path)\n    \n    # Execute Phase 1\n    print("Initializing STD-MAE Tuner...")\n    tuner.execute_phase1()\n    tuner.save_results()\n    tuner.print_summary()\n    \n    print(f"\\nTuning output directory: {tuner.output_dir}")\nEOF\npython /tmp/stdmae_tuning_v2.py 2>&1 | head -200\n', 'description': 'Create and execute corrected STD-MAE tuning script with boolean GPU flag', 'timeout': 300000}
