selines/D2STGNN/METR-LA.py`\n\n### Model Parameters and Fusion Configuration\n\n```python\n# Model architecture configuration for D2STGNN with event fusion\nMODEL_PARAM = {\n    # Traffic feature dimension\n    "num_feat": 1,                      # Single traffic feature (speed)\n    "num_hidden": 32,                   # Hidden state dimension\n    "dropout": 0.1,\n    \n    # Temporal parameters\n    "seq_length": 12,                   # Input sequence: 12 time steps (60 minutes)\n    "k_t": 3,                           # Temporal convolution kernel size\n    "gap": 3,\n    \n    # Spatial parameters\n    "k_s": 2,                           # Spatial convolution kernel size\n    "num_nodes": 207,                   # Number of sensors in METR-LA\n    "adjs": [torch.tensor(adj) for adj in adj_mx],  # Road network adjacency\n    \n    # Modality fusion (KEY FOR EVENT INTEGRATION)\n    "num_modalities": 2,                # Bimodal: traffic + events\n    "num_layers": 5,                    # Stacked layers for feature extraction\n    \n    # Embedding dimensions\n    "node_hidden": 10,                  # Per-node learned embeddings\n    "time_emb_dim": 10,                 # Temporal embeddings\n    "time_in_day_size": 288,            # 24 hours / 5-min resolution = 288\n    "day_in_week_size": 7,              # Weekly periodicity\n}\n\n# Data configuration\nCFG.MODEL.FORWARD_FEATURES = [0, 1, 2]  # [Traffic, EventEmbed, TimeEmbed]\nCFG.MODEL.TARGET_FEATURES = [0]          # Predict only traffic speed\n```\n\n### Training Configuration\n\n```python\nCFG.TRAIN = EasyDict()\nCFG.TRAIN.NUM_EPOCHS = 100\n\n# Optimizer setup\nCFG.TRAIN.OPTIM = EasyDict()\nCFG.TRAIN.OPTIM.TYPE = "Adam"\nCFG.TRAIN.OPTIM.PARAM = {\n    "lr": 0.002,\n    "weight_decay": 1.0e-5,\n    "eps": 1.0e-8\n}\n\n# Learning rate scheduler with milestone decay\nCFG.TRAIN.LR_SCHEDULER = EasyDict()\nCFG.TRAIN.LR_SCHEDULER.TYPE = "MultiStepLR"\nCFG.TRAIN.LR_SCHEDULER.PARAM = {\n    "milestones": [1, 30, 38, 46,