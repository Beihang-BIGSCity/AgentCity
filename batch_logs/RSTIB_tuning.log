          self.results.append(trial_result)\n            print("Status: TIMEOUT")\n            \n        except Exception as e:\n            trial_result = {\n                "trial_id": trial_id,\n                "params": params,\n                "status": "error",\n                "returncode": -1,\n                "elapsed_time": 0,\n                "metrics": {},\n                "error": str(e),\n            }\n            self.results.append(trial_result)\n            print(f"Status: ERROR - {e}")\n        \n        finally:\n            # Restore original config\n            if backup_path.exists():\n                shutil.move(backup_path, self.config_path)\n    \n    def execute_tuning(self, max_trials=None):\n        """Execute full grid search"""\n        search_space = self.create_search_space()\n        \n        # Generate all combinations\n        param_names = list(search_space.keys())\n        param_values = [search_space[k] for k in param_names]\n        \n        combinations = list(itertools.product(*param_values))\n        if max_trials:\n            combinations = combinations[:max_trials]\n        \n        print("\\n" + "="*70)\n        print("RSTIB HYPERPARAMETER TUNING")\n        print("="*70)\n        print(f"Total trials to execute: {len(combinations)}")\n        print(f"Search space: {search_space}")\n        print(f"Fixed parameters: {self.get_fixed_params()}")\n        print("="*70)\n        \n        for trial_id, combo in enumerate(combinations, 1):\n            params = dict(zip(param_names, combo))\n            try:\n                self.run_trial(trial_id, params)\n            except KeyboardInterrupt:\n                print("\\nTuning interrupted by user")\n                break\n            except Exception as e:\n                print(f"Error in trial {trial_id}: {e}")\n                continue\n        \n        return self.results\n    \n    def save_results(self, output_file):\n        """Save results to file"""\n        re