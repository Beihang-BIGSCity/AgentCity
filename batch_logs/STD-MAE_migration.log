    paths.ensure()
    logger = setup_logger(paths.log_file)

    orchestrator = AgentOrchestrator(paths=paths, logger=logger)

    paper = json.loads('{"title": "STD-MAE: Spatial-Temporal Dual Masked Autoencoder for Traffic Forecasting", "model_name": "STD-MAE", "repo_url": "https://github.com/Jimmy-7664/STD-MAE", "datasets": ["METR_LA"], "conference": "IJCAI", "year": 2024, "pdf_path": "/home/wangwenrui/private/shk/agentCity/data/articles/pdfs/stdmae.pdf"}')
    await orchestrator.run_migration([paper])

asyncio.run(run())

