  self.embed_dim = config.get(\'embed_dim\', 96)\n        self.num_heads = config.get(\'num_heads\', 4)\n        self.mlp_ratio = config.get(\'mlp_ratio\', 4)\n        self.dropout = config.get(\'dropout\', 0.1)\n        self.mask_ratio = config.get(\'mask_ratio\', 0.25)  # 0.25 for downstream forecasting\n        self.encoder_depth = config.get(\'encoder_depth\', 4)\n        self.decoder_depth = config.get(\'decoder_depth\', 1)\n\n        # Pre-trained checkpoint paths\n        self.pre_trained_tmae_path = config.get(\'pre_trained_tmae_path\', None)\n        self.pre_trained_smae_path = config.get(\'pre_trained_smae_path\', None)\n\n        # GraphWaveNet backend parameters\n        self.blocks = config.get(\'blocks\', 4)\n        self.layers = config.get(\'layers\', 2)\n        self.gcn_bool = config.get(\'gcn_bool\', True)\n        self.addaptadj = config.get(\'addaptadj\', True)\n        self.kernel_size = config.get(\'kernel_size\', 2)\n        self.residual_channels = config.get(\'residual_channels\', 32)\n        self.dilation_channels = config.get(\'dilation_channels\', 32)\n        self.skip_channels = config.get(\'skip_channels\', 256)\n        self.end_channels = config.get(\'end_channels\', 512)\n\n        # Initialize T-MAE (Temporal MAE)\n        # Mode=\'forecasting\' means it only does encoding (no reconstruction)\n        self.tmae = Mask(\n            patch_size=self.patch_size,\n            in_channel=1,\n            embed_dim=self.embed_dim,\n            num_heads=self.num_heads,\n            mlp_ratio=self.mlp_ratio,\n            dropout=self.dropout,\n            mask_ratio=self.mask_ratio,\n            encoder_depth=self.encoder_depth,\n            decoder_depth=self.decoder_depth,\n            spatial=False,  # Temporal masking\n            mode=\'forecasting\'\n        )\n\n        # Initialize S-MAE (Spatial MAE)\n        self.smae = Mask(\n            patch_size=self.patch_size,\n            in_channel=1,\n            embed_dim=self.embed_dim,\n            num_heads=self.num_heads,\n            mlp_ratio=self.mlp_ratio,\n            dropout=self.dropout,\n            mask_ratio=self.mask_ratio,\n            encoder_depth=self.encoder_depth,\n            decoder_depth=self.decoder_depth,\n            spatial=True,  # Spatial masking\n            mode=\'forecasting\'\n        )\n\n        # Load pre-trained models if paths are provided\n        self._load_pre_trained_models()\n\n        # Freeze MAE parameters (they are pre-trained and fixed)\n        self._freeze_mae_parameters()\n\n        # Initialize GraphWaveNet backend\n        # Input dimension is 2 * embed_dim (concatenation of T-MAE and S-MAE outputs)\n        adj_mx = data_feature.get(\'adj_mx\', None)\n        supports = None\n        if adj_mx is not None:\n            # Convert adjacency matrix to tensor on device\n            if isinstance(adj_mx, list):\n                supports = [torch.tensor(a).float().to(self.device) for a in adj_mx]\n            else:\n                supports = [torch.tensor(adj_mx).float().to(self.device)]\n\n        self.backend = GraphWaveNet(\n            num_nodes=self.num_nodes,\n            supports=supports,\n            dropout=self.dropout,\n            gcn_bool=self.gcn_bool,\n            addaptadj=self.addaptadj,\n            aptinit=adj_mx[0] if isinstance(adj_mx, list) else adj_mx,\n            in_dim=2,  # Input dimension (history + hidden states)\n            out_dim=self.output_window,\n            residual_channels=self.residual_channels,\n            dilation_channels=self.dilation_channels,\n            skip_channels=self.skip_channels,\n            end_channels=self.end_channels,\n            kernel_size=self.kernel_size,\n            blocks=self.blocks,\n            layers=self.layers\n        )\n\n        self._logger.info(f"STDMAE initialized with {sum(p.numel() for p in self.parameters())} parameters")\n\n    def _load_pre_trained_models(self):\n        """Load pre-trained T-MAE and S-MAE models."""\n        if self.pre_trained_tmae_path:\n            try:\n                checkpoint = torch.load(self.pre_trained_tmae_path, map_location=self.device)\n                if isinstance(checkpoint, dict) and \'model_state_dict\' in checkpoint:\n                    self.tmae.load_state_dict(checkpoint[\'model_state_dict\'])\n                else:\n                    self.tmae.load_state_dict(checkpoint)\n                self._logger.info(f"Loaded pre-trained T-MAE from {self.pre_trained_tmae_path}")\n            except Exception as e:\n                self._logger.warning(f"Failed to load pre-trained T-MAE: {e}. Using random initialization.")\n        else:\n            self._logger.warning("No pre-trained T-MAE path provided. Using random initialization.")\n\n        if self.pre_trained_smae_path:\n            try:\n                checkpoint = torch.load(self.pre_trained_smae_path, map_location=self.device)\n                if isinstance(checkpoint, dict) and \'model_state_dict\' in checkpoint:\n                    self.smae.load_state_dict(checkpoint[\'model_state_dict\'])\n                else:\n                    self.smae.load_state_dict(checkpoint)\n                self._logger.info(f"Loaded pre-trained S-MAE from {self.pre_trained_smae_path}")\n            except Exception as e:\n                self._logger.warning(f"Failed to load pre-trained S-MAE: {e}. Using random initialization.")\n        else:\n            self._logger.warning("No pre-trained S-MAE path provided. Using random initialization.")\n\n    def _freeze_mae_parameters(self):\n        """Freeze pre-trained MAE parameters."""\n        for param in self.tmae.parameters():\n            param.requires_grad = False\n        for param in self.smae.parameters():\n            param.requires_grad = False\n\n    def forward(self, batch):\n        """\n        Forward pass of STD-MAE.\n\n        Args:\n            batch (dict): A batch of input data with keys:\n                - \'X\': Input history [B, T, N, C]\n                - \'y\': Target output [B, T_out, N, C]\n\n        Returns:\n            torch.Tensor: Prediction with shape [B, T_out, N, 1]\n        """\n        x = batch[\'X\']  # [B, T, N, C]\n\n        # Reshape for MAE input: [B, T, N, C] -> [B, N, C, T]\n        # MAE expects [B, N, C, L*P] where L is sequence length and P is number of patches\n        x_mae = x.permute(0, 2, 3, 1)  # [B, N, C, T]\n\n        # Extract speed features (assuming first channel is speed)\n        x_mae_speed = x_mae[..., [0]]  # [B, N, 1, T]\n\n        # Encode through T-MAE and S-MAE\n        # Both return hidden states with shape [B, N, P, d] where P is number of patches\n        hidden_states_t, _, _ = self.tmae.encoding(x_mae_speed, mask=False)  # [B, N, P, 96]\n        hidden_states_s, _, _ = self.smae.encoding(x_mae_speed, mask=False)  # [B, N, P, 96]\n\n        # Concatenate T-MAE and S-MAE features: [B, N, P, 96] + [B, N, P, 96] -> [B, N, P, 192]\n        hidden_states_combined = torch.cat([hidden_states_t, hidden_states_s], dim=-1)\n\n        # Take the last patch (most recent temporal information)\n        hidden_states_last = hidden_states_combined[:, :, -1, :]  # [B, N, 192]\n\n        # Prepare input for GraphWaveNet: [B, T, N, C] concatenated with hidden states\n        # GraphWaveNet expects short-term history and hidden states\n        short_term_history = x[:, -self.input_window:, :, :]  # [B, T, N, C]\n\n        # Pass through GraphWaveNet backend\n        # hidden_states_last shape [B, N, 192] needs to be reshaped for the backend\n        predictions = self.backend(short_term_history, hidden_states=hidden_states_last)  # [B, T_out, N]\n\n        # Reshape to [B, T_out, N, 1]\n        predictions = predictions.unsqueeze(-1)\n\n        return predictions\n\n    def predict(self, batch):\n        """\n        Predict method for inference.\n\n        Args:\n            batch (dict): A batch of input data\n\n        Returns:\n            torch.Tensor: Model predictions\n        """\n        return self.forward(batch)\n\n    def calculate_loss(self, batch):\n        """\n        Calculate training loss using masked MAE.\n\n        Args:\n            batch (dict): A batch of input data with keys \'X\' and \'y\'\n\n        Returns:\n            torch.Tensor: Training loss\n        """\n        y_pred = self.predict(batch)\n        y_true = batch[\'y\']\n\n        # Use masked MAE loss from LibCity\n        # This handles NaN values and zero values properly\n        mae_loss = loss.masked_mae_torch(y_pred, y_true)\n\n        return mae_loss\n'}
[ERR] 2026-01-24 11:51:56 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/private/shk/agentCity/Bigscity-LibCity/libcity/model/traffic_speed_prediction/STDMAE_Components.py', 'content': '"""\nSTD-MAE supporting components: Mask (encoder), GraphWaveNet, and related utilities.\n\nThese components are adapted from the original STD-MAE paper implementation\nand are required for the LibCity STDMAE model.\n"""\n\nimport math\nimport random\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom timm.models.vision_transformer import trunc_normal_\nfrom positional_encodings.torch_encodings import PositionalEncoding2D\n\n\n# ============================================================================\n# Patch Embedding\n# ============================================================================\n\nclass PatchEmbedding(nn.Module):\n    """Patchify time series data."""\n\n    def __init__(self, patch_size, in_channel, embed_dim, norm_layer=None):\n        super().__init__()\n        self.output_channel = embed_dim\n        self.len_patch = patch_size\n        self.input_channel = in_channel\n        self.input_embedding = nn.Conv2d(\n            in_channel,\n            embed_dim,\n            kernel_size=(self.len_patch, 1),\n            stride=(self.len_patch, 1)\n        )\n        self.norm_layer = norm_layer if norm_layer is not None else nn.Identity()\n\n    def forward(self, long_term_history):\n        """\n        Args:\n            long_term_history: [B, N, C, L] where L = P * patch_size\n\n        Returns:\n            output: [B, N, d, P] where P is number of patches\n        """\n        batch_size, num_nodes, num_feat, len_time_series = long_term_history.shape\n        long_term_history = long_term_history.unsqueeze(-1)  # [B, N, C, L, 1]\n# Reshape for conv: [B*N, C, L, 1]\n        long_term_history = long_term_history.reshape(\n            batch_size * num_nodes, num_feat, len_time_series, 1\n        )\n        # Apply embedding: [B*N, d, L/P, 1]\n        output = self.input_embedding(long_term_history)\n        output = self.norm_layer(output)\n        # Reshape back: [B, N, d, P]\n        output = output.squeeze(-1).view(batch_size, num_nodes, self.output_channel, -1)\n        return output\n\n\n# ============================================================================\n# Positional Encoding\n# ============================================================================\n\nclass PositionalEncoding(nn.Module):\n    """Positional encoding for patches."""\n\n    def __init__(self):\n        super().__init__()\n\n    def forward(self, input_data, index=None, abs_idx=None):\n        """\n        Args:\n            input_data: [B, N, P, d]\n\n        Returns:\n            output_data: [B, N, P, d] with positional encoding added\n            pos_mat: positional encoding matrix\n        """\n        batch_size, num_nodes, num_patches, num_feat = input_data.shape\n        tp_enc_2d = PositionalEncoding2D(num_feat).to(input_data.device)\n        pos_encoding = tp_enc_2d(input_data)\n        input_data = input_data + pos_encoding\n        return input_data, pos_encoding\n\n\n# ============================================================================\n# Mask Generator\n# ============================================================================\n\nclass MaskGenerator(nn.Module):\n    """Generate random masks for masked autoencoding."""\n\n    def __init__(self, num_tokens, mask_ratio):\n        super().__init__()\n        self.num_tokens = num_tokens\n        self.mask_ratio = mask_ratio\n        self.sort = True\n\n    def uniform_rand(self):\n        """Generate uniform random mask."""\n        mask = list(range(int(self.num_tokens)))\n        random.shuffle(mask)\nmask_len = int(self.num_tokens * self.mask_ratio)\n        self.masked_tokens = mask[:mask_len]\n        self.unmasked_tokens = mask[mask_len:]\n        if self.sort:\n            self.masked_tokens = sorted(self.masked_tokens)\n            self.unmasked_tokens = sorted(self.unmasked_tokens)\n        return self.unmasked_tokens, self.masked_tokens\n\n    def forward(self):\n        self.unmasked_tokens, self.masked_tokens = self.uniform_rand()\n        return self.unmasked_tokens, self.masked_tokens\n\n\n# ============================================================================\n# Transformer Layers\n# ============================================================================\n\nclass TransformerLayers(nn.Module):\n    """Stack of transformer encoder layers."""\n\n    def __init__(self, hidden_dim, nlayers, mlp_ratio, num_heads=4, dropout=0.1):\n        super().__init__()\n        self.d_model = hidden_dim\n        encoder_layer = nn.TransformerEncoderLayer(\n            hidden_dim, num_heads, int(hidden_dim * mlp_ratio), dropout\n        )\n        self.transformer_encoder = nn.TransformerEncoder(encoder_layer, nlayers)\n\n    def forward(self, src):\n        """\n        Args:\n            src: [B, N, L, D]\n\n        Returns:\n            output: [B, N, L, D]\n        """\n        B, N, L, D = src.shape\n        src = src * math.sqrt(self.d_model)\n        src = src.contiguous()\n        src = src.view(B * N, L, D)\n        src = src.transpose(0, 1)  # [L, B*N, D]\n        output = self.transformer_encoder(src, mask=None)\n        output = output.transpose(0, 1).view(B, N, L, D)  # [B, N, L, D]\n        return output\n\n\n# ============================================================================\n# Mask Autoencoder\n# ============================================================================\n\nclass Mask(nn.Module):\n    """\n    Masked Autoencoder for temporal or spatial patterns.\n\n    Can operate in two modes:\n    - \'pre-train\': Full reconstruction with mask-token filling (for pre-training)\n    - \'forecasting\': Encoder-only, returns encoded representations (for downstream forecasting)\n    """\n\n    def __init__(\n        self,\n        patch_size,\n        in_channel,\n        embed_dim,\n        num_heads,\n        mlp_ratio,\n        dropout,\n        mask_ratio,\n        encoder_depth,\n        decoder_depth,\n        spatial=False,\n        mode=\'forecasting\'\n    ):\n        super().__init__()\n        assert mode in [\'pre-train\', \'forecasting\'], \'Error mode.\'\n        self.patch_size = patch_size\n        self.in_channel = in_channel\n        self.embed_dim = embed_dim\n        self.num_heads = num_heads\n        self.mask_ratio = mask_ratio\n        self.encoder_depth = encoder_depth\n        self.mode = mode\n        self.mlp_ratio = mlp_ratio\n        self.spatial = spatial\n        self.selected_feature = 0\n\n        # Norm layers\n        self.encoder_norm = nn.LayerNorm(embed_dim)\n        self.decoder_norm = nn.LayerNorm(embed_dim)\n        self.pos_mat = None\n\n        # Patch embedding and positional encoding\n        self.patch_embedding = PatchEmbedding(patch_size, in_channel, embed_dim, norm_layer=None)\n        self.positional_encoding = PositionalEncoding()\n\n        # Encoder\n        self.encoder = TransformerLayers(embed_dim, encoder_depth, mlp_ratio, num_heads, dropout)\n\n        # Decoder components\n        self.enc_2_dec_emb = nn.Linear(embed_dim, embed_dim, bias=True)\n        self.mask_token = nn.Parameter(torch.zeros(1, 1, 1, embed_dim))\n        self.decoder = TransformerLayers(embed_dim, decoder_depth, mlp_ratio, num_heads, dropout)\n        self.output_layer = nn.Linear(embed_dim, patch_size)\n\n        self.initialize_weights()\n\n    def initialize_weights(self):\n        trunc_normal_(self.mask_token, std=.02)\n\n    def encoding(self, long_term_history, mask=True):\n        """\n        Encode input data.\n\n        Args:\nlong_term_history: [B, N, C, L]\n            mask: whether to apply masking (True for pre-training, False for forecasting)\n\n        Returns:\n            hidden_states_unmasked: encoded representations\n            unmasked_token_index: indices of unmasked tokens\n            masked_token_index: indices of masked tokens\n        """\n        # Patchify and embed\n        if mask:\n            if self.spatial:\n                # Spatial masking: mask nodes\n                patches = self.patch_embedding(long_term_history)  # [B, N, d, P]\n                patches = patches.transpose(-1, -2)  # [B, N, P, d]\n                batch_size, num_nodes, num_time, num_dim = patches.shape\n                patches, self.pos_mat = self.positional_encoding(patches)\n\n                # Generate spatial mask\n                maskg = MaskGenerator(patches.shape[1], self.mask_ratio)\n                unmasked_token_index, masked_token_index = maskg.uniform_rand()\n                encoder_input = patches[:, unmasked_token_index, :, :]\n                encoder_input = encoder_input.transpose(-2, -3)  # [B, P, num_unmasked, d]\n\n                hidden_states_unmasked = self.encoder(encoder_input)\n                hidden_states_unmasked = self.encoder_norm(hidden_states_unmasked).view(\n                    batch_size, num_time, -1, self.embed_dim\n                )\n            else:\n                # Temporal masking: mask patches\n                patches = self.patch_embedding(long_term_history)  # [B, N, d, P]\n                patches = patches.transpose(-1, -2)  # [B, N, P, d]\n                batch_size, num_nodes, num_time, num_dim = patches.shape\n\n                patches, self.pos_mat = self.positional_encoding(patches)\n\n                # Generate temporal mask\n                maskg = MaskGenerator(patches.shape[2], self.mask_ratio)\n                unmasked_token_index, masked_token_index = maskg.uniform_rand()\n                encoder_input = patches[:, :, unmasked_token_index, :]\n\n                hidden_states_unmasked = self.encoder(encoder_input)\n                hidden_states_unmasked = self.encoder_norm(hidden_states_unmasked).view(\n                    batch_size, num_nodes, -1, self.embed_dim\n                )\n        else:\n            # No masking: process all tokens (for forecasting)\n            batch_size, num_nodes, _, _ = long_term_history.shape\n            patches = self.patch_embedding(long_term_history)  # [B, N, d, P]\n            patches = patches.transpose(-1, -2)  # [B, N, P, d]\n\n            patches, self.pos_mat = self.positional_encoding(patches)\n\n            unmasked_token_index, masked_token_index = None, None\n            encoder_input = patches\n\n            if self.spatial:\n                encoder_input = encoder_input.transpose(-2, -3)  # [B, P, N, d]\n\n            hidden_states_unmasked = self.encoder(encoder_input)\n\n            if self.spatial:\n                hidden_states_unmasked = hidden_states_unmasked.transpose(-2, -3)  # [B, N, P, d]\n\n            hidden_states_unmasked = self.encoder_norm(hidden_states_unmasked).view(\n                batch_size, num_nodes, -1, self.embed_dim\n            )\n\n        return hidden_states_unmasked, unmasked_token_index, masked_token_index\n\n    def decoding(self, hidden_states_unmasked, masked_token_index):\n        """Decode encoded representations."""\n        hidden_states_unmasked = self.enc_2_dec_emb(hidden_states_unmasked)\n\n        if self.spatial:\n            batch_size, num_time, num_nodes, _ = hidden_states_unmasked.shape\n            unmasked_token_index = [\n                i for i in range(0, len(masked_token_index) + num_nodes)\n                if i not in masked_token_index\n            ]\n            hidden_states_masked = self.pos_mat[:, masked_token_index, :, :]\n            hidden_states_masked = hidden_states_masked.transpose(-2, -3)\n\n            hidden_states_masked += self.mask_token.expand(\nbatch_size, num_time, len(masked_token_index), hidden_states_unmasked.shape[-1]\n            )\n            hidden_states_unmasked += self.pos_mat[:, unmasked_token_index, :, :].transpose(-2, -3)\n\n            hidden_states_full = torch.cat([hidden_states_unmasked, hidden_states_masked], dim=-2)\n\n            hidden_states_full = self.decoder(hidden_states_full)\n            hidden_states_full = self.decoder_norm(hidden_states_full)\n\n            reconstruction_full = self.output_layer(hidden_states_full.view(\n                batch_size, num_time, -1, self.embed_dim\n            ))\n        else:\n            batch_size, num_nodes, num_time, _ = hidden_states_unmasked.shape\n            unmasked_token_index = [\n                i for i in range(0, len(masked_token_index) + num_time)\n                if i not in masked_token_index\n            ]\n            hidden_states_masked = self.pos_mat[:, :, masked_token_index, :]\n            hidden_states_masked += self.mask_token.expand(\n                batch_size, num_nodes, len(masked_token_index), hidden_states_unmasked.shape[-1]\n            )\n            hidden_states_unmasked += self.pos_mat[:, :, unmasked_token_index, :]\n            hidden_states_full = torch.cat([hidden_states_unmasked, hidden_states_masked], dim=-2)\n\n            hidden_states_full = self.decoder(hidden_states_full)\n            hidden_states_full = self.decoder_norm(hidden_states_full)\n\n            reconstruction_full = self.output_layer(hidden_states_full.view(\n                batch_size, num_nodes, -1, self.embed_dim\n            ))\n\n        return reconstruction_full\n\n    def forward(self, history_data: torch.Tensor, future_data: torch.Tensor = None, **kwargs):\n        """\n        Forward pass.\n\n        Args:\n            history_data: [B, T, N, C] -> permuted to [B, N, C, L]\n            future_data: optional target data\n\n        Returns:\n            In \'forecasting\' mode: encoded representations [B, N, P, d]\nIn \'pre-train\' mode: reconstruction and labels for loss computation\n        """\n        # Reshape: [B, T, N, C] -> [B, N, C, T]\n        history_data = history_data.permute(0, 2, 3, 1)\n\n        if self.mode == \'pre-train\':\n            hidden_states_unmasked, unmasked_token_index, masked_token_index = self.encoding(\n                history_data\n            )\n            reconstruction_full = self.decoding(hidden_states_unmasked, masked_token_index)\n            reconstruction_masked_tokens, label_masked_tokens = self.get_reconstructed_masked_tokens(\n                reconstruction_full, history_data, unmasked_token_index, masked_token_index\n            )\n            return reconstruction_masked_tokens, label_masked_tokens\n        else:\n            # Forecasting mode: just encode without masking\n            hidden_states_full, _, _ = self.encoding(history_data, mask=False)\n            return hidden_states_full, None, None\n\n    def get_reconstructed_masked_tokens(self, reconstruction_full, real_value_full,\n                                       unmasked_token_index, masked_token_index):\n        """Extract reconstructed masked tokens for loss computation."""\n        if self.spatial:\n            batch_size, num_time, num_nodes, _ = reconstruction_full.shape\n            reconstruction_masked_tokens = reconstruction_full[:, :, len(unmasked_token_index):, :]\n            reconstruction_masked_tokens = reconstruction_masked_tokens.view(batch_size, num_time, -1)\n\n            label_full = real_value_full.permute(0, 3, 1, 2).unfold(\n                1, self.patch_size, self.patch_size\n            )[:, :, :, self.selected_feature, :].transpose(1, 2)\n            label_masked_tokens = label_full[:, masked_token_index, :, :].transpose(1, 2).contiguous()\n            label_masked_tokens = label_masked_tokens.view(batch_size, num_time, -1)\n\n            return reconstruction_masked_tokens, label_masked_tokens\n        else:\n            batch_size, num_nodes, num_time, _ = reconstruction_full.shape\n            reconstruction_masked_tokens = reconstruction_full[:, :, len(unmasked_token_index):, :]\n            reconstruction_masked_tokens = reconstruction_masked_tokens.view(\n                batch_size, num_nodes, -1\n            ).transpose(1, 2)\n\n            label_full = real_value_full.permute(0, 3, 1, 2).unfold(\n                1, self.patch_size, self.patch_size\n            )[:, :, :, self.selected_feature, :].transpose(1, 2)\n            label_masked_tokens = label_full[:, :, masked_token_index, :].contiguous()\n            label_masked_tokens = label_masked_tokens.view(\n                batch_size, num_nodes, -1\n            ).transpose(1, 2)\n\n            return reconstruction_masked_tokens, label_masked_tokens\n\n\n# ============================================================================\n# Graph Convolution Layers\n# ============================================================================\n\nclass Nconv(nn.Module):\n    """Node convolution."""\n\n    def __init__(self):\n        super(Nconv, self).__init__()\n\n    def forward(self, x, A):\n        A = A.to(x.device)\n        if len(A.shape) == 3:\n            x = torch.einsum(\'ncvl,nvw->ncwl\', (x, A))\n        else:\n            x = torch.einsum(\'ncvl,vw->ncwl\', (x, A))\n        return x.contiguous()\n\n\nclass Linear(nn.Module):\n    """Linear transformation using 1x1 convolution."""\n\n    def __init__(self, c_in, c_out):\n        super(Linear, self).__init__()\n        self.mlp = torch.nn.Conv2d(c_in, c_out, kernel_size=(1, 1), padding=(0, 0),\n                                   stride=(1, 1), bias=True)\n\n    def forward(self, x):\n        return self.mlp(x)\n\n\nclass GCN(nn.Module):\n    """Graph Convolutional Network layer."""\n\n    def __init__(self, c_in, c_out, dropout, support_len=3, order=2):\n        super(GCN, self).__init__()\n        self.nconv = Nconv()\n        c_in = (order * support_len + 1) * c_in\n        self.mlp = Linear(c_in, c_out)\n        self.dropout = dropout\n        self.order = order\n\n    def forward(self, x, support):\n        out = [x]\n        for a in support:\n            x1 = self.nconv(x, a)\n            out.append(x1)\n            for k in range(2, self.order + 1):\n                x2 = self.nconv(x1, a)\n                out.append(x2)\n                x1 = x2\n\n        h = torch.cat(out, dim=1)\n        h = self.mlp(h)\n        h = F.dropout(h, self.dropout, training=self.training)\n        return h\n\n\n# ============================================================================\n# GraphWaveNet Backend\n# ============================================================================\n\nclass GraphWaveNet(nn.Module):\n    """\n    Graph WaveNet backend for spatial-temporal modeling.\n\n    Reference: Graph WaveNet for Deep Spatial-Temporal Graph Modeling\n    https://arxiv.org/abs/1906.00121\n    """\n\n    def __init__(\n        self,\n        num_nodes,\n        supports,\n        dropout=0.3,\n        gcn_bool=True,\n        addaptadj=True,\n        aptinit=None,\n        in_dim=2,\n        out_dim=12,\n        residual_channels=32,\n        dilation_channels=32,\n        skip_channels=256,\n        end_channels=512,\n        kernel_size=2,\n        blocks=4,\n        layers=2,\n        **kwargs\n    ):\n        super(GraphWaveNet, self).__init__()\n        self.dropout = dropout\n        self.blocks = blocks\n        self.layers = layers\n        self.gcn_bool = gcn_bool\n        self.addaptadj = addaptadj\n\n        self.filter_convs = nn.ModuleList()\n        self.gate_convs = nn.ModuleList()\n        self.residual_convs = nn.ModuleList()\n        self.skip_convs = nn.ModuleList()\n        self.bn = nn.ModuleList()\n        self.gconv = nn.ModuleList()\n\n        self.in_dim = in_dim\n        # FC layers for processing T-MAE and S-MAE features\n        self.fc_his_t = nn.Sequential(\n            nn.Linear(96, 512), nn.ReLU(), nn.Linear(512, 256), nn.ReLU()\n        )\n        self.fc_his_s = nn.Sequential(\n            nn.Linear(96, 512), nn.ReLU(), nn.Linear(512, 256), nn.ReLU()\n        )\n\n        self.start_conv = nn.Conv2d(\n            in_channels=in_dim,\n            out_channels=residual_channels,\n            kernel_size=(1, 1)\n        )\n        self.supports = supports\n\n        receptive_field = 1\n\n        self.supports_len = 0\n        if supports is not None:\n            self.supports_len += len(supports)\n\n        if gcn_bool and addaptadj:\n            if aptinit is None:\n                if supports is None:\n                    self.supports = []\n                self.nodevec1 = nn.Parameter(torch.randn(num_nodes, 10), requires_grad=True)\n                self.nodevec2 = nn.Parameter(torch.randn(10, num_nodes), requires_grad=True)\n                self.supports_len += 1\n            else:\n                if supports is None:\n                    self.supports = []\n                m, p, n = torch.svd(torch.tensor(aptinit, dtype=torch.float32))\n                initemb1 = torch.mm(m[:, :10], torch.diag(p[:10] ** 0.5))\n                initemb2 = torch.mm(torch.diag(p[:10] ** 0.5), n[:, :10].t())\n                self.nodevec1 = nn.Parameter(initemb1, requires_grad=True)\n                self.nodevec2 = nn.Parameter(initemb2, requires_grad=True)\n                self.supports_len += 1\n\n        for b in range(blocks):\n            additional_scope = kernel_size - 1\n            new_dilation = 1\n            for i in range(layers):\n                self.filter_convs.append(\n                    nn.Conv2d(\n                        in_channels=residual_channels,\n                        out_channels=dilation_channels,\n                        kernel_size=(1, kernel_size),\n                        dilation=new_dilation\n                    )\n                )\n                self.gate_convs.append(\n                    nn.Conv2d(\n                        in_channels=residual_channels,\n                        out_channels=dilation_channels,\n                        kernel_size=(1, kernel_size),\n                        dilation=new_dilation\n                    )\n                )\n                self.residual_convs.append(\n                    nn.Conv2d(\n                        in_channels=dilation_channels,\n                        out_channels=residual_channels,\n                        kernel_size=(1, 1)\n                    )\n                )\n                self.skip_convs.append(\n                    nn.Conv2d(\n                        in_channels=dilation_channels,\n                        out_channels=skip_channels,\n                        kernel_size=(1, 1)\n                    )\n                )\n                self.bn.append(nn.BatchNorm2d(residual_channels))\n                new_dilation *= 2\n                receptive_field += additional_scope\n                additional_scope *= 2\n                if self.gcn_bool:\n                    self.gconv.append(\n                        GCN(dilation_channels, residual_channels, dropout, support_len=self.supports_len)\n                    )\n\n        self.end_conv_1 = nn.Conv2d(in_channels=skip_channels, out_channels=end_channels,\n                                    kernel_size=(1, 1), bias=True)\n        self.end_conv_2 = nn.Conv2d(in_channels=end_channels, out_channels=out_dim,\n                                    kernel_size=(1, 1), bias=True)\n\n        self.receptive_field = receptive_field\n\n    def forward(self, input, hidden_states):\n        """\n        Forward pass.\n\n        Args:\n            input: [B, L, N, C] input history\n            hidden_states: [B, N, 192] concatenated T-MAE and S-MAE features\n\n        Returns:\n            [B, L, N] predictions\n        """\n        # Reshape input: [B, L, N, C] -> [B, C, N, L]\n        input = input.transpose(1, 3)\n\n        # Padding\n        input = nn.functional.pad(input, (1, 0, 0, 0))\n        input = input[:, :self.in_dim, :, :]\n\n        in_len = input.size(3)\n        if in_len < self.receptive_field:\n            x = nn.functional.pad(input, (self.receptive_field - in_len, 0, 0, 0))\n        else:\n            x = input\n\n        x = self.start_conv(x)\n        skip = 0\n\n        # Calculate adaptive adjacency matrix\n        new_supports = None\n        if self.gcn_bool and self.addaptadj and self.supports is not None:\n            adp = F.softmax(F.relu(torch.mm(self.nodevec1, self.nodevec2)), dim=1)\n            new_supports = self.supports + [adp]\n\n        # WaveNet layers\n        for i in range(self.blocks * self.layers):\n            residual = x\n\n            # Dilated convolution with gating\n            filter = self.filter_convs[i](residual)\n            filter = torch.tanh(filter)\n            gate = self.gate_convs[i](residual)\n            gate = torch.sigmoid(gate)\n            x = filter * gate\n\n            # Skip connection\n            s = x\n            s = self.skip_convs[i](s)\n            try:\n                skip = skip[:, :, :, -s.size(3):]\n            except:\n                skip = 0\n            skip = s + skip\n\n            # Graph convolution\n            if self.gcn_bool and self.supports is not None:\n                if self.addaptadj:\n                    x = self.gconv[i](x, new_supports)\n                else:\n                    x = self.gconv[i](x, self.supports)\n            else:\n                x = self.residual_convs[i](x)\n\n            x = x + residual[:, :, :, -x.size(3):]\n            x = self.bn[i](x)\n\n        # Integrate T-MAE and S-MAE features\n        hidden_states_t = self.fc_his_t(hidden_states[:, :, :96])  # [B, N, 256]\n        hidden_states_t = hidden_states_t.transpose(1, 2).unsqueeze(-1)  # [B, 256, N, 1]\n        skip = skip + hidden_states_t\n\n        hidden_states_s = self.fc_his_s(hidden_states[:, :, 96:])  # [B, N, 256]\n        hidden_states_s = hidden_states_s.transpose(1, 2).unsqueeze(-1)  # [B, 256, N, 1]\n        skip = skip + hidden_states_s\n\n        x = F.relu(skip)\n        x = F.relu(self.end_conv_1(x))\n        x = self.end_conv_2(x)\n\n        # Reshape output: [B, L, N, 1] -> [B, L, N]\n        x = x.squeeze(-1).transpose(1, 2)\n        return x\n'}
