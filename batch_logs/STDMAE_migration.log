kernel_size\': 2,\n            \'residual_channels\': 32,\n            \'dilation_channels\': 32,\n            \'skip_channels\': 256,\n            \'end_channels\': 512,\n        }\n\n        adj_mx = np.ones((num_nodes, num_nodes)) * 0.1\n        np.fill_diagonal(adj_mx, 1.0)\n\n        data_feature = {\n            \'num_nodes\': num_nodes,\n            \'feature_dim\': 1,\n            \'output_dim\': 1,\n            \'adj_mx\': adj_mx,\n            \'scaler\': None,\n        }\n\n        model = STDMAE(config, data_feature)\n        model.eval()\n\n        # Create batch\n        batch = {\n            \'X\': torch.randn(batch_size, input_window, num_nodes, 1),\n            \'y\': torch.randn(batch_size, output_window, num_nodes, 1),\n        }\n\n        # Forward pass\n        with torch.no_grad():\n            output = model(batch)\n\n        expected_shape = (batch_size, output_window, num_nodes, 1)\n        if output.shape == expected_shape:\n            print(f"✓ Forward pass successful")\n            print(f"  - Input shape: {batch[\'X\'].shape}")\n            print(f"  - Output shape: {output.shape}")\n            print(f"  - Expected shape: {expected_shape}")\n            return True\n        else:\n            print(f"✗ Forward pass shape mismatch")\n            print(f"  - Expected: {expected_shape}")\n            print(f"  - Got: {output.shape}")\n            return False\n\n    except Exception as e:\n        print(f"✗ Failed forward pass: {e}")\n        import traceback\n        traceback.print_exc()\n        return False\n\ndef test_loss_calculation():\n    """Test STDMAE loss calculation."""\n    try:\n        from libcity.model.traffic_speed_prediction.STDMAE import STDMAE\n\n        num_nodes = 10\n        batch_size = 4\n        input_window = 12\n        output_window = 12\n\n        config = {\n            \'device\': torch.device(\'cpu\'),\n            \'input_window\': input_window,\n            \'output_window\': output_window,\n            \'patch_size\': 12,\n            \'embed_dim\': 96,\n            \'num_heads\': 4,\n            \'mlp_ratio\': 4,\n            \'dropout\': 0.1,\n            \'mask_ratio\': 0.25,\n            \'encoder_depth\': 2,\n            \'decoder_depth\': 1,\n            \'blocks\': 2,\n            \'layers\': 1,\n            \'gcn_bool\': True,\n            \'addaptadj\': True,\n            \'kernel_size\': 2,\n            \'residual_channels\': 32,\n            \'dilation_channels\': 32,\n            \'skip_channels\': 256,\n            \'end_channels\': 512,\n        }\n\n        adj_mx = np.ones((num_nodes, num_nodes)) * 0.1\n        np.fill_diagonal(adj_mx, 1.0)\n\n        data_feature = {\n            \'num_nodes\': num_nodes,\n            \'feature_dim\': 1,\n            \'output_dim\': 1,\n            \'adj_mx\': adj_mx,\n            \'scaler\': None,\n        }\n\n        model = STDMAE(config, data_feature)\n        model.train()\n\n        # Create batch\n        batch = {\n            \'X\': torch.randn(batch_size, input_window, num_nodes, 1),\n            \'y\': torch.randn(batch_size, output_window, num_nodes, 1),\n        }\n\n        # Calculate loss\n        loss = model.calculate_loss(batch)\n\n        if isinstance(loss, torch.Tensor) and loss.dim() == 0:  # Scalar loss\n            print(f"✓ Loss calculation successful")\n            print(f"  - Loss value: {loss.item():.6f}")\n            return True\n        else:\n            print(f"✗ Loss calculation failed - invalid loss format")\n            print(f"  - Loss type: {type(loss)}")\n            if isinstance(loss, torch.Tensor):\n                print(f"  - Loss shape: {loss.shape}")\n            return False\n\n    except Exception as e:\n        print(f"✗ Failed loss calculation: {e}")\n        import traceback\n        traceback.print_exc()\n        return False\n\ndef main():\n    """Run all tests."""\n    print("=" * 70)\n    print("STDMAE Model Test Suite")\n    print("=" * 70)\n\n    tests =