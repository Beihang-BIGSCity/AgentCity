[ERR] 2026-01-23 02:29:08 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/private/shk/agentCity/Bigscity-LibCity/libcity/model/traffic_speed_prediction/FUSETraffic.py', 'content': '"""\nFUSE-Traffic: Fusion of Unstructured and Structured Data for Event-aware Traffic Forecasting\nPaper: SIGSPATIAL 2025\nRepository: https://github.com/GeoAICenter/FUSE-Traffic_Sigspatial2025\n\nArchitecture:\n- Base encoder: D2STGNN (Dual-resolution Spatial-Temporal Graph Neural Network)\n- Event processing: Text embedding extraction and cross-attention fusion\n- Fusion mechanism: Multi-head cross-attention between traffic and event embeddings\n- Decoder: Feed-forward network for prediction\n\nAdapted for LibCity by integrating D2STGNN with event-aware cross-attention fusion.\n"""\n\nimport math\nimport numpy as np\nfrom logging import getLogger\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nfrom libcity.model import loss\nfrom libcity.model.abstract_traffic_state_model import AbstractTrafficStateModel\nfrom libcity.model.traffic_speed_prediction.D2STGNN import (\n    DecoupleLayer, DynamicGraphConstructor, transition_matrix\n)\n\n\nclass CrossAttentionFusion(nn.Module):\n    """\n    Cross-attention mechanism to fuse traffic spatial-temporal features with event embeddings.\n\n    Query: Traffic features from D2STGNN encoder\n    Key/Value: Event text embeddings\n    """\n\n    def __init__(self, embedding_dim, num_heads=8, dropout=0.1):\n        """\n        Args:\n            embedding_dim (int): Unified embedding dimension for both modalities\n            num_heads (int): Number of attention heads\n            dropout (float): Dropout rate\n        """\n        super().__init__()\n        self.embedding_dim = embedding_dim\n        self.num_heads = num_heads\n        self.head_dim = embedding_dim // num_heads\n\n        assert embedding_dim % num_heads == 0, "embedding_dim must be divisible by num_heads"\n\n        # Multi-head cross-attention\n        self.cross_attention = nn.MultiheadAttention(\n            embed_dim=embedding_dim,\n            num_heads=num_heads,\n            dropout=dropout,\n            batch_first=True  # (batch, seq, feature)\n        )\n\n        # Layer normalization and feed-forward\n        self.norm1 = nn.LayerNorm(embedding_dim)\n        self.norm2 = nn.LayerNorm(embedding_dim)\n\n        # Feed-forward network\n        self.ffn = nn.Sequential(\n            nn.Linear(embedding_dim, embedding_dim * 4),\n            nn.ReLU(),\n            nn.Dropout(dropout),\n            nn.Linear(embedding_dim * 4, embedding_dim),\n            nn.Dropout(dropout)\n        )\n\n        self.dropout = nn.Dropout(dropout)\n\n    def forward(self, traffic_features, event_features):\n        """\n        Args:\n            traffic_features: [batch, time, nodes, embedding_dim] - Query from traffic encoder\n            event_features: [batch, nodes, event_embedding_dim] - Key/Value from event encoder\n\n        Returns:\n            fused_features: [batch, time, nodes, embedding_dim] - Fused representation\n        """\n        batch_size, time_steps, num_nodes, feat_dim = traffic_features.shape\n\n        # Reshape traffic features: [batch * time, nodes, embedding_dim]\n        traffic_reshaped = traffic_features.reshape(batch_size * time_steps, num_nodes, feat_dim)\n\n        # Expand event features to match time dimension: [batch * time, nodes, embedding_dim]\n        event_expanded = event_features.unsqueeze(1).expand(batch_size, time_steps, num_nodes, -1)\n        event_reshaped = event_expanded.reshape(batch_size * time_steps, num_nodes, -1)\n\n        # Cross-attention: Query from traffic, Key/Value from events\n        attn_output, _ = self.cross_attention(\n            query=traffic_reshaped,\n            key=event_reshaped,\n            value=event_reshaped\n        )\n\n        # Residual connection and normalization\n        traffic_reshaped = self.norm1(traffic_reshaped + self.dropout(attn_output))\n\n        # Feed-forward network with residual\n        ffn_output = self.ffn(traffic_reshaped)\n        fused = self.norm2(traffic_reshaped + ffn_output)\n\n        # Reshape back: [batch, time, nodes, embedding_dim]\n        fused = fused.reshape(batch_size, time_steps, num_nodes, feat_dim)\n\n        return fused\n\n\nclass EventEmbeddingProcessor(nn.Module):\n    """\n    Process event embeddings (from text encoder) to match traffic feature dimensions.\n    Supports both pre-computed embeddings and optional online text encoding.\n    """\n\n    def __init__(self, event_embedding_dim, target_dim, num_nodes, dropout=0.1):\n        """\n        Args:\n            event_embedding_dim (int): Input dimension of event embeddings (e.g., 768 from text-embedding-005)\n            target_dim (int): Target dimension to match traffic features\n            num_nodes (int): Number of spatial nodes/sensors\n            dropout (float): Dropout rate\n        """\n        super().__init__()\n        self.event_embedding_dim = event_embedding_dim\n        self.target_dim = target_dim\n        self.num_nodes = num_nodes\n\n        # Linear projection to match traffic feature dimension\n        self.projection = nn.Sequential(\n            nn.Linear(event_embedding_dim, target_dim * 2),\n            nn.ReLU(),\n            nn.Dropout(dropout),\n            nn.Linear(target_dim * 2, target_dim),\n            nn.LayerNorm(target_dim)\n        )\n\n    def forward(self, event_embeddings):\n        """\n        Args:\n            event_embeddings: [batch, num_nodes, event_embedding_dim] or [batch, event_embedding_dim]\n\n        Returns:\n            processed_events: [batch, num_nodes, target_dim]\n        """\n        # Handle case where events are per-timestamp instead of per-node\n        if len(event_embeddings.shape) == 2:\n            # [batch, event_embedding_dim] -> [batch, num_nodes, event_embedding_dim]\n            event_embeddings = event_embeddings.unsqueeze(1).expand(-1, self.num_nodes, -1)\n\n        # Project to target dimension\n        processed = self.projection(event_embeddings)\n\n        return processed\n\n\nclass FUSETraffic(AbstractTrafficStateModel):\n    """\n    FUSE-Traffic: Event-aware traffic forecasting via cross-attention fusion.\n\n    This model extends D2STGNN with event data integration through cross-attention.\n    When event data is unavailable (use_events=False), it degrades gracefully to D2STGNN.\n    """\n\n    def __init__(self, config, data_feature):\n        super().__init__(config, data_feature)\n\n        # Data configuration\n        self._scaler = self.data_feature.get(\'scaler\')\n        self.num_nodes = data_feature.get(\'num_nodes\')\n        self.feature_dim = data_feature.get(\'feature_dim\')\n        self.output_dim = data_feature.get(\'output_dim\')\n        self.num_batches = data_feature.get(\'num_batches\')\n\n        self._logger = getLogger()\n        self.device = config.get(\'device\', torch.device(\'cpu\'))\n\n        # Model configuration\n        self.input_window = config.get(\'input_window\', 12)\n        self.output_window = config.get(\'output_window\', 12)\n        self.add_time_in_day = config.get(\'add_time_in_day\', False)\n        self.add_day_in_week = config.get(\'add_day_in_week\', False)\n\n        # Adjust feature dimension for temporal embeddings\n        if self.add_time_in_day and self.add_day_in_week:\n            self.feature_dim -= 8\n        elif self.add_time_in_day:\n            self.feature_dim -= 1\n        elif self.add_day_in_week:\n            self.feature_dim -= 7\n\n        # D2STGNN configuration\n        self.hidden_dim = config.get(\'num_hidden\', 32)\n        self.node_dim = config.get(\'node_dim\', 10)\n        self.forecast_dim = config.get(\'forecast_dim\', 256)\n        self.output_hidden = config.get(\'output_hidden\', 512)\n        self.k_s = config.get(\'k_s\', 2)\n        self.k_t = config.get(\'k_t\', 3)\n        self.num_layers = config.get(\'num_layers\', 5)\n        self.time_emb_dim = config.get(\'time_emb_dim\', 10)\n        self.gap = config.get(\'gap\', 3)\n\n        self.use_pre = config.get(\'use_pre\', False)\n        self.dy_graph = config.get(\'dy_graph\', True)\n        self.sta_graph = config.get(\'sta_graph\', True)\n\n        # Curriculum learning\n        self.use_curriculum_learning = config.get(\'use_curriculum_learning\', False)\n        self.cl_decay_epochs = config.get(\'cl_decay_epochs\', 3)\n        self.max_epoch = config.get(\'max_epoch\', 100)\n        if self.max_epoch < self.cl_decay_epochs * self.output_window:\n            self._logger.warning(\'Parameter `step_size1` is too big with {} epochs and \'\n                                 \'the model cannot be trained for all time steps.\'.format(self.max_epoch))\n        self.task_level = config.get(\'task_level\', 0)\n\n        # Event processing configuration\n        self.use_events = config.get(\'use_events\', False)  # Set to False to disable event processing\n        self.event_embedding_dim = config.get(\'event_embedding_dim\', 768)  # Default: text-embedding-005\n        self.fusion_embedding_dim = config.get(\'fusion_embedding_dim\', 1024)  # Unified dimension for fusion\n        self.num_fusion_heads = config.get(\'num_fusion_heads\', 8)\n        self.fusion_dropout = config.get(\'fusion_dropout\', 0.1)\n\n        # Start embedding layer\n        self.embedding = nn.Linear(self.feature_dim, self.hidden_dim)\n\n        # Time embedding\n        self.T_i_D_emb = nn.Parameter(torch.empty(288, self.time_emb_dim))\n        self.D_i_W_emb = nn.Parameter(torch.empty(7, self.time_emb_dim))\n\n        # Decoupled Spatial Temporal Layers (D2STGNN backbone)\n        self.layers = nn.ModuleList([DecoupleLayer(self.hidden_dim, fk_dim=self.forecast_dim,\n                                                    config=config, data_feature=data_feature)])\n        for _ in range(self.num_layers - 1):\n            self.layers.append(DecoupleLayer(self.hidden_dim, fk_dim=self.forecast_dim,\n                                             config=config, data_feature=data_feature))\n\n        # Dynamic and static hidden graph constructor\n        if self.dy_graph:\n            self.dynamic_graph_constructor = DynamicGraphConstructor(config=config, data_feature=data_feature)\n\n        # Node embeddings\n        self.node_emb_u = nn.Parameter(torch.empty(self.num_nodes, self.node_dim))\n        self.node_emb_d = nn.Parameter(torch.empty(self.num_nodes, self.node_dim))\n\n        # Event processing modules (only initialized if use_events=True)\n        if self.use_events:\n            self._logger.info("Initializing FUSE-Traffic with event-aware cross-attention fusion")\n\n            # Project traffic features to unified fusion dimension\n            self.traffic_projection = nn.Linear(self.forecast_dim, self.fusion_embedding_dim)\n\n            # Event embedding processor\n            self.event_processor = EventEmbeddingProcessor(\n                event_embedding_dim=self.event_embedding_dim,\n                target_dim=self.fusion_embedding_dim,\n                num_nodes=self.num_nodes,\n                dropout=self.fusion_dropout\n            )\n\n            # Cross-attention fusion module\n            self.fusion_module = CrossAttentionFusion(\n                embedding_dim=self.fusion_embedding_dim,\n                num_heads=self.num_fusion_heads,\n                dropout=self.fusion_dropout\n            )\n\n            # Output layer for fused features\n            self.fused_out_fc_1 = nn.Linear(self.fusion_embedding_dim, self.output_hidden)\n            self.fused_out_fc_2 = nn.Linear(self.output_hidden, self.gap * self.output_dim)\n        else:\n            self._logger.info("Initializing FUSE-Traffic WITHOUT event processing (pure D2STGNN mode)")\n\n        # Standard output layer (used when events are disabled)\n        self.out_fc_1 = nn.Linear(self.forecast_dim, self.output_hidden)\n        self.out_fc_2 = nn.Linear(self.output_hidden, self.gap * self.output_dim)\n\n        self.reset_parameter()\n\n    def reset_parameter(self):\n        nn.init.xavier_uniform_(self.node_emb_u)\n        nn.init.xavier_uniform_(self.node_emb_d)\n        nn.init.xavier_uniform_(self.T_i_D_emb)\n        nn.init.xavier_uniform_(self.D_i_W_emb)\n\n    def _graph_constructor(self, node_embedding_u, node_embedding_d, history_data,\n                          time_in_day_feat, day_in_week_feat):\n        """Construct static and dynamic graphs."""\n        if self.sta_graph:\n            static_graph = [F.softmax(F.relu(torch.mm(node_embedding_u, node_embedding_d.T)), dim=1)]\n        else:\n            static_graph = []\n\n        if self.dy_graph:\n            dynamic_graph = self.dynamic_graph_constructor(\n                history_data, node_embedding_d, node_embedding_u,\n                time_in_day_feat, day_in_week_feat\n            )\n        else:\n            dynamic_graph = []\n\n        return static_graph, dynamic_graph\n\n    def _prepare_inputs(self, history_data):\n        """Prepare node embeddings, time embeddings, and traffic signals."""\n        num_feat = self.feature_dim\n\n        # Node embeddings\n        node_emb_u = self.node_emb_u  # [N, d]\n        node_emb_d = self.node_emb_d  # [N, d]\n\n        # Time slot embedding\n        time_in_day_feat, day_in_week_feat = None, None\n        if self.add_time_in_day and self.add_day_in_week:\n            time_in_day_feat = self.T_i_D_emb[(history_data[:, :, :, num_feat] * 288).type(torch.LongTensor)]\n            day_in_week_feat = self.D_i_W_emb[(history_data[:, :, :, num_feat + 1: num_feat + 8].argmax(dim=3)).type(torch.LongTensor)]\n        elif self.add_time_in_day:\n            time_in_day_feat = self.T_i_D_emb[(history_data[:, :, :, num_feat] * 288).type(torch.LongTensor)]\n        elif self.add_day_in_week:\n            day_in_week_feat = self.D_i_W_emb[(history_data[:, :, :, num_feat: num_feat + 7].argmax(dim=3)).type(torch.LongTensor)]\n\n        # Traffic signals (remove temporal features)\n        history_data = history_data[:, :, :, :num_feat]\n\n        return history_data, node_emb_u, node_emb_d, time_in_day_feat, day_in_week_feat\n\n    def forward(self, batch):\n        """\n        Feed forward of FUSE-Traffic.\n\n        Args:\n            batch (dict): Input batch with keys:\n                - \'X\': history data with shape [B, L, N, C]\n                - \'event_embeddings\' (optional): event embeddings with shape [B, N, event_dim] or [B, event_dim]\n\n        Returns:\n            torch.Tensor: prediction data with shape [B, L_out, N, output_dim]\n        """\n        history_data = batch[\'X\']\n\n        # ==================== Prepare Input Data ==================== #\n        history_data, node_embedding_u, node_embedding_d, time_in_day_feat, day_in_week_feat = \\\n            self._prepare_inputs(history_data)\n\n        # ========================= Construct Graphs ========================== #\n        static_graph, dynamic_graph = self._graph_constructor(\n            node_embedding_u=node_embedding_u,\n            node_embedding_d=node_embedding_d,\n            history_data=history_data,\n            time_in_day_feat=time_in_day_feat,\n            day_in_week_feat=day_in_week_feat\n        )\n\n        # ==================== D2STGNN Encoder ==================== #\n        # Start embedding layer\n        history_data = self.embedding(history_data)\n\n        dif_forecast_hidden_list = []\n        inh_forecast_hidden_list = []\n\n        inh_backcast_seq_res = history_data\n        for _, layer in enumerate(self.layers):\n            inh_backcast_seq_res, dif_forecast_hidden, inh_forecast_hidden = layer(\n                inh_backcast_seq_res, dynamic_graph, static_graph,\n                node_embedding_u, node_embedding_d,\n                time_in_day_feat, day_in_week_feat\n            )\n            dif_forecast_hidden_list.append(dif_forecast_hidden)\n            inh_forecast_hidden_list.append(inh_forecast_hidden)\n\n        # Aggregate forecasts from all layers\n        dif_forecast_hidden = sum(dif_forecast_hidden_list)\n        inh_forecast_hidden = sum(inh_forecast_hidden_list)\n        forecast_hidden = dif_forecast_hidden + inh_forecast_hidden  # [B, T/gap, N, forecast_dim]\n\n        # ==================== Event Fusion (Optional) ==================== #\n        if self.use_events and \'event_embeddings\' in batch and batch[\'event_embeddings\'] is not None:\n            # Process event embeddings\n            event_embeddings = batch[\'event_embeddings\']  # [B, N, event_dim] or [B, event_dim]\n            processed_events = self.event_processor(event_embeddings)  # [B, N, fusion_dim]\n\n            # Project traffic features to fusion dimension\n            traffic_features = self.traffic_projection(forecast_hidden)  # [B, T/gap, N, fusion_dim]\n\n            # Cross-attention fusion\n            fused_features = self.fusion_module(traffic_features, processed_events)  # [B, T/gap, N, fusion_dim]\n\n            # Regression layer for fused features\n            forecast = self.fused_out_fc_2(F.relu(self.fused_out_fc_1(F.relu(fused_features))))\n        else:\n            # Standard D2STGNN output (no event fusion)\n            forecast = self.out_fc_2(F.relu(self.out_fc_1(F.relu(forecast_hidden))))\n\n        # ==================== Reshape Output ==================== #\n        # forecast shape: [B, T/gap, N, gap * output_dim]\n        forecast = forecast.view(forecast.shape[0], forecast.shape[1], forecast.shape[2],\n                                self.gap, self.output_dim)  # [B, T/gap, N, gap, output_dim]\n        forecast = forecast.transpose(1, 2).contiguous().view(\n            forecast.shape[0], forecast.shape[2], -1, self.output_dim\n        )  # [B, N, T, output_dim]\n\n        return forecast.transpose(1, 2)  # [B, T, N, output_dim]\n\n    def calculate_loss(self, batch, batches_seen=None):\n        """\n        Calculate loss with curriculum learning support.\n\n        Args:\n            batch (dict): Input batch\n            batches_seen (int): Number of batches seen (for curriculum learning)\n\n        Returns:\n            torch.Tensor: Loss value\n        """\n        y_true = batch[\'y\']\n        y_predicted = self.predict(batch)\n        y_true = self._scaler.inverse_transform(y_true[..., :self.output_dim])\n        y_predicted = self._scaler.inverse_transform(y_predicted[..., :self.output_dim])\n\n        if self.training:\n            # Curriculum learning: gradually increase prediction horizon\n            if batches_seen is not None and batches_seen % (self.cl_decay_epochs * self.num_batches) == 0 \\\n                    and self.task_level < self.output_window:\n                self.task_level += 1\n                self._logger.info(\'Training: task_level increase from {} to {}\'.format(\n                    self.task_level - 1, self.task_level))\n                self._logger.info(\'Current batches_seen is {}\'.format(batches_seen))\n\n            if self.use_curriculum_learning:\n                return loss.masked_mae_torch(y_predicted[:, :self.task_level, :, :],\n                                             y_true[:, :self.task_level, :, :], 0)\n            else:\n                return loss.masked_mae_torch(y_predicted, y_true, 0)\n        else:\n            return loss.masked_mae_torch(y_predicted, y_true, 0)\n\n    def predict(self, batch):\n        """Generate predictions for a batch."""\n        return self.forward(batch)\n'}
