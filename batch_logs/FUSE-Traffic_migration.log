g non-numeric coordinate line: {line}")\n    \n    except FileNotFoundError:\n        print(f"ERROR: Coordinate file not found at \'{file_path}\'")\n        return None\n    \n    return coordinates\n```\n\n## 2. Model Configuration Files\n\n### METR-LA Configuration Structure\n\n```python\n# Location: /repos/FUSE-Traffic/baselines/D2STGNN/METR-LA.py\n\nimport torch\nfrom easydict import EasyDict\nfrom basicts.metrics import masked_mae, masked_mape, masked_rmse\nfrom basicts.data import TimeSeriesForecastingDataset\nfrom basicts.runners import SimpleTimeSeriesForecastingRunner\nfrom basicts.scaler import ZScoreScaler\nfrom basicts.utils import get_regular_settings, load_adj\nfrom .arch import D2STGNN\n\n# Configuration parameters\nDATA_NAME = \'METR-LA\'\nregular_settings = get_regular_settings(DATA_NAME)\nINPUT_LEN = regular_settings[\'INPUT_LEN\']\nOUTPUT_LEN = regular_settings[\'OUTPUT_LEN\']\nTRAIN_VAL_TEST_RATIO = regular_settings[\'TRAIN_VAL_TEST_RATIO\']\nNORM_EACH_CHANNEL = regular_settings[\'NORM_EACH_CHANNEL\']\nRESCALE = regular_settings[\'RESCALE\']\nNULL_VAL = regular_settings[\'NULL_VAL\']\n\n# Load adjacency matrix for spatial modeling\nMODEL_ARCH = D2STGNN\nadj_mx, _ = load_adj("datasets/" + DATA_NAME + "/adj_mx.pkl", "doubletransition")\n\n# Dual-modal model parameters\nMODEL_PARAM = {\n    "num_feat": 1,                    # Single traffic metric (speed)\n    "num_hidden": 32,                 # Hidden dimension size\n    "dropout": 0.1,                   # Regularization\n    "seq_length": 12,                 # Input sequence length (60 minutes at 5-min granularity)\n    "k_t": 3,                         # Temporal kernel size\n    "k_s": 2,                         # Spatial kernel size\n    "gap": 3,                         # Kernel gap\n    "num_nodes": 207,                 # METR-LA has 207 sensors\n    "adjs": [torch.tensor(adj) for adj in adj_mx],  # Spatial graphs\n    "num_layers": 5,                  # GNN layers\n    "num_modalities": 2,              # Structured (traffic) + Unstructured (events)\n    "node_hidden": 10,                # Node embedding dimension\n    "time_emb_dim": 10,               # Temporal embedding dimension\n    "time_in_day_size": 288,          # 24*60/5 = 288 time slots per day\n    "day_in_week_size": 7             # 7 days per week\n}\n\n# Training configuration\nCFG = EasyDict()\nCFG.DESCRIPTION = \'FUSE-Traffic Event-Aware Configuration\'\nCFG.GPU_NUM = 1\n\n# Dataset configuration\nCFG.DATASET = EasyDict()\nCFG.DATASET.NAME = DATA_NAME\nCFG.DATASET.TYPE = TimeSeriesForecastingDataset\nCFG.DATASET.PARAM = EasyDict({\n    \'dataset_name\': DATA_NAME,\n    \'train_val_test_ratio\': TRAIN_VAL_TEST_RATIO,\n    \'input_len\': INPUT_LEN,\n    \'output_len\': OUTPUT_LEN,\n})\n\n# Scaler configuration (Z-score normalization)\nCFG.SCALER = EasyDict()\nCFG.SCALER.TYPE = ZScoreScaler\nCFG.SCALER.PARAM = EasyDict({\n    \'dataset_name\': DATA_NAME,\n    \'train_ratio\': TRAIN_VAL_TEST_RATIO[0],\n    \'norm_each_channel\': NORM_EACH_CHANNEL,\n    \'rescale\': RESCALE,\n})\n\n# Model configuration\nCFG.MODEL = EasyDict()\nCFG.MODEL.NAME = MODEL_ARCH.__name__\nCFG.MODEL.ARCH = MODEL_ARCH\nCFG.MODEL.PARAM = MODEL_PARAM\nCFG.MODEL.FORWARD_FEATURES = [0, 1, 2]  # Structured features\nCFG.MODEL.TARGET_FEATURES = [0]          # Predict speed only\n\n# Metrics\nCFG.METRICS = EasyDict()\nCFG.METRICS.FUNCS = EasyDict({\n    \'MAE\': masked_mae,\n    \'MAPE\': masked_mape,\n    \'RMSE\': masked_rmse,\n})\nCFG.METRICS.TARGET = \'MAE\'\nCFG.METRICS.NULL_VAL = NULL_VAL\n\n# Training configuration\nCFG.TRAIN = EasyDict()\nCFG.TRAIN.NUM_EPOCHS = 100\nCFG.TRAIN.CKPT_SAVE_DIR = os.path.join(\n    \'checkpoints\', MODEL_ARCH.__name__,\n    \'_\'.join([DATA_NAME, str(CFG.TRAIN.NUM_EPOCHS), str(INPUT_LEN), str(OUTPUT_LEN)])\n)\nCFG.TRAIN.LOSS = masked_mae\n\n# Optimizer\nCFG.TRAIN.OPTIM = EasyDict()\nCFG.TRAIN.OPTIM.TYPE = "Adam"\nCFG.TRAIN.OPTIM.PARAM = {\n    "lr": 0.002,\n    "weight_decay": 1.0e-5,\n    "eps": 1.0e-8\n}\n\n# Learning rate scheduler\nCFG.TRAIN.LR_SCHEDULER = EasyDict()\nCFG.TRAIN.LR_SCHEDULER.TYPE = "MultiStepLR"\nCFG.TRAIN.LR_SCHEDULER.PARAM = {\n    "milestones": [1, 30, 38, 46, 54, 62, 70, 80],\n    "gamma": 0.5  # Decay by 0.5 at each milestone\n}\n\n# Data loader settings\nCFG.TRAIN.DATA = EasyDict()\nCFG.TRAIN.DATA.BATCH_SIZE = 128\nCFG.TRAIN.DATA.SHUFFLE = True\n\n# Gradient clipping\nCFG.TRAIN.CLIP_GRAD_PARAM = {\n    "max_norm": 5.0\n}\n\n# No curriculum learning for METR-LA\nCFG.TRAIN.CL = EasyDict()\nCFG.TRAIN.CL.WARM_EPOCHS = 0\nCFG.TRAIN.CL.CL_EPOCHS = 6\nCFG.TRAIN.CL.PREDICTION_LENGTH = 12\n\n# Validation\nCFG.VAL = EasyDict()\nCFG.VAL.INTERVAL = 1\nCFG.VAL.DATA = EasyDict()\nCFG.VAL.DATA.BATCH_SIZE = 64\n\n# Testing\nCFG.TEST = EasyDict()\nCFG.TEST.INTERVAL = 1\nCFG.TEST.DATA = EasyDict()\nCFG.TEST.DATA.BATCH_SIZE = 64\n\n# Evaluation\nCFG.EVAL = EasyDict()\nCFG.EVAL.HORIZONS = [3, 6, 12]  # Predict 15, 30, 60 minutes ahead\nCFG.EVAL.USE_GPU = True\n```\n\n### PEMS-BAY Configuration (with Curriculum Learning)\n\n```python\n# Location: /repos/FUSE-Traffic/baselines/D2STGNN/PEMS-BAY.py\n\n# Key differences from METR-LA:\nDATA_NAME = \'PEMS-BAY\'\nNUM_EPOCHS = 100\n\nMODEL_PARAM = {\n    # ... similar parameters ...\n    "num_nodes": 325,              # PEMS-BAY has 325 sensors\n    "num_modalities": 2,           # Still dual-modal\n    "node_hidden": 12,             # Slightly larger embedding\n    "time_emb_dim": 12,            # Slightly larger embedding\n    # ... rest similar ...\n}\n\n# Curriculum learning configuration (helps training convergence)\nCFG.TRAIN.CL = EasyDict()\nCFG.TRAIN.CL.WARM_EPOCHS = 30      # 30 epochs of warm-up\nCFG.TRAIN.CL.CL_EPOCHS = 3         # 3 epochs of curriculum learning\nCFG.TRAIN.CL.PREDICTION_LENGTH = 12 # Dynamic increase of prediction window\n\n# Dataset-specific batch sizes\nCFG.TRAIN.DATA.BATCH_SIZE = 64     # Smaller batch due to 325 sensors\nCFG.VAL.DATA.BATCH_SIZE = 128      # Validation uses different batch\nCFG.TEST.DATA.BATCH_SIZE = 128     # Test uses different batch\n```\n\n### PEMS03 Configuration (Largest Dataset)\n\n```python\n# Location: /repos/FUSE-Traffic/baselines/D2STGNN/PEMS03.py\n\nDATA_NAME = \'PEMS03\'\n\nMODEL_PARAM = {\n    # ... similar parameters ...\n    "num_nodes": 358,              # Largest dataset with 358 sensors\n    "node_hidden": 12,\n    "time_emb_dim": 12,\n    # ... rest similar ...\n}\n\n# Also uses curriculum learning like PEMS-BAY\nCFG.TRAIN.CL = EasyDict()\nCFG.TRAIN.CL.WARM_EPOCHS = 30\nCFG.TRAIN.CL.CL_EPOCHS = 3\nCFG.TRAIN.CL.PREDICTION_LENGTH = 12\n```\n\n## 3. Data Format Specifications\n\n### Input Data Structure\n\n```\nTraffic Data (HDF5 format):\n├── Time index: datetime64[m] (minute precision)\n├── Sensors: 207-358 rows (depending on dataset)\n└── Values: Speed/flow/occupancy at 5-minute intervals\n\nSensor Coordinates (CSV):\n├── index: numerical ID\n├── sensor_id: string identifier\n├── latitude: float (degrees)\n└── longitude: float (degrees)\n\nAdjacency Matrix (pickle):\n├── Type: numpy array or scipy sparse matrix\n├── Shape: (num_nodes, num_nodes)\n└── Format: double-transition adjacency\n```\n\n### Output Data Format\n\n```\nEvent Embeddings (NPZ compressed):\n├── Shape: (num_timestamps, 768)\n├── Dtype: float32\n└── Format: Compressed numpy array\n\nModel Predictions:\n├── Shape: (num_samples, output_len, num_nodes, num_features)\n├── Dtype: float32\n└── Format: PyTorch tensor\n```\n\n## 4. Key Classes and Their Roles\n\n### D2STGNN (from basicts)\n- **Purpose**: Dual-resolution Spatial-Temporal Graph Neural Network\n- **Input**: Structured traffic data + Unstructured event embeddings\n- **Architecture**: \n  - Spatial: Dual-graph processing (fine + coarse resolution)\n  - Temporal: Kernel-based convolutions\n  - Fusion: Multi-modal combination layer\n\n### TimeSeriesForecastingDataset (from basicts)\n- **Purpose**: Load and format traffic forecasting data\n- **Functionality**:\n  - Loads HDF5 traffic data\n  - Creates sliding windows (input_len -> output_len)\n  - Handles train/val/test splits\n  - Integrates event embeddings\n\n### SimpleTimeSeriesForecastingRunner (from basicts)\n- **Purpose**: Training loop and evaluation\n- **Functionality**:\n  - Orchestrates training/validation/testing\n  - Handles curriculum learning\n  - Manages checkpointing\n  - Computes metrics\n\n### ZScoreScaler (from basicts)\n- **Purpose**: Normalize traffic data\n- **Method**: Z-score normalization (standardization)\n- **Features**: Channel-wise normalization, optional rescaling\n\n## 5. API Integration Points\n\n### Google Gemini 2.5 Pro\n```python\nclient = genai.Client(vertexai=True, project=PROJECT_ID, location=LOCATION)\nresponse = client.models.generate_content(\n    model="gemini-2.5-pro-preview-03-25",\n    contents=prompt,\n    config=types.GenerateContentConfig(\n        response_mime_type=\'application/json\',\n        response_schema={...}  # Structured output\n    )\n)\n```\n\n### Vertex AI Text Embedding\n```python\nmodel = TextEmbeddingModel.from_pretrained("text-embedding-005")\nembeddings = model.get_embeddings([response.text])\nresponse_embedding_vector = embeddings[0].values  # 768-dimensional vector\n```\n\n## 6. Multi-Modality Integration\n\n### How FUSE-Traffic Combines Modalities\n\n1. **Structured Data Stream**:\n   - Input: Time series traffic data (shape: [batch, seq_len, num_nodes, 1])\n   - Processing: Traffic-specific convolutions and GNNs\n   - Output: Structured feature representations\n\n2. **Unstructured Data Stream**:\n   - Input: Event embeddings (shape: [batch, seq_len, num_nodes, 768])\n   - Processing: Event embedding projections and transformations\n   - Output: Event feature representations\n\n3. **Fusion Layer** (in D2STGNN):\n   - Combine both streams: element-wise operations or attention mechanisms\n   - Learn weighted fusion through trainable parameters\n   - Output: Joint representation for prediction\n\n4. **Temporal Alignment**:\n   - Events: 60-115 min ahead (future-looking)\n   - Traffic: Historical 60 min (12 * 5-min steps)\n   - Alignment: Events aligned to corresponding traffic timepoints\n\n## 7. Training Pipeline Summary\n\n```python\n# 1. Load configuration\nfrom baselines.D2STGNN.METR_LA import CFG\n\n# 2. Initialize components\ndataset = CFG.DATASET.TYPE(**CFG.DATASET.PARAM)\nscaler = CFG.SCALER.TYPE(**CFG.SCALER.PARAM)\nmodel = CFG.MODEL.ARCH(**CFG.MODEL.PARAM)\n\n# 3. Create data loaders\ntrain_loader = DataLoader(dataset, batch_size=CFG.TRAIN.DATA.BATCH_SIZE)\nval_loader = DataLoader(dataset, batch_size=CFG.VAL.DATA.BATCH_SIZE)\n\n# 4. Setup optimizer and scheduler\noptimizer = torch.optim.Adam(model.parameters(), **CFG.TRAIN.OPTIM.PARAM)\nscheduler = torch.optim.lr_scheduler.MultiStepLR(optimizer, **CFG.TRAIN.LR_SCHEDULER.PARAM)\n\n# 5. Training loop (with curriculum learning if configured)\nfor epoch in range(CFG.TRAIN.NUM_EPOCHS):\n    # Warm-up phase\n    if epoch < CFG.TRAIN.CL.WARM_EPOCHS:\n        current_horizon = CFG.TRAIN.CL.PREDICTION_LENGTH\n    # Curriculum learning phase\n    elif epoch < CFG.TRAIN.CL.WARM_EPOCHS + CFG.TRAIN.CL.CL_EPOCHS:\n        # Gradually increase prediction horizon\n        pass\n    else:\n        current_horizon = CFG.TRAIN.CL.PREDICTION_LENGTH\n    \n    # Training\n    train_loss = train_epoch(model, train_loader, optimizer, CFG)\n    \n    # Validation\n    if epoch % CFG.VAL.INTERVAL == 0:\n        val_loss = validate(model, val_loader, CFG)\n    \n    # Scheduler step\n    scheduler.step()\n    \n    # Checkpoint saving\n    if epoch % 10 == 0:\n        torch.save(model.state_dict(), CFG.TRAIN.CKPT_SAVE_DIR)\n\n# 6. Testing\ntest_metrics = evaluate(model, test_loader, CFG)\n```\n\n## 8. Important Configuration Notes\n\n### Multi-Modality Flag\n```python\n"num_modalities": 2  # CRITICAL: Indicates dual-modal architecture\n```\nThis parameter enables the model to:\n- Maintain separate processing streams\n- Learn modality-specific representations\n- Combine them effectively for traffic prediction\n\n### Temporal Features\n```python\n"time_in_day_size": 288        # 24 * 60 / 5 = 5-min granularity\n"day_in_week_size": 7         # Weekly periodicity\n"time_emb_dim": 10            # Embedding dimension for temporal features\n```\nThese capture periodic patterns in traffic:\n- Intra-day variations (rush hours)\n- Weekly patterns (weekday vs. weekend)\n- Event-based temporal shifts\n\n### Spatial Features\n```python\n"k_t": 3, "k_s": 2, "gap": 3  # Kernel configurations\n"num_nodes": 207-358           # Sensor network size\n"adjs": [adjacency matrices]   # Multiple spatial resolutions\n```\nThese model:\n- Local spatial correlations (neighboring sensors)\n- Multi-scale spatial patterns (urban zones)\n- Event propagation across spatial regions\n\nEOF\ncat /home/wangwenrui/private/shk/agentCity/FUSE-TRAFFIC_CODE_SNIPPETS.md\n', 'description': 'Create detailed code snippets and implementation guide'}
