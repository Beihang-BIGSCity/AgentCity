float())\n        self.register_buffer(\'mask_support_adj_0\', mask0)\n        self.register_buffer(\'mask_support_adj_1\', mask1)\n\n        # Store adjacency as list of tensors for operations\n        self.adj_mx = [mask0, mask1]\n\n        # Node embeddings for adaptive GNN\n        self.node_vec1 = nn.Parameter(torch.randn(self.num_nodes, 10).to(self.device), requires_grad=True)\n        self.node_vec2 = nn.Parameter(torch.randn(10, self.num_nodes).to(self.device), requires_grad=True)\n\n        # ===== Start MLP (Input encoding) =====\n        # Node embeddings\n        self.node_emb = nn.Parameter(torch.empty(self.num_nodes, self.mlp_node_dim))\n        nn.init.xavier_uniform_(self.node_emb)\n\n        # Temporal embeddings\n        if self.use_day_time:\n            self.time_in_day_emb = nn.Parameter(torch.empty(self.time_of_day_size, self.temp_dim_tid))\n            nn.init.xavier_uniform_(self.time_in_day_emb)\n\n        if self.use_week_time:\n            self.day_in_week_emb = nn.Parameter(torch.empty(self.day_of_week_size, self.temp_dim_diw))\n            nn.init.xavier_uniform_(self.day_in_week_emb)\n\n        # Feature embedding layer\n        self.time_series_emb_layer = nn.Conv2d(\n            in_channels=self.feature_dim * self.input_window,\n            out_channels=self.hidden_channels,\n            kernel_size=(1, 1),\n            bias=True\n        )\n\n        # Fusion layer\n        self.hidden_dim = (self.hidden_channels + self.mlp_node_dim +\n                          self.temp_dim_tid + self.temp_dim_diw)\n        self.start_encoder = nn.Sequential(\n            *[MultiLayerPerceptron(self.hidden_dim, self.hidden_dim)\n              for _ in range(self.num_mlp_layers)]\n        )\n\n        self.fusion_layer = nn.Conv2d(\n            in_channels=self.hidden_dim,\n            out_channels=self.hidden_channels,\n            kernel_size=(1, 1),\n            bias=True\n        )\n\n        # ===== Light Linear (Optional auxiliary path) =====\n        if self.is_use_linear:\n            self.light_linear_layer = LightLinear(self)\n            self.start_scale_light = nn.Conv2d(\n                in_channels=self.scale_step,\n                out_channels=1,\n                kernel_size=(1, 1),\n                bias=True\n            )\n            self.start_linear_light = nn.Conv2d(\n                in_channels=self.hidden_channels * 2,\n                out_channels=self.hidden_channels,\n                kernel_size=(1, 1),\n                bias=True\n            )\n\n        # ===== Temporal Search Layers =====\n        self.temporal_search_layers = nn.ModuleList()\n        if \'TemporalSearch\' in self.layer_names:\n            self.start_temporal = nn.Conv2d(\n                in_channels=1,\n                out_channels=self.hidden_channels,\n                kernel_size=(1, 1),\n                bias=True\n            )\n\n            for _ in range(1):  # One temporal search layer\n                self.temporal_search_layers.append(\n                    create_layer(\'TemporalSearch\',\n                               node_embedding_1=self.node_vec1,\n                               node_embedding_2=self.node_vec2,\n                               adj_mx=self.adj_mx,\n                               config=self,\n                               device=self.device)\n                )\n\n        # ===== Spatial Search Layers =====\n        self.spatial_search_layers = nn.ModuleList()\n        if \'SpatialSearch\' in self.layer_names:\n            for _ in range(1):  # One spatial search layer (processed for each scale)\n                self.spatial_search_layers.append(\n                    create_layer(\'SpatialSearch\',\n                               node_embedding_1=self.node_vec1,\n                               node_embedding_2=self.node_vec2,\n                               adj_mx=self.adj_mx,\n                               config=self,\n                               device=self.device)\n                )\n\n        # Fusion of multi-scale spatial features\n        self.spatial_fusion = nn.Linear(\n            self.hidden_channels * len(self.scale_list),\n            self.hidden_channels\n        )\n\n        # ===== Output Layers =====\n        self.end_conv1 = nn.Linear(self.hidden_channels * 2, self.end_channels)\n        self.end_conv2 = nn.Linear(self.end_channels, self.output_window * self.output_dim)\n\n        self._mode = Mode.ONE_PATH_FIXED  # Default to inference mode\n\n    def forward(self, batch):\n        """\n        Forward pass for AutoSTF model.\n\n        Args:\n            batch: Dictionary containing:\n                - \'X\': Input tensor of shape (batch, time, nodes, features)\n                - \'y\': Target tensor of shape (batch, time, nodes, features)\n\n        Returns:\n            Prediction tensor of shape (batch, time, nodes, features)\n        """\n        # Get input\n        inputs = batch[\'X\']  # (batch, time, nodes, features)\n\n        # Convert to AutoSTF format: (batch, features, nodes, time)\n        inputs = inputs.transpose(1, 3)  # (batch, features, time, nodes)\n        inputs = inputs.transpose(2, 3)  # (batch, features, nodes, time)\n\n        batch_size, num_features, num_nodes, num_timestep = inputs.shape\n\n        # Set inference mode\n        self.set_mode(self._mode)\n\n        # ===== Input Encoding Layer =====\n        history_data = inputs.transpose(1, 3)  # (batch, time, nodes, features)\n\n        # Extract main values and temporal embeddings\n        input_data = history_data[..., :1]  # Take first feature channel\n\n        embeddings_list = []\n\n        # Time series embedding\n        input_flat = input_data.transpose(1, 2).contiguous()  # (batch, nodes, time, 1)\n        input_flat = input_flat.view(batch_size, num_nodes, -1).transpose(1, 2).unsqueeze(-1)\n        time_series_emb = self.time_series_emb_layer(input_flat)  # (batch, hidden, nodes, 1)\n        embeddings_list.append(time_series_emb)\n\n        # Node embeddings\n        node_emb = self.node_emb.unsqueeze(0).expand(batch_size, -1, -1).transpose(1, 2).unsqueeze(-1)\n        embeddings_list.append(node_emb)  # (batch, mlp_node_dim, nodes, 1)\n\n        # Temporal embeddings (if available in input)\n        if self.use_day_time and num_features >= 2:\n            t_i_d_data = history_data[..., 1]\n            tid_idx = (t_i_d_data[:, -1, :] * self.time_of_day_size).long()\n            tid_idx = torch.clamp(tid_idx, 0, self.time_of_day_size - 1)\n            day_emb = self.time_in_day_emb[tid_idx].transpose(1, 2).unsqueeze(-1)\n            embeddings_list.append(day_emb)\n\n        if self.use_week_time and num_features >= 3:\n            d_i_w_data = history_data[..., 2]\n            diw_idx = d_i_w_data[:, -1, :].long()\n            diw_idx = torch.clamp(diw_idx, 0, self.day_of_week_size - 1)\n            week_emb = self.day_in_week_emb[diw_idx].transpose(1, 2).unsqueeze(-1)\n            embeddings_list.append(week_emb)\n\n        # Concatenate all embeddings\n        hidden = torch.cat(embeddings_list, dim=1)  # (batch, hidden_dim, nodes, 1)\n\n        # Encoding through MLP\n        x = self.start_encoder(hidden)  # (batch, hidden_dim, nodes, 1)\n\n        # Fusion\n        x = self.fusion_layer(x).squeeze(-1).transpose(1, 2)  # (batch, nodes, hidden)\n        mlp_residual = x\n\n        # ===== Temporal Search Path =====\n        if \'TemporalSearch\' in self.layer_names:\n            x_t = inputs[:, 0:1, :, :]  # (batch, 1, nodes, time)\n            x_t = self.start_temporal(x_t)  # (batch, hidden, nodes, time)\n\n            temporal_residual = 0\n            for temporal_layer in self.temporal_search_layers:\n                x_t = temporal_layer(x_t, self.mask)\n                temporal_residual += x_t\n\n            x_t = temporal_residual.transpose(1, 3)  # (batch, time, nodes, hidden)\n        else:\n            x_t = None\n\n        # ===== Spatial Search Path with Multi-scale Processing =====\n        spatial_embedding = []\n\n        if x_t is not None:\n            for i in range(len(self.scale_list)):\n                start_scale = i * self.scale_step\n                x_scale = x_t[:, start_scale:start_scale + self.scale_step, :, :]\n\n                x_scale = self.start_scale_light(x_scale).squeeze(1)  # (batch, nodes, hidden)\n\n                # Combine with MLP residual\n                x_combined = torch.cat([mlp_residual, x_scale], dim=-1).unsqueeze(-1)\n                x_combined = x_combined.transpose(1, 2)  # (batch, hidden*2, nodes, 1)\n                x_combined = self.start_linear_light(x_combined).squeeze(-1).transpose(1, 2)  # (batch, nodes, hidden)\n\n                # Apply light linear if enabled\n                if self.is_use_linear:\n                    x_combined = self.light_linear_layer(x_combined)\n\n                # Apply spatial search\n                x_spatial = self.spatial_search_layers[0](x_combined, i, self.mask)\n                spatial_embedding.append(x_spatial)\n        else:\n            # If no temporal search, use MLP residual for spatial processing\n            for i in range(len(self.scale_list)):\n                spatial_embedding.append(mlp_residual)\n\n        # Fuse multi-scale spatial features\n        x = torch.cat(spatial_embedding, dim=-1)  # (batch, nodes, hidden*num_scales)\n        x = self.spatial_fusion(x)  # (batch, nodes, hidden)\n        spatial_residual = x\n\n        # ===== Output Layer =====\n        outputs = [mlp_residual, spatial_residual]\n        output = torch.cat(outputs, dim=-1)  # (batch, nodes, hidden*2)\n\n        # End convolutions\n        x = self.end_conv1(output)  # (batch, nodes, end_channels)\n        x = F.relu(x)\n        x = self.end_conv2(x)  # (batch, nodes, output_window * output_dim)\n\n        # Reshape to (batch, output_window, nodes, output_dim)\n        x = x.view(batch_size, self.num_nodes, self.output_window, self.output_dim)\n        x = x.transpose(1, 2)  # (batch, output_window, nodes, output_dim)\n\n        self.set_mode(Mode.NONE)\n\n        return x\n\n    def predict(self, batch):\n        """\n        Generate predictions for a batch.\n\n        Args:\n            batch: Input batch dictionary\n\n        Returns:\n            Predictions tensor\n        """\n        return self.forward(batch)\n\n    def calculate_loss(self, batch):\n        """\n        Calculate training loss using masked MAE.\n\n        Args:\n            batch: Input batch dictionary\n\n        Returns:\n            Loss tensor\n        """\n        y_true = batch[\'y\']  # (batch, time, nodes, output_dim)\n        y_pred = self.predict(batch)\n\n        # Inverse transform to get actual values\n        y_true = self._scaler.inverse_transform(y_true[..., :self.output_dim])\n        y_pred = self._scaler.inverse_transform(y_pred[..., :self.output_dim])\n\n        # Calculate masked MAE\n        return loss.masked_mae_torch(y_pred, y_true, null_val=0)\n\n    def set_mode(self, mode):\n        """\n        Set the inference mode for the model.\n\n        Args:\n            mode: Mode enum value (ONE_PATH_FIXED, ONE_PATH_RANDOM, TWO_PATHS, ALL_PATHS, NONE)\n        """\n        self._mode = mode\n\n        # Set mode for temporal search layers\n        if \'TemporalSearch\' in self.layer_names:\n            for layer in self.temporal_search_layers:\n                layer.set_mode(mode)\n\n        # Set mode for spatial search layers\n        for layer in self.spatial_search_layers:\n            if hasattr(layer, \'set_mode\'):\n                layer.set_mode(mode)\n'}
