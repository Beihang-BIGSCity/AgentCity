ernel_size=(1, 3), padding=(0, 1), stride=(1, 2))\n    if name == \'AvgPooling\':\n        return nn.AvgPool2d(kernel_size=(1, 3), padding=(0, 1), stride=(1, 2))\n    raise Exception(\'unknown layer name!\')\n\n\nclass AutoSTF(AbstractTrafficStateModel):\n    """\n    AutoSTF: Automated Spatio-Temporal Forecasting with Neural Architecture Search (NAS)\n\n    The model decomposes traffic forecasting into temporal and spatial NAS paths, each with\n    multiple candidate operations (Informer, DCC, GNN variants). It uses multi-scale\n    representations to efficiently capture patterns.\n\n    Args:\n        config: Configuration object containing model hyperparameters\n        data_feature: Dictionary with data information (num_nodes, feature_dim, etc.)\n    """\n\n    def __init__(self, config, data_feature):\n        super().__init__(config, data_feature)\n\n        self._logger = getLogger()\n\n        # Get dimensions from data_feature\n        self.num_nodes = data_feature.get(\'num_nodes\')\n        self.input_window = config.get(\'input_window\')\n        self.output_window = config.get(\'output_window\')\n        self.feature_dim = data_feature.get(\'feature_dim\', 1)\n        self.output_dim = data_feature.get(\'output_dim\', 1)\n        self._scaler = data_feature.get(\'scaler\')\n\n        # Model architecture parameters\n        self.hidden_channels = config.get(\'hidden_channels\', 32)\n        self.end_channels = config.get(\'end_channels\', 32)\n        self.device = config.get(\'device\', torch.device(\'cpu\'))\n\n        # AutoSTF-specific parameters\n        self.num_temporal_search_node = config.get(\'num_temporal_search_node\', 4)\n        self.num_spatial_search_node = config.get(\'num_spatial_search_node\', 4)\n        self.num_mlp_layers = config.get(\'num_mlp_layers\', 2)\n        self.num_linear_layers = config.get(\'num_linear_layers\', 2)\n        self.num_hop = config.get(\'num_hop\', 2)\n        self.num_att_layers = config.get(\'num_att_lay