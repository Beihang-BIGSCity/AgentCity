 run_trial(trial_config, idx, total_trials)\n        trials.append(trial_result)\n        \n        # Track best result\n        score = trial_result.get("score")\n        if score is not None:\n            if best_score is None or score < best_score:\n                best_score = score\n                best_trial = trial_result\n    \n    # Prepare result\n    if best_trial is None:\n        best_trial = trials[0] if trials else {"params": {}, "metrics": {}}\n    \n    result = {\n        "strategy": "direct_config",\n        "status": best_trial.get("status", "error") if best_trial else "error",\n        "best_params": best_trial.get("params", {}),\n        "best_metrics": best_trial.get("metrics", {}),\n        "best_score": best_score,\n        "total_trials": len(trials),\n        "successful_trials": sum(1 for t in trials if t.get("status") == "success"),\n        "trials": trials,\n    }\n    \n    # Save results\n    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")\n    result_file = RESULTS_DIR / f"tuning_result_{MODEL_NAME}_direct_{timestamp}.json"\n    \n    with open(result_file, \'w\') as f:\n        json.dump(result, f, indent=2, default=str)\n    \n    # Print summary\n    print(f"\\n{\'=\'*70}")\n    print(f"TUNING COMPLETED")\n    print(f"{\'=\'*70}")\n    print(f"[INFO] Results saved to: {result_file}")\n    print(f"[INFO] Total trials: {result.get(\'total_trials\')}")\n    print(f"[INFO] Successful trials: {result.get(\'successful_trials\')}")\n    \n    if best_trial.get("status") == "success":\n        print(f"\\nBest Parameters:")\n        for key, value in result.get(\'best_params\', {}).items():\n            print(f"  {key}: {value}")\n        print(f"\\nBest Metrics:")\n        for key, value in result.get(\'best_metrics\', {}).items():\n            if isinstance(value, float):\n                print(f"  {key}: {value:.6f}")\n            else:\n                print(f"  {key}: {value}")\n    else:\n        print(f"\\n[WARN] No successful trials completed")\n    \n    # Print top 5 trials\n    successful_trials = [t for t in trials if t.get(\'status\') == \'success\']\n    if successful_trials:\n        print(f"\\nTop 5 Trials (by MAE):")\n        sorted_trials = sorted(\n            successful_trials,\n            key=lambda t: t.get(\'score\', float(\'inf\'))\n        )[:5]\n        for i, trial in enumerate(sorted_trials, 1):\n            params = trial.get(\'params\', {})\n            metrics = trial.get(\'metrics\', {})\n            mae = metrics.get(\'masked_mae\')\n            rmse = metrics.get(\'masked_rmse\')\n            mape = metrics.get(\'masked_mape\')\n            print(f"\\n  {i}. Trial {trial.get(\'trial_idx\')}")\n            print(f"     Params: lr={params.get(\'learning_rate\')}, bs={params.get(\'batch_size\')}, "\n                  f"nh={params.get(\'num_hidden\')}, do={params.get(\'dropout\')}")\n            if mae is not None:\n                print(f"     MAE: {mae:.6f}, RMSE: {rmse:.6f}, MAPE: {mape:.6f}")\n    \n    return 0 if result.get(\'successful_trials\', 0) > 0 else 1\n\nif __name__ == "__main__":\n    exit_code = main()\n    sys.exit(exit_code)\nEOF\nchmod +x /tmp/fuse_tuning_direct.py\necho "Created direct config tuning script"\n', 'description': 'Create direct config modification tuning script'}
