import asyncio
import json
from agents import AppPaths, setup_logger
from agents.core.orchestrator import AgentOrchestrator

async def run():
    paths = AppPaths()
    paths.ensure()
    logger = setup_logger(paths.log_file)

    orchestrator = AgentOrchestrator(paths=paths, logger=logger)

    paper = json.loads('{"title": "FUSE-Traffic: Fusion of Unstructured and Structured Data for Event-aware Traffic Forecasting", "model_name": "FUSE-Traffic", "repo_url": "https://github.com/GeoAICenter/FUSE-Traffic_Sigspatial2025", "datasets": ["METR_LA"], "conference": "SIGSPATIAL", "year": 2025, "pdf_path": "/home/wangwenrui/private/shk/agentCity/data/articles/SIGSPATIAL2025_FUSE-Traffic.pdf"}')
    await orchestrator.run_tuning([paper])

asyncio.run(run())

