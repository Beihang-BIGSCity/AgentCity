s,\n            "metrics": {},\n            "status": "timeout",\n            "returncode": -1,\n            "elapsed_seconds": 3600,\n            "score": None,\n        }\n    except Exception as exc:\n        print(f"  [ERROR] {exc}")\n        return {\n            "trial_idx": trial_idx,\n            "params": params,\n            "metrics": {},\n            "status": "error",\n            "returncode": -1,\n            "elapsed_seconds": 0,\n            "score": None,\n            "error": str(exc),\n        }\n\nasync def run_grid_search() -> Dict[str, Any]:\n    """Execute custom grid search."""\n    \n    print("="*70)\n    print(f"FUSE-Traffic ({MODEL_NAME}) Hyperparameter Tuning (Grid Search)")\n    print("="*70)\n    print(f"Model: {MODEL_NAME}")\n    print(f"Dataset: {DATASET}")\n    print(f"Search space dimensions: {[len(v) for v in SEARCH_SPACE.values()]}")\n    print(f"Expected trials: {4*3*2*2} = 48")\n    print(f"GPU: cuda:0")\n    print("="*70 + "\\n")\n    \n    # Generate all combinations\n    keys = list(SEARCH_SPACE.keys())\n    values = [SEARCH_SPACE[key] for key in keys]\n    combinations = list(itertools.product(*values))\n    \n    print(f"Generated {len(combinations)} parameter combinations\\n")\n    \n    trials: List[Dict[str, Any]] = []\n    best_trial: Optional[Dict[str, Any]] = None\n    best_score: Optional[float] = None\n    \n    total_trials = len(combinations)\n    \n    for idx, combo in enumerate(combinations, 1):\n        params = dict(zip(keys, combo))\n        trial_result = run_trial(params, idx, total_trials)\n        trials.append(trial_result)\n        \n        # Track best result\n        score = trial_result.get("score")\n        if score is not None:\n            if best_score is None or score < best_score:\n                best_score = score\n                best_trial = trial_result\n    \n    # Prepare result\n    if best_trial is None:\n        # All trials failed, pick first one as placeholder\n        best_tria