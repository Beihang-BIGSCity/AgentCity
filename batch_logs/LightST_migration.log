[ERR] 2026-01-23 02:23:09 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/private/shk/agentCity/Bigscity-LibCity/libcity/model/traffic_flow_prediction/LightST.py', 'content': '"""\nLightST (STMLP) Model Adaptation for LibCity\nOriginal paper: "Efficient traffic prediction through spatio-temporal distillation" (AAAI 2025)\nOriginal repository: https://github.com/lizzyhku/TP\n\nThis is the student model (STMLP) adapted from the LightST repository.\nThe original model uses knowledge distillation, but this adaptation implements\nstandard supervised training compatible with LibCity\'s training framework.\n\nKey changes from original:\n1. Inherits from AbstractTrafficStateModel\n2. Removed knowledge distillation components (distillation features)\n3. Adapted to LibCity\'s batch dictionary format\n4. Simplified forward pass to return only predictions\n5. Added standard calculate_loss method using MAE\n6. Made adjacency matrix optional (can work without graph structure)\n"""\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport numbers\nfrom torch.nn import init\nfrom logging import getLogger\nfrom libcity.model.abstract_traffic_state_model import AbstractTrafficStateModel\nfrom libcity.model import loss\n\n\nclass LayerNorm(nn.Module):\n    """\n    Custom Layer Normalization from original LightST implementation.\n    Supports indexing for per-node normalization.\n    """\n    __constants__ = [\'normalized_shape\', \'weight\', \'bias\', \'eps\', \'elementwise_affine\']\n\n    def __init__(self, normalized_shape, eps=1e-5, elementwise_affine=True):\n        super(LayerNorm, self).__init__()\n        if isinstance(normalized_shape, numbers.Integral):\n            normalized_shape = (normalized_shape,)\n        self.normalized_shape = tuple(normalized_shape)\n        self.eps = eps\n        self.elementwise_affine = elementwise_affine\n        if self.elementwise_affine:\n            self.weight = nn.Parameter(torch.Tensor(*normalized_shape))\n            self.bias = nn.Parameter(torch.Tensor(*normalized_shape))\n        else:\n            self.register_parameter(\'weight\', None)\n            self.register_parameter(\'bias\', None)\n        self.reset_parameters()\n\n    def reset_parameters(self):\n        if self.elementwise_affine:\n            init.ones_(self.weight)\n            init.zeros_(self.bias)\n\n    def forward(self, inputs, idx):\n        if self.elementwise_affine:\n            return F.layer_norm(inputs, tuple(inputs.shape[1:]),\n                                self.weight[:, idx, :], self.bias[:, idx, :], self.eps)\n        else:\n            return F.layer_norm(inputs, tuple(inputs.shape[1:]),\n                                self.weight, self.bias, self.eps)\n\n\nclass DilatedInception(nn.Module):\n    """\n    Multi-scale temporal convolution with dilated kernels.\n    Uses multiple kernel sizes [2, 3, 6, 7] for capturing different temporal patterns.\n    """\n    def __init__(self, cin, cout, dilation_factor=2):\n        super(DilatedInception, self).__init__()\n        self.tconv = nn.ModuleList()\n        self.kernel_set = [2, 3, 6, 7]\n        cout = int(cout / len(self.kernel_set))\n        for kern in self.kernel_set:\n            self.tconv.append(nn.Conv2d(cin, cout, (1, kern), dilation=(1, dilation_factor)))\n\n    def forward(self, input):\n        x = []\n        for i in range(len(self.kernel_set)):\n            x.append(self.tconv[i](input))\n        # Align all outputs to the smallest temporal dimension\n        for i in range(len(self.kernel_set)):\n            x[i] = x[i][..., -x[-1].size(3):]\n        x = torch.cat(x, dim=1)\n        return x\n\n\nclass LightST(AbstractTrafficStateModel):\n    """\n    LightST (STMLP) - Lightweight student model for traffic flow prediction.\n\n    Architecture:\n    - Multi-scale dilated temporal convolutions (DilatedInception)\n    - 3 MLP layers for spatial feature processing\n    - Skip connections and residual blocks\n    - Layer normalization\n\n    Input: [batch, time_in, num_nodes, feature_dim]\n    Output: [batch, time_out, num_nodes, output_dim]\n    """\n\n    def __init__(self, config, data_feature):\n        # Extract data features\n        self.num_nodes = data_feature.get(\'num_nodes\', 1)\n        self.feature_dim = data_feature.get(\'feature_dim\', 1)\n        config[\'num_nodes\'] = self.num_nodes\n        config[\'feature_dim\'] = self.feature_dim\n\n        super().__init__(config, data_feature)\n\n        # Get configuration parameters\n        self.input_window = config.get(\'input_window\', 12)\n        self.output_window = config.get(\'output_window\', 12)\n        self.output_dim = data_feature.get(\'output_dim\', 1)\n        self.device = config.get(\'device\', torch.device(\'cpu\'))\n\n        # Model architecture parameters\n        self.dropout = config.get(\'dropout\', 0.3)\n        self.layers = config.get(\'layers\', 3)  # Number of temporal layers\n        self.dilation_exponential = config.get(\'dilation_exponential\', 1)\n\n        # Channel dimensions\n        self.residual_channels = config.get(\'residual_channels\', 32)\n        self.conv_channels = config.get(\'conv_channels\', 32)\n        self.skip_channels = config.get(\'skip_channels\', 64)\n        self.end_channels = config.get(\'end_channels\', 128)\n\n        # Layer normalization\n        self.layer_norm_affline = config.get(\'layer_norm_affline\', True)\n\n        # Node indexing for layer norm\n        self.idx = torch.arange(self.num_nodes).to(self.device)\n\n        # Initialize model layers\n        self._build_model()\n\n        self._logger = getLogger()\n        self._scaler = self.data_feature.get(\'scaler\')\n\n    def _build_model(self):\n        """Build the model architecture."""\n\n        # Calculate receptive field\n        kernel_size = 7\n        if self.dilation_exponential > 1:\n            self.receptive_field = int(\n                self.output_dim + (kernel_size - 1) *\n                (self.dilation_exponential ** self.layers - 1) /\n                (self.dilation_exponential - 1)\n            )\n        else:\n            self.receptive_field = self.layers * (kernel_size - 1) + self.output_dim\n\n        # Input convolution\n        self.start_conv = nn.Conv2d(\n            in_channels=self.feature_dim,\n            out_channels=self.residual_channels,\n            kernel_size=(1, 1)\n        )\n\n        # Temporal convolution layers\n        self.filter_convs = nn.ModuleList()\n        self.gate_convs = nn.ModuleList()\n        self.skip_convs = nn.ModuleList()\n        self.norm = nn.ModuleList()\n\n        # MLP layers for spatial processing (replacing GCN in original)\n        self.stu_mlp = nn.ModuleList()\n        # These MLPs process temporal dimensions after dilated convolutions\n        # The temporal dimension changes at each layer: 13 -> 7 -> 1\n        self.stu_mlp.append(nn.Sequential(\n            nn.Linear(13, 13), nn.Linear(13, 13), nn.Linear(13, 13)\n        ))\n        self.stu_mlp.append(nn.Sequential(\n            nn.Linear(7, 7), nn.Linear(7, 7), nn.Linear(7, 7)\n        ))\n        self.stu_mlp.append(nn.Sequential(\n            nn.Linear(1, 1), nn.Linear(1, 1), nn.Linear(1, 1)\n        ))\n\n        # Build layers\n        new_dilation = 1\n        for j in range(1, self.layers + 1):\n            # Calculate receptive field size for this layer\n            if self.dilation_exponential > 1:\n                rf_size_j = int(\n                    1 + (kernel_size - 1) *\n                    (self.dilation_exponential ** j - 1) /\n                    (self.dilation_exponential - 1)\n                )\n            else:\n                rf_size_j = 1 + j * (kernel_size - 1)\n\n            # Dilated temporal convolutions with gating\n            self.filter_convs.append(\n                DilatedInception(self.residual_channels, self.conv_channels,\n                               dilation_factor=new_dilation)\n            )\n            self.gate_convs.append(\n                DilatedInception(self.residual_channels, self.conv_channels,\n                               dilation_factor=new_dilation)\n            )\n\n            # Skip connections\n            if self.input_window > self.receptive_field:\n                self.skip_convs.append(\n                    nn.Conv2d(in_channels=self.conv_channels,\n                            out_channels=self.skip_channels,\n                            kernel_size=(1, self.input_window - rf_size_j + 1))\n                )\n            else:\n                self.skip_convs.append(\n                    nn.Conv2d(in_channels=self.conv_channels,\n                            out_channels=self.skip_channels,\n                            kernel_size=(1, self.receptive_field - rf_size_j + 1))\n                )\n\n            # Layer normalization\n            if self.input_window > self.receptive_field:\n                self.norm.append(\n                    LayerNorm((self.residual_channels, self.num_nodes,\n                              self.input_window - rf_size_j + 1),\n                             elementwise_affine=self.layer_norm_affline)\n                )\n            else:\n                self.norm.append(\n                    LayerNorm((self.residual_channels, self.num_nodes,\n                              self.receptive_field - rf_size_j + 1),\n                             elementwise_affine=self.layer_norm_affline)\n                )\n\n            new_dilation *= self.dilation_exponential\n\n        # Output layers\n        self.end_conv_1 = nn.Conv2d(\n            in_channels=self.skip_channels,\n            out_channels=self.end_channels,\n            kernel_size=(1, 1),\n            bias=True\n        )\n        self.end_conv_2 = nn.Conv2d(\n            in_channels=self.end_channels,\n            out_channels=self.output_window,\n            kernel_size=(1, 1),\n            bias=True\n        )\n\n        # Skip connection from input\n        if self.input_window > self.receptive_field:\n            self.skip0 = nn.Conv2d(\n                in_channels=self.feature_dim,\n                out_channels=self.skip_channels,\n                kernel_size=(1, self.input_window),\n                bias=True\n            )\n            self.skipE = nn.Conv2d(\n                in_channels=self.residual_channels,\n                out_channels=self.skip_channels,\n                kernel_size=(1, self.input_window - self.receptive_field + 1),\n                bias=True\n            )\n        else:\n            self.skip0 = nn.Conv2d(\n                in_channels=self.feature_dim,\n                out_channels=self.skip_channels,\n                kernel_size=(1, self.receptive_field),\n                bias=True\n            )\n            self.skipE = nn.Conv2d(\n                in_channels=self.residual_channels,\n                out_channels=self.skip_channels,\n                kernel_size=(1, 1),\n                bias=True\n            )\n\n    def forward(self, batch):\n        """\n        Forward pass.\n\n        Args:\n            batch: Dict with key \'X\' containing input tensor\n                   Shape: [batch_size, input_window, num_nodes, feature_dim]\n\n        Returns:\n            predictions: Tensor of shape [batch_size, output_window, num_nodes, output_dim]\n        """\n        inputs = batch[\'X\']  # [B, T, N, C]\n\n        # Transpose to [B, C, N, T] for convolution\n        inputs = inputs.transpose(1, 3)  # [B, C, N, T]\n\n        # Verify input dimensions\n        assert inputs.size(3) == self.input_window, \\\n            f\'Input sequence length {inputs.size(3)} != preset length {self.input_window}\'\n\n        # Pad if necessary\n        if self.input_window < self.receptive_field:\n            inputs = F.pad(inputs, (self.receptive_field - self.input_window, 0, 0, 0))\n\n        # Initial convolution and skip connection\n        x = self.start_conv(inputs)\n        skip = self.skip0(F.dropout(inputs, self.dropout, training=self.training))\n\n        # Process through temporal layers with MLP spatial processing\n        for i in range(self.layers):\n            residual = x\n\n            # Gated temporal convolution\n            filters = self.filter_convs[i](x)\n            filters = torch.tanh(filters)\n            gate = self.gate_convs[i](x)\n            gate = torch.sigmoid(gate)\n            x = filters * gate\n            x = F.dropout(x, self.dropout, training=self.training)\n\n            # Skip connection\n            s = self.skip_convs[i](x)\n            skip = s + skip\n\n            # MLP-based spatial processing (replaces GCN)\n            x = self.stu_mlp[i](x)\n\n            # Residual connection\n            x = x + residual[:, :, :, -x.size(3):]\n\n            # Layer normalization\n            x = self.norm[i](x, self.idx)\n\n        # Final skip connection and output\n        skip = self.skipE(x) + skip\n        x = F.relu(skip)\n        x = F.relu(self.end_conv_1(x))\n        x = self.end_conv_2(x)  # [B, T_out, N, 1]\n\n        # Transpose back to LibCity format: [B, T, N, C]\n        x = x.transpose(1, 3).transpose(1, 2)\n\n        return x\n\n    def predict(self, batch):\n        """\n        Prediction method required by LibCity.\n\n        Args:\n            batch: Input batch dictionary\n\n        Returns:\n            predictions: Predicted values\n        """\n        return self.forward(batch)\n\n    def calculate_loss(self, batch):\n        """\n        Calculate loss for training.\n\n        Args:\n            batch: Batch dictionary with \'X\' (input) and \'y\' (target)\n\n        Returns:\n            loss: MAE loss tensor\n        """\n        y_true = batch[\'y\']\n        y_predicted = self.predict(batch)\n\n        # Inverse transform if scaler is available\n        if self._scaler is not None:\n            y_true = self._scaler.inverse_transform(y_true[..., :self.output_dim])\n            y_predicted = self._scaler.inverse_transform(y_predicted[..., :self.output_dim])\n\n        # Use masked MAE loss (masks zero values)\n        return loss.masked_mae_torch(y_predicted, y_true, 0)\n'}
