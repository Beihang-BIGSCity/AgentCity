[ERR] 2026-01-23 12:10:25 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/private/shk/agentCity/Bigscity-LibCity/libcity/model/traffic_speed_prediction/LightST.py', 'content': '"""\nLightST Model for LibCity\n\nAdapted from STMLP (Student model) in the LightST repository.\nThis model uses DilatedInception for temporal feature extraction and MLP for spatial processing,\nproviding a lightweight alternative to GCN-based models.\n\nOriginal Source: repos/LightST/model/Teacher.py (STMLP class, lines 547-747)\n\nKey Adaptations:\n1. Inherited from AbstractTrafficStateModel\n2. Adapted to LibCity batch format: batch[\'X\'] shape (B, T_in, N, F)\n3. Removed knowledge distillation outputs (focused on single prediction output)\n4. Integrated with LibCity\'s scaler for normalization\n5. Implemented required methods: __init__, forward, predict, calculate_loss\n"""\n\nfrom __future__ import division\nimport torch\nimport torch.nn as nn\nfrom torch.nn import init\nimport numbers\nimport torch.nn.functional as F\nfrom logging import getLogger\n\nfrom libcity.model.abstract_traffic_state_model import AbstractTrafficStateModel\nfrom libcity.model import loss\n\n\nclass DilatedInception(nn.Module):\n    """\n    DilatedInception module for temporal feature extraction.\n    Uses multiple kernel sizes with dilation for multi-scale temporal patterns.\n    """\n    def __init__(self, cin, cout, dilation_factor=2):\n        super(DilatedInception, self).__init__()\n        self.tconv = nn.ModuleList()\n        self.kernel_set = [2, 3, 6, 7]\n        cout = int(cout / len(self.kernel_set))\n        for kern in self.kernel_set:\n            self.tconv.append(nn.Conv2d(cin, cout, (1, kern), dilation=(1, dilation_factor)))\n\n    def forward(self, input):\n        x = []\n        for i in range(len(self.kernel_set)):\n            x.append(self.tconv[i](input))\n        for i in range(len(self.kernel_set)):\n            x[i] = x[i][..., -x[-1].size(3):]\n        x = torch.cat(x, dim=1)\n        return x\n\n\nclass LayerNorm(nn.Module):\n    """\n    Custom LayerNorm that supports node-wise indexing.\n    """\n    __constants__ = [\'normalized_shape\', \'weight\', \'bias\', \'eps\', \'elementwise_affine\']\n\n    def __init__(self, normalized_shape, eps=1e-5, elementwise_affine=True):\n        super(LayerNorm, self).__init__()\n        if isinstance(normalized_shape, numbers.Integral):\n            normalized_shape = (normalized_shape,)\n        self.normalized_shape = tuple(normalized_shape)\n        self.eps = eps\n        self.elementwise_affine = elementwise_affine\n        if self.elementwise_affine:\n            self.weight = nn.Parameter(torch.Tensor(*normalized_shape))\n            self.bias = nn.Parameter(torch.Tensor(*normalized_shape))\n        else:\n            self.register_parameter(\'weight\', None)\n            self.register_parameter(\'bias\', None)\n        self.reset_parameters()\n\n    def reset_parameters(self):\n        if self.elementwise_affine:\n            init.ones_(self.weight)\n            init.zeros_(self.bias)\n\n    def forward(self, inputs, idx):\n        if self.elementwise_affine:\n            return F.layer_norm(inputs, tuple(inputs.shape[1:]),\n                                self.weight[:, idx, :], self.bias[:, idx, :], self.eps)\n        else:\n            return F.layer_norm(inputs, tuple(inputs.shape[1:]),\n                                self.weight, self.bias, self.eps)\n\n    def extra_repr(self):\n        return \'{normalized_shape}, eps={eps}, \' \\\n            \'elementwise_affine={elementwise_affine}\'.format(**self.__dict__)\n\n\nclass LightST(AbstractTrafficStateModel):\n    """\n    LightST: A lightweight spatial-temporal forecasting model using MLP for spatial processing.\n\n    Architecture:\n    - DilatedInception for temporal feature extraction\n    - 3-layer MLPs for lightweight spatial processing (instead of GCN)\n    - Skip connections and residual connections\n    - Layer normalization\n\n    This is the student model from LightST that achieves competitive performance\n    with much lower computational cost compared to GCN-based models.\n    """\n\n    def __init__(self, config, data_feature):\n        super().__init__(config, data_feature)\n\n        # Extract data features\n        self.num_nodes = self.data_feature.get(\'num_nodes\', 1)\n        self.feature_dim = self.data_feature.get(\'feature_dim\', 1)\n\n        # Extract config parameters\n        self.input_window = config.get(\'input_window\', 12)\n        self.output_window = config.get(\'output_window\', 12)\n        self.output_dim = config.get(\'output_dim\', 1)\n        self.device = config.get(\'device\', torch.device(\'cpu\'))\n\n        # Model architecture parameters\n        self.dropout = config.get(\'dropout\', 0.3)\n        self.dilation_exponential = config.get(\'dilation_exponential\', 1)\n\n        self.conv_channels = config.get(\'conv_channels\', 32)\n        self.residual_channels = config.get(\'residual_channels\', 32)\n        self.skip_channels = config.get(\'skip_channels\', 64)\n        self.end_channels = config.get(\'end_channels\', 128)\n\n        self.layers = config.get(\'layers\', 3)\n        self.layer_norm_affline = config.get(\'layer_norm_affline\', True)\n\n        # Logger and scaler\n        self._logger = getLogger()\n        self._scaler = self.data_feature.get(\'scaler\')\n\n        # Node indices for layer norm\n        self.idx = torch.arange(self.num_nodes).to(self.device)\n\n        # Initialize model layers\n        self.filter_convs = nn.ModuleList()\n        self.gate_convs = nn.ModuleList()\n        self.skip_convs = nn.ModuleList()\n        self.norm = nn.ModuleList()\n\n        # MLP modules for spatial processing (3-layer MLPs as in the original)\n        # Each layer processes different temporal receptive fields\n        self.stu_mlp = nn.ModuleList()\n        # Note: The original model has hardcoded layer dimensions based on receptive field\n        # We\'ll create them dynamically based on the receptive field calculation\n\n        # Start convolution\n        self.start_conv = nn.Conv2d(\n            in_channels=self.feature_dim,\n            out_channels=self.residual_channels,\n            kernel_size=(1, 1)\n        )\n\n        # Calculate receptive field\n        kernel_size = 7\n        if self.dilation_exponential > 1:\n            self.receptive_field = int(\n                self.output_dim + (kernel_size - 1) *\n                (self.dilation_exponential ** self.layers - 1) /\n                (self.dilation_exponential - 1)\n            )\n        else:\n            self.receptive_field = self.layers * (kernel_size - 1) + self.output_dim\n\n        # Build temporal and spatial layers\n        for i in range(1):\n            if self.dilation_exponential > 1:\n                rf_size_i = int(\n                    1 + i * (kernel_size - 1) *\n                    (self.dilation_exponential ** self.layers - 1) /\n                    (self.dilation_exponential - 1)\n                )\n            else:\n                rf_size_i = i * self.layers * (kernel_size - 1) + 1\n\n            new_dilation = 1\n            for j in range(1, self.layers + 1):\n                if self.dilation_exponential > 1:\n                    rf_size_j = int(\n                        rf_size_i + (kernel_size - 1) *\n                        (self.dilation_exponential ** j - 1) /\n                        (self.dilation_exponential - 1)\n                    )\n                else:\n                    rf_size_j = rf_size_i + j * (kernel_size - 1)\n\n                # Temporal convolutions with DilatedInception\n                self.filter_convs.append(\n                    DilatedInception(\n                        self.residual_channels,\n                        self.conv_channels,\n                        dilation_factor=new_dilation\n                    )\n                )\n                self.gate_convs.append(\n                    DilatedInception(\n                        self.residual_channels,\n                        self.conv_channels,\n                        dilation_factor=new_dilation\n                    )\n                )\n\n                # Skip connections\n                if self.input_window > self.receptive_field:\n                    self.skip_convs.append(\n                        nn.Conv2d(\n                            in_channels=self.conv_channels,\n                            out_channels=self.skip_channels,\n                            kernel_size=(1, self.input_window - rf_size_j + 1)\n                        )\n                    )\n                else:\n                    self.skip_convs.append(\n                        nn.Conv2d(\n                            in_channels=self.conv_channels,\n                            out_channels=self.skip_channels,\n                            kernel_size=(1, self.receptive_field - rf_size_j + 1)\n                        )\n                    )\n\n                # Layer normalization\n                if self.input_window > self.receptive_field:\n                    self.norm.append(\n                        LayerNorm(\n                            (self.residual_channels, self.num_nodes,\n                             self.input_window - rf_size_j + 1),\n                            elementwise_affine=self.layer_norm_affline\n                        )\n                    )\n                else:\n                    self.norm.append(\n                        LayerNorm(\n                            (self.residual_channels, self.num_nodes,\n                             self.receptive_field - rf_size_j + 1),\n                            elementwise_affine=self.layer_norm_affline\n                        )\n                    )\n\n                new_dilation *= self.dilation_exponential\n\n        # MLP modules for spatial processing\n        # Original implementation has 3 MLPs with dimensions [13,13,13], [7,7,7], [1,1,1]\n        # These correspond to different temporal sizes after dilated convolutions\n        # We create them based on the expected temporal dimensions\n        mlp_dims = []\n        if self.input_window >= 12:\n            mlp_dims = [13, 7, 1]  # For input_window=12\n        else:\n            # Adjust for different input windows\n            for i in range(self.layers):\n                mlp_dims.append(max(1, self.input_window - i * 2))\n\n        for dim in mlp_dims[:self.layers]:\n            self.stu_mlp.append(\n                nn.Sequential(\n                    nn.Linear(dim, dim),\n                    nn.Linear(dim, dim),\n                    nn.Linear(dim, dim)\n                )\n            )\n\n        # End convolutions\n        self.end_conv_1 = nn.Conv2d(\n            in_channels=self.skip_channels,\n            out_channels=self.end_channels,\n            kernel_size=(1, 1),\n            bias=True\n        )\n        self.end_conv_2 = nn.Conv2d(\n            in_channels=self.end_channels,\n            out_channels=self.output_window,\n            kernel_size=(1, 1),\n            bias=True\n        )\n\n        # Skip connections for input and end\n        if self.input_window > self.receptive_field:\n            self.skip0 = nn.Conv2d(\n                in_channels=self.feature_dim,\n                out_channels=self.skip_channels,\n                kernel_size=(1, self.input_window),\n                bias=True\n            )\n            self.skipE = nn.Conv2d(\n                in_channels=self.residual_channels,\n                out_channels=self.skip_channels,\n                kernel_size=(1, self.input_window - self.receptive_field + 1),\n                bias=True\n            )\n        else:\n            self.skip0 = nn.Conv2d(\n                in_channels=self.feature_dim,\n                out_channels=self.skip_channels,\n                kernel_size=(1, self.receptive_field),\n                bias=True\n            )\n            self.skipE = nn.Conv2d(\n                in_channels=self.residual_channels,\n                out_channels=self.skip_channels,\n                kernel_size=(1, 1),\n                bias=True\n            )\n\n        self._logger.info(\'LightST receptive_field: \' + str(self.receptive_field))\n\n    def forward(self, batch, idx=None):\n        """\n        Forward pass of LightST model.\n\n        Args:\n            batch (dict): Dictionary containing \'X\' with shape (B, T_in, N, F)\n            idx (optional): Node indices for subgraph processing\n\n        Returns:\n            torch.Tensor: Predictions with shape (B, T_out, N, 1)\n        """\n        # Get input from batch\n        inputs = batch[\'X\']  # (batch_size, input_window, num_nodes, feature_dim)\n\n        # Transpose to (batch_size, feature_dim, num_nodes, input_window)\n        inputs = inputs.transpose(1, 3)\n\n        # Validate input sequence length\n        assert inputs.size(3) == self.input_window, \\\n            \'input sequence length not equal to preset sequence length\'\n\n        # Pad if necessary\n        if self.input_window < self.receptive_field:\n            inputs = nn.functional.pad(\n                inputs,\n                (self.receptive_field - self.input_window, 0, 0, 0)\n            )\n\n        # Start convolution\n        x = self.start_conv(inputs)\n        skip = self.skip0(F.dropout(inputs, self.dropout, training=self.training))\n\n        # Process through layers\n        for i in range(self.layers):\n            residual = x\n\n            # Temporal gated convolution\n            filters = self.filter_convs[i](x)\n            filters = torch.tanh(filters)\n            gate = self.gate_convs[i](x)\n            gate = torch.sigmoid(gate)\n            x = filters * gate\n            x = F.dropout(x, self.dropout, training=self.training)\n\n            # Skip connection\n            s = x\n            s = self.skip_convs[i](s)\n            skip = s + skip\n\n            # Spatial processing with MLP (instead of GCN)\n            x = self.stu_mlp[i](x)\n\n            # Residual connection\n            x = x + residual[:, :, :, -x.size(3):]\n\n            # Layer normalization\n            if idx is None:\n                x = self.norm[i](x, self.idx)\n            else:\n                x = self.norm[i](x, idx)\n\n        # Final skip connection and output projection\n        skip = self.skipE(x) + skip\n        x = F.relu(skip)\n        x = F.relu(self.end_conv_1(x))\n        x = self.end_conv_2(x)\n\n        return x\n\n    def calculate_loss(self, batch):\n        """\n        Calculate loss for training.\n\n        Args:\n            batch (dict): Dictionary containing \'X\' and \'y\'\n\n        Returns:\n            torch.Tensor: Scalar loss value\n        """\n        y_true = batch[\'y\']\n        y_predicted = self.predict(batch)\n\n        # Inverse transform to original scale\n        y_true = self._scaler.inverse_transform(y_true[..., :self.output_dim])\n        y_predicted = self._scaler.inverse_transform(y_predicted[..., :self.output_dim])\n\n        # Calculate masked MAE loss\n        return loss.masked_mae_torch(y_predicted, y_true, 0)\n\n    def predict(self, batch):\n        """\n        Make predictions.\n\n        Args:\n            batch (dict): Dictionary containing \'X\'\n\n        Returns:\n            torch.Tensor: Predictions\n        """\n        return self.forward(batch)\n'}
