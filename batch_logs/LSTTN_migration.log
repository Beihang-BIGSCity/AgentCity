[ERR] 2026-01-22 17:35:07 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/private/shk/agentCity/Bigscity-LibCity/libcity/model/traffic_speed_prediction/LSTTN.py', 'content': '"""\nLSTTN (Long Short-Term Transformer Network) Model for Traffic Speed Prediction\n\nOriginal paper: "LSTTN: Long Short-Term Transformer Network for Spatiotemporal Traffic Forecasting"\nOriginal code: https://github.com/liuxu77/LSTTN\n\nThis implementation adapts LSTTN to LibCity conventions.\n\nArchitecture:\n- Long-term component: Masked transformer with dilated convolutions (processes 14 days of data)\n- Short-term component: GraphWaveNet with adaptive graph convolution (processes 1 hour of data)\n- Fusion: MLP-based trend-seasonality fusion\n\nKey Adaptations:\n1. LibCity provides batch[\'X\'] with shape (batch_size, input_window, num_nodes, feature_dim)\n2. LSTTN requires both short (12 steps) and long (4032 steps) sequences\n3. We extract short sequence from the last 12 steps of batch[\'X\']\n4. For long sequence, we expect input_window to include historical data (or use zero-padding as fallback)\n5. Transformer weights can be loaded from pretrained checkpoints if available\n"""\n\nimport math\nimport random\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.nn import TransformerEncoder, TransformerEncoderLayer\nfrom torch.nn.init import trunc_normal_\nfrom logging import getLogger\nimport numpy as np\n\nfrom libcity.model.abstract_traffic_state_model import AbstractTrafficStateModel\nfrom libcity.model import loss\n\n\n# ==================== Transformer Components ====================\n\nclass InputEmbedding(nn.Module):\n    """Patch embedding for long-term sequences"""\n    def __init__(self, patch_size, input_channel, output_channel):\n        super().__init__()\n        self.output_channel = output_channel\n        self.patch_size = patch_size\n        self.input_channel = input_channel\n        self.output_channel = output_channel\n        self.input_embedding = nn.Conv2d(\n            input_channel, output_channel, kernel_size=(self.patch_size, 1), stride=(self.patch_size, 1)\n        )\n\n    def forward(self, input):\n        batch_size, num_nodes, num_channels, long_seq_len = input.size()\n        input = input.unsqueeze(-1)\n        input = input.reshape(batch_size * num_nodes, num_channels, long_seq_len, 1)\n        output = self.input_embedding(input)\n        output = output.squeeze(-1).view(batch_size, num_nodes, self.output_channel, -1)\n        return output\n\n\nclass LearnableTemporalPositionalEncoding(nn.Module):\n    """Learnable positional encoding"""\n    def __init__(self, d_model, dropout=0.1, max_len: int = 1000):\n        super().__init__()\n        self.dropout = nn.Dropout(p=dropout)\n        self.pe = nn.Parameter(torch.empty(max_len, d_model), requires_grad=True)\n        nn.init.uniform_(self.pe, -0.02, 0.02)\n\n    def forward(self, input, indices):\n        if indices is None:\n            pe = self.pe[: input.size(1), :].unsqueeze(0)\n        else:\n            pe = self.pe[indices].unsqueeze(0)\n        x = input + pe\n        x = self.dropout(x)\n        return x\n\n\nclass PositionalEncoding(nn.Module):\n    """Wrapper for temporal positional encoding"""\n    def __init__(self, hidden_dim, dropout=0.1):\n        super().__init__()\n        self.tem_pe = LearnableTemporalPositionalEncoding(hidden_dim, dropout)\n\n    def forward(self, input, indices=None):\n        batch_size, num_nodes, num_subseq, out_channels = input.size()\n        input = self.tem_pe(input.view(batch_size * num_nodes, num_subseq, out_channels), indices=indices)\n        input = input.view(batch_size, num_nodes, num_subseq, out_channels)\n        return input\n\n\nclass TransformerLayers(nn.Module):\n    """Standard transformer encoder layers"""\n    def __init__(self, hidden_dim, num_layers, num_heads=4, dropout=0.1):\n        super().__init__()\n        self.d_model = hidden_dim\n        encoder_layers = TransformerEncoderLayer(hidden_dim, num_heads, hidden_dim * 4, dropout, batch_first=False)\n        self.transformer_encoder = TransformerEncoder(encoder_layers, num_layers)\n\n    def forward(self, input):\n        batch_size, num_nodes, num_subseq, out_channels = input.size()\n        x = input * math.sqrt(self.d_model)\n        x = x.view(batch_size * num_nodes, num_subseq, out_channels)\n        x = x.transpose(0, 1)\n        output = self.transformer_encoder(x, mask=None)\n        output = output.transpose(0, 1).view(batch_size, num_nodes, num_subseq, out_channels)\n        return output\n\n\nclass Transformer(nn.Module):\n    """Transformer for long-term temporal dependency modeling"""\n    def __init__(\n        self, patch_size, in_channel, out_channel, dropout, mask_size, mask_ratio, num_encoder_layers=6, mode="inference"\n    ):\n        super().__init__()\n        self.patch_size = patch_size\n        self.selected_feature = 0\n        self.mode = mode\n        self.patch = InputEmbedding(patch_size, in_channel, out_channel)\n        self.pe = PositionalEncoding(out_channel, dropout=dropout)\n        self.encoder = TransformerLayers(out_channel, num_encoder_layers)\n\n    def forward(self, input_data):\n        """\n        Args:\n            input_data: (batch_size, num_nodes, num_features, long_seq_len)\n        Returns:\n            hidden: (batch_size, num_nodes, num_subseq, out_channel)\n        """\n        patches = self.patch(input_data)\n        patches = patches.transpose(-1, -2)\n        patches = self.pe(patches)\n        hidden = self.encoder(patches)\n        return hidden\n\n\n# ==================== Long-term Components ====================\n\nclass StackedDilatedConv(nn.Module):\n    """Stacked dilated convolutions for long-term trend extraction"""\n    def __init__(self, input_dim, hidden_dim):\n        super().__init__()\n        self.conv1 = nn.Conv1d(input_dim, hidden_dim, kernel_size=3, stride=2, dilation=1, padding=1)\n        self.pool1 = nn.MaxPool1d(kernel_size=3, stride=2, padding=1)\n        self.conv2 = nn.Conv1d(hidden_dim, hidden_dim, kernel_size=3, stride=2, dilation=2, padding=2)\n        self.pool2 = nn.MaxPool1d(kernel_size=3, stride=2, padding=1)\n        self.conv3 = nn.Conv1d(hidden_dim, hidden_dim, kernel_size=3, stride=2, dilation=4, padding=4)\n        self.pool3 = nn.MaxPool1d(kernel_size=3, stride=2, padding=1)\n        self.conv4 = nn.Conv1d(hidden_dim, hidden_dim, kernel_size=3, stride=2, dilation=8, padding=8)\n        self.pool4 = nn.MaxPool1d(kernel_size=3, stride=2, padding=1)\n\n    def forward(self, x):\n        h = self.conv1(x)\n        h = F.gelu(h)\n        h = self.pool1(h)\n        h = self.conv2(h)\n        h = F.gelu(h)\n        h = self.pool2(h)\n        h = self.conv3(h)\n        h = F.gelu(h)\n        h = self.pool3(h)\n        h = self.conv4(h)\n        h = F.gelu(h)\n        h = self.pool4(h)\n        return h\n\n\nclass DynamicGraphConv(nn.Module):\n    """Dynamic graph convolution with adaptive adjacency"""\n    def __init__(self, num_nodes, input_dim, output_dim, dropout, support_len=3, order=2):\n        super().__init__()\n        self.node_vec1 = nn.Parameter(torch.randn(num_nodes, 10))\n        self.node_vec2 = nn.Parameter(torch.randn(10, num_nodes))\n        input_dim = (order * support_len + 1) * input_dim\n        self.linear = nn.Linear(input_dim, output_dim)\n        self.dropout = nn.Dropout(p=dropout)\n        self.order = order\n\n    def conv(self, x, adj_mx):\n        return torch.einsum("bnh,nm->bmh", (x, adj_mx)).contiguous()\n\n    def forward(self, x, supports):\n        outputs = [x]\n        new_supports = []\n        new_supports.extend(supports)\n        adaptive = torch.softmax(torch.relu(torch.mm(self.node_vec1, self.node_vec2)), dim=1)\n        new_supports.append(adaptive)\n        for adj_mx in new_supports:\n            adj_mx = adj_mx.to(x.device)\n            x1 = self.conv(x, adj_mx)\n            outputs.append(x1)\n            for k in range(2, self.order + 1):\n                x2 = self.conv(x1, adj_mx)\n                outputs.append(x2)\n                x1 = x2\n        outputs = torch.cat(outputs, dim=2)\n        outputs = self.linear(outputs)\n        outputs = self.dropout(outputs)\n        return outputs\n\n\n# ==================== Short-term GraphWaveNet Components ====================\n\nclass NConv(nn.Module):\n    """Graph convolution operation"""\n    def __init__(self):\n        super(NConv, self).__init__()\n\n    def forward(self, x, A):\n        A = A.to(x.device)\n        if len(A.shape) == 3:\n            x = torch.einsum("ncvl,nvw->ncwl", (x, A))\n        else:\n            x = torch.einsum("ncvl,vw->ncwl", (x, A))\n        return x.contiguous()\n\n\nclass Linear(nn.Module):\n    """1x1 convolution for channel transformation"""\n    def __init__(self, c_in, c_out):\n        super(Linear, self).__init__()\n        self.mlp = torch.nn.Conv2d(c_in, c_out, kernel_size=(1, 1), padding=(0, 0), stride=(1, 1), bias=True)\n\n    def forward(self, x):\n        return self.mlp(x)\n\n\nclass GCN(nn.Module):\n    """Graph Convolutional Network"""\n    def __init__(self, c_in, c_out, dropout, support_len=3, order=2):\n        super(GCN, self).__init__()\n        self.nconv = NConv()\n        c_in = (order * support_len + 1) * c_in\n        self.mlp = Linear(c_in, c_out)\n        self.dropout = dropout\n        self.order = order\n\n    def forward(self, x, support):\n        out = [x]\n        for a in support:\n            a = a.to(x.device)\n            x1 = self.nconv(x, a)\n            out.append(x1)\n            for k in range(2, self.order + 1):\n                x2 = self.nconv(x1, a)\n                out.append(x2)\n                x1 = x2\n\n        h = torch.cat(out, dim=1)\n        h = self.mlp(h)\n        h = F.dropout(h, self.dropout, training=self.training)\n        return h\n\n\nclass GraphWaveNet(nn.Module):\n    """Graph WaveNet for short-term spatio-temporal modeling"""\n    def __init__(\n        self,\n        num_nodes,\n        supports,\n        dropout=0.3,\n        gcn_bool=True,\n        addaptadj=True,\n        aptinit=None,\n        in_dim=2,\n        out_dim=12,\n        residual_channels=32,\n        dilation_channels=32,\n        skip_channels=256,\n        end_channels=512,\n        kernel_size=2,\n        blocks=4,\n        layers=2,\n    ):\n        super(GraphWaveNet, self).__init__()\n        self.dropout = dropout\n        self.blocks = blocks\n        self.layers = layers\n        self.gcn_bool = gcn_bool\n        self.addaptadj = addaptadj\n\n        self.filter_convs = nn.ModuleList()\n        self.gate_convs = nn.ModuleList()\n        self.residual_convs = nn.ModuleList()\n        self.skip_convs = nn.ModuleList()\n        self.bn = nn.ModuleList()\n        self.gconv = nn.ModuleList()\n        self.start_conv = nn.Conv2d(in_channels=in_dim, out_channels=residual_channels, kernel_size=(1, 1))\n        self.supports = supports\n\n        receptive_field = 1\n\n        self.supports_len = 0\n        if supports is not None:\n            self.supports_len += len(supports)\n\n        if gcn_bool and addaptadj:\n            if aptinit is None:\n                if supports is None:\n                    self.supports = []\n                self.nodevec1 = nn.Parameter(torch.randn(num_nodes, 10), requires_grad=True)\n                self.nodevec2 = nn.Parameter(torch.randn(10, num_nodes), requires_grad=True)\n                self.supports_len += 1\n            else:\n                if supports is None:\n                    self.supports = []\n                m, p, n = torch.svd(aptinit)\n                initemb1 = torch.mm(m[:, :10], torch.diag(p[:10] ** 0.5))\n                initemb2 = torch.mm(torch.diag(p[:10] ** 0.5), n[:, :10].t())\n                self.nodevec1 = nn.Parameter(initemb1, requires_grad=True)\n                self.nodevec2 = nn.Parameter(initemb2, requires_grad=True)\n                self.supports_len += 1\n\n        for b in range(blocks):\n            additional_scope = kernel_size - 1\n            new_dilation = 1\n            for i in range(layers):\n                # dilated convolutions\n                self.filter_convs.append(\n                    nn.Conv2d(\n                        in_channels=residual_channels,\n                        out_channels=dilation_channels,\n                        kernel_size=(1, kernel_size),\n                        dilation=new_dilation,\n                    )\n                )\n\n                self.gate_convs.append(\n                    nn.Conv2d(\n                        in_channels=residual_channels,\n                        out_channels=dilation_channels,\n                        kernel_size=(1, kernel_size),\n                        dilation=new_dilation,\n                    )\n                )\n\n                # 1x1 convolution for residual connection\n                self.residual_convs.append(\n                    nn.Conv1d(in_channels=dilation_channels, out_channels=residual_channels, kernel_size=(1, 1))\n                )\n\n                # 1x1 convolution for skip connection\n                self.skip_convs.append(\n                    nn.Conv2d(in_channels=dilation_channels, out_channels=skip_channels, kernel_size=(1, 1))\n                )\n                self.bn.append(nn.BatchNorm2d(residual_channels))\n                new_dilation *= 2\n                receptive_field += additional_scope\n                additional_scope *= 2\n                if self.gcn_bool:\n                    self.gconv.append(gcn(dilation_channels, residual_channels, dropout, support_len=self.supports_len))\n\n        self.end_conv_1 = nn.Conv2d(in_channels=skip_channels, out_channels=end_channels, kernel_size=(1, 1), bias=True)\n\n        self.end_conv_2 = nn.Conv2d(in_channels=end_channels, out_channels=out_dim, kernel_size=(1, 1), bias=True)\n\n        self.receptive_field = receptive_field\n\n    def forward(self, input):\n        # (batch_size, num_features, num_nodes, seq_len)\n        # feed forward\n        input = nn.functional.pad(input, (1, 0, 0, 0))\n\n        input = input[:, :2, :, :]\n        in_len = input.size(3)\n        if in_len < self.receptive_field:\n            x = nn.functional.pad(input, (self.receptive_field - in_len, 0, 0, 0))\n        else:\n            x = input\n        x = self.start_conv(x)\n        skip = 0\n\n        # calculate the current adaptive adj matrix\n        new_supports = None\n        if self.gcn_bool and self.addaptadj and self.supports is not None:\n            adp = F.softmax(F.relu(torch.mm(self.nodevec1, self.nodevec2)), dim=1)\n            new_supports = self.supports + [adp]\n\n        # WaveNet layers\n        for i in range(self.blocks * self.layers):\n            residual = x\n            # dilated convolution\n            filter = self.filter_convs[i](residual)\n            filter = torch.tanh(filter)\n            gate = self.gate_convs[i](residual)\n            gate = torch.sigmoid(gate)\n            x = filter * gate\n\n            # parametrized skip connection\n            s = x\n            s = self.skip_convs[i](s)\n            try:\n                skip = skip[:, :, :, -s.size(3) :]\n            except:  # noqa: E722\n                skip = 0\n            skip = s + skip\n\n            if self.gcn_bool and self.supports is not None:\n                if self.addaptadj:\n                    x = self.gconv[i](x, new_supports)\n                else:\n                    x = self.gconv[i](x, self.supports)\n            else:\n                x = self.residual_convs[i](x)\n\n            x = x + residual[:, :, :, -x.size(3) :]\n\n            x = self.bn[i](x)\n\n        x = F.relu(skip)\n        x = F.relu(self.end_conv_1(x))\n        x = self.end_conv_2(x)\n        return x\n\n\n# ==================== Main LSTTN Model ====================\n\nclass LSTTN(AbstractTrafficStateModel):\n    """\n    LSTTN: Long Short-Term Transformer Network\n\n    Paper: "LSTTN: Long Short-Term Transformer Network for Spatiotemporal Traffic Forecasting"\n    """\n\n    def __init__(self, config, data_feature):\n        # Extract data features\n        self.adj_mx = data_feature.get(\'adj_mx\')\n        self.num_nodes = data_feature.get(\'num_nodes\', 1)\n        self.feature_dim = data_feature.get(\'feature_dim\', 2)\n\n        super().__init__(config, data_feature)\n\n        # Basic parameters\n        self.input_window = config.get(\'input_window\', 12)\n        self.output_window = config.get(\'output_window\', 12)\n        self.output_dim = data_feature.get(\'output_dim\', 1)\n        self.device = config.get(\'device\', torch.device(\'cpu\'))\n        self._logger = getLogger()\n        self._scaler = data_feature.get(\'scaler\')\n\n        # LSTTN-specific parameters\n        self.short_seq_len = config.get(\'short_seq_len\', 12)\n        self.long_seq_len = config.get(\'long_seq_len\', 4032)  # 14 days * 24 hours * 12 (5-min intervals)\n        self.use_long_term = config.get(\'use_long_term\', False)  # Enable when long history is available\n\n        # Transformer parameters\n        self.transformer_patch_size = config.get(\'transformer_patch_size\', 12)\n        self.transformer_in_channel = config.get(\'transformer_in_channel\', 1)\n        self.transformer_out_channel = config.get(\'transformer_out_channel\', 64)\n        self.transformer_dropout = config.get(\'transformer_dropout\', 0.1)\n        self.transformer_num_layers = config.get(\'transformer_num_layers\', 4)\n\n        # Model component parameters\n        self.long_trend_hidden_dim = config.get(\'long_trend_hidden_dim\', 128)\n        self.seasonality_hidden_dim = config.get(\'seasonality_hidden_dim\', 64)\n        self.mlp_hidden_dim = config.get(\'mlp_hidden_dim\', 128)\n        self.dropout = config.get(\'dropout\', 0.3)\n\n        # GraphWaveNet parameters\n        self.gwnet_residual_channels = config.get(\'gwnet_residual_channels\', 32)\n        self.gwnet_dilation_channels = config.get(\'gwnet_dilation_channels\', 32)\n        self.gwnet_skip_channels = config.get(\'gwnet_skip_channels\', 256)\n        self.gwnet_end_channels = config.get(\'gwnet_end_channels\', 512)\n        self.gwnet_kernel_size = config.get(\'gwnet_kernel_size\', 2)\n        self.gwnet_blocks = config.get(\'gwnet_blocks\', 4)\n        self.gwnet_layers = config.get(\'gwnet_layers\', 2)\n\n        # Load or initialize transformer\n        self.transformer = Transformer(\n            patch_size=self.transformer_patch_size,\n            in_channel=self.transformer_in_channel,\n            out_channel=self.transformer_out_channel,\n            dropout=self.transformer_dropout,\n            mask_size=int(self.long_seq_len / self.transformer_patch_size),\n            mask_ratio=0.0,  # No masking for inference\n            num_encoder_layers=self.transformer_num_layers,\n            mode="inference"\n        )\n\n        # Load pretrained transformer if available\n        self.pretrained_transformer_path = config.get(\'pretrained_transformer_path\', None)\n        if self.pretrained_transformer_path is not None:\n            self._load_pretrained_transformer()\n\n        # Prepare adjacency matrices for GraphWaveNet\n        self.supports = self._prepare_supports()\n\n        # Initialize model components\n        if self.use_long_term:\n            self.long_term_trend_extractor = StackedDilatedConv(\n                self.transformer_out_channel, self.long_trend_hidden_dim\n            )\n            self.weekly_seasonality_extractor = DynamicGraphConv(\n                self.num_nodes, self.transformer_out_channel, self.seasonality_hidden_dim, self.dropout\n            )\n            self.daily_seasonality_extractor = DynamicGraphConv(\n                self.num_nodes, self.transformer_out_channel, self.seasonality_hidden_dim, self.dropout\n            )\n            self.trend_seasonality_mlp = nn.Sequential(\n                nn.Linear(self.long_trend_hidden_dim + self.seasonality_hidden_dim * 2, self.mlp_hidden_dim),\n                nn.ReLU(),\n                nn.Linear(self.mlp_hidden_dim, self.mlp_hidden_dim),\n            )\n            fusion_input_dim = self.mlp_hidden_dim + self.gwnet_end_channels\n        else:\n            # Without long-term component, only use short-term\n            fusion_input_dim = self.gwnet_end_channels\n\n        # Short-term GraphWaveNet\n        self.short_term_trend_extractor = GraphWaveNet(\n            num_nodes=self.num_nodes,\n            supports=self.supports,\n            dropout=self.dropout,\n            gcn_bool=True,\n            addaptadj=True,\n            aptinit=None,\n            in_dim=min(self.feature_dim, 2),  # GraphWaveNet uses first 2 features\n            out_dim=self.gwnet_end_channels,\n            residual_channels=self.gwnet_residual_channels,\n            dilation_channels=self.gwnet_dilation_channels,\n            skip_channels=self.gwnet_skip_channels,\n            end_channels=self.gwnet_end_channels,\n            kernel_size=self.gwnet_kernel_size,\n            blocks=self.gwnet_blocks,\n            layers=self.gwnet_layers,\n        )\n\n        # Final prediction MLP\n        self.mlp = nn.Sequential(\n            nn.Linear(fusion_input_dim, self.mlp_hidden_dim),\n            nn.ReLU(),\n            nn.Linear(self.mlp_hidden_dim, self.output_window * self.output_dim),\n        )\n\n        self._logger.info(f\'LSTTN initialized with short_seq_len={self.short_seq_len}, \'\n                         f\'long_seq_len={self.long_seq_len}, use_long_term={self.use_long_term}\')\n\n    def _prepare_supports(self):\n        """Prepare support matrices (adjacency) for GraphWaveNet"""\n        if self.adj_mx is None:\n            return None\n\n        # Convert adjacency matrix to transition matrices\n        adj_mx = self.adj_mx.copy()\n        # Forward transition matrix\n        rowsum = np.array(adj_mx.sum(1)).flatten()\n        d_inv = np.power(rowsum, -1).flatten()\n        d_inv[np.isinf(d_inv)] = 0.\n        d_mat = np.diag(d_inv)\n        adj_forward = d_mat.dot(adj_mx).astype(np.float32)\n\n        # Backward transition matrix\n        adj_backward = d_mat.dot(adj_mx.T).astype(np.float32)\n\n        supports = [torch.tensor(adj_forward).to(self.device), torch.tensor(adj_backward).to(self.device)]\n        return supports\n\n    def _load_pretrained_transformer(self):\n        """Load pretrained transformer weights"""\n        try:\n            import os\n            if os.path.exists(self.pretrained_transformer_path):\n                state_dict = torch.load(self.pretrained_transformer_path, map_location=self.device)\n                if \'model_state_dict\' in state_dict:\n                    self.transformer.load_state_dict(state_dict[\'model_state_dict\'])\n                else:\n                    self.transformer.load_state_dict(state_dict)\n                # Freeze transformer parameters\n                for param in self.transformer.parameters():\n                    param.requires_grad = False\n                self._logger.info(f\'Loaded pretrained transformer from {self.pretrained_transformer_path}\')\n            else:\n                self._logger.warning(f\'Pretrained transformer path not found: {self.pretrained_transformer_path}\')\n        except Exception as e:\n            self._logger.warning(f\'Failed to load pretrained transformer: {e}\')\n\n    def forward(self, batch):\n        """\n        Args:\n            batch: dict with key \'X\' of shape (batch_size, input_window, num_nodes, feature_dim)\n\n        Returns:\n            predictions: (batch_size, output_window, num_nodes, output_dim)\n        """\n        # Extract input\n        x = batch[\'X\']  # (batch_size, input_window, num_nodes, feature_dim)\n        batch_size, input_len, num_nodes, feature_dim = x.size()\n\n        # Extract short sequence (last short_seq_len timesteps)\n        if input_len >= self.short_seq_len:\n            short_x = x[:, -self.short_seq_len:, :, :]\n        else:\n            # Pad if input is shorter than short_seq_len\n            pad_len = self.short_seq_len - input_len\n            short_x = F.pad(x, (0, 0, 0, 0, pad_len, 0))\n\n        # Process short-term with GraphWaveNet\n        # GraphWaveNet expects (batch_size, num_features, num_nodes, seq_len)\n        short_x_gwnet = short_x.transpose(1, 3)  # (batch_size, feature_dim, num_nodes, short_seq_len)\n        short_term_hidden = self.short_term_trend_extractor(short_x_gwnet)\n        # Output: (batch_size, gwnet_end_channels, num_nodes, 1)\n        short_term_hidden = short_term_hidden.squeeze(-1).transpose(1, 2)\n        # Now: (batch_size, num_nodes, gwnet_end_channels)\n\n        # Process long-term if enabled\n        if self.use_long_term and input_len >= self.long_seq_len:\n            # Extract long sequence\n            long_x = x[:, :self.long_seq_len, :, :]\n            long_x = long_x[..., [0]]  # Use only first feature (speed/flow)\n            long_x = torch.permute(long_x, (0, 2, 3, 1))  # (batch_size, num_nodes, 1, long_seq_len)\n\n            # Transformer encoding\n            long_repr = self.transformer(long_x)\n            # Output: (batch_size, num_nodes, num_subseq, transformer_out_channel)\n            batch_size, num_nodes, num_subseq, _ = long_repr.size()\n\n            # Extract long-term trend\n            long_trend_hidden = self.long_term_trend_extractor(\n                torch.reshape(long_repr, (-1, num_subseq, self.transformer_out_channel)).transpose(1, 2)\n            )[:, :, -1]\n            long_trend_hidden = torch.reshape(long_trend_hidden, (batch_size, num_nodes, -1))\n\n            # Extract seasonality features\n            # Weekly: 7 days * 24 hours = 168 hours (1 hour = 12 5-min intervals)\n            # Daily: 24 hours\n            last_week_idx = -7 * 24 * 12 // self.transformer_patch_size - 1\n            last_day_idx = -24 * 12 // self.transformer_patch_size - 1\n\n            if num_subseq > abs(last_week_idx):\n                last_week_repr = long_repr[:, :, last_week_idx, :]\n            else:\n                last_week_repr = long_repr[:, :, 0, :]\n\n            if num_subseq > abs(last_day_idx):\n                last_day_repr = long_repr[:, :, last_day_idx, :]\n            else:\n                last_day_repr = long_repr[:, :, 0, :]\n\n            weekly_hidden = self.weekly_seasonality_extractor(last_week_repr, self.supports)\n            daily_hidden = self.daily_seasonality_extractor(last_day_repr, self.supports)\n\n            # Combine trend and seasonality\n            trend_seasonality_hidden = torch.cat((long_trend_hidden, weekly_hidden, daily_hidden), dim=-1)\n            trend_seasonality_hidden = self.trend_seasonality_mlp(trend_seasonality_hidden)\n\n            # Fuse long-term and short-term\n            hidden = torch.cat((short_term_hidden, trend_seasonality_hidden), dim=-1)\n        else:\n            # Only use short-term\n            hidden = short_term_hidden\n\n        # Final prediction\n        # hidden: (batch_size, num_nodes, fusion_input_dim)\n        output = self.mlp(hidden)\n        # output: (batch_size, num_nodes, output_window * output_dim)\n        output = output.view(batch_size, num_nodes, self.output_window, self.output_dim)\n        output = output.transpose(1, 2)\n        # Final shape: (batch_size, output_window, num_nodes, output_dim)\n\n        return output\n\n    def calculate_loss(self, batch):\n        """\n        Calculate masked MAE loss\n\n        Args:\n            batch: dict with keys \'X\' and \'y\'\n\n        Returns:\n            loss: scalar tensor\n        """\n        y_true = batch[\'y\']\n        y_predicted = self.predict(batch)\n        y_true = self._scaler.inverse_transform(y_true[..., :self.output_dim])\n        y_predicted = self._scaler.inverse_transform(y_predicted[..., :self.output_dim])\n        return loss.masked_mae_torch(y_predicted, y_true, 0)\n\n    def predict(self, batch):\n        """\n        Make predictions\n\n        Args:\n            batch: dict with key \'X\'\n\n        Returns:\n            predictions: (batch_size, output_window, num_nodes, output_dim)\n        """\n        return self.forward(batch)\n'}
