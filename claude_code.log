2025-12-01 10:09:23 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/private/shk/agentCity/tests/benchmark_stssdl_training.py', 'content': '"""\nST-SSDL Minimal Training Benchmark\nTests a complete training loop with synthetic data to verify LibCity integration\n"""\n\nimport sys\nimport os\nimport torch\nimport numpy as np\nfrom datetime import datetime\n\n# Add Bigscity-LibCity to path\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \'..\', \'Bigscity-LibCity\'))\n\ntry:\n    from libcity.model.traffic_speed_prediction import STSSDL\nexcept ImportError as e:\n    print(f"❌ Failed to import STSSDL: {e}")\n    sys.exit(1)\n\n\ndef generate_synthetic_data(num_samples, num_nodes, input_window, output_window):\n    """Generate synthetic traffic data"""\n    # Create synthetic traffic patterns with temporal and spatial correlation\n    np.random.seed(42)\n    torch.manual_seed(42)\n\n    # Base traffic pattern (daily cycle)\n    t = np.linspace(0, 2 * np.pi * num_samples / 288, num_samples)  # 288 = daily cycles\n    base_pattern = 50 + 30 * np.sin(t)  # Speed between 20-80\n\n    # Add noise and spatial variation\n    X_data = []\n    y_data = []\n\n    for i in range(num_samples - input_window - output_window):\n        # Input sequence\n        x_speed = base_pattern[i:i+input_window, np.newaxis, np.newaxis] + \\\n                  np.random.randn(input_window, num_nodes, 1) * 5\n\n        # Time of day (normalized 0-1)\n        x_tod = np.tile(np.linspace(0, 1, input_window)[:, np.newaxis, np.newaxis],\n                       (1, num_nodes, 1))\n\n        # Historical comparison (use same as speed for simplicity)\n        x_his = x_speed.copy()\n\n        # Combine features\n        x = np.concatenate([x_speed, x_tod, x_his], axis=-1)  # (T, N, 3)\n\n        # Output (future speeds)\n        y = base_pattern[i+input_window:i+input_window+output_window, np.newaxis, np.newaxis] + \\\n            np.random.randn(output_window, num_nodes, 1) * 5\n\n        X_data.append(x)\n        y_data.append(y)\n\n    return np.array(X_data), np.array(y_data)\n\n\ndef create_adjacency_matrix(num_nodes):\n    """Create a simple adjacency matrix (ring topology)"""\n    adj = np.eye(num_nodes, dtype=np.float32)\n    for i in range(num_nodes):\n        adj[i, (i+1) % num_nodes] = 1\n        adj[i, (i-1) % num_nodes] = 1\n    return adj\n\n\ndef run_training_benchmark(num_epochs=5, num_nodes=20, batch_size=8):\n    """Run a minimal training benchmark"""\n\n    print("="*80)\n    print("ST-SSDL Training Benchmark")\n    print(f"Started: {datetime.now()}")\n    print("="*80)\n\n    # Configuration\n    device = torch.device(\'cuda\' if torch.cuda.is_available() else \'cpu\')\n    input_window = 12\n    output_window = 12\n\n    config = {\n        \'device\': device,\n        \'input_window\': input_window,\n        \'output_window\': output_window,\n        \'rnn_units\': 32,  # Smaller for faster training\n        \'rnn_layers\': 1,\n        \'cheb_k\': 2,\n        \'prototype_num\': 10,  # Reduced for speed\n        \'prototype_dim\': 32,\n        \'use_STE\': True,\n        \'node_embedding_dim\': 10,\n        \'tod_embed_dim\': 8,\n        \'adaptive_embedding_dim\': 16,\n        \'input_embedding_dim\': 32,\n        \'lamb_c\': 0.1,\n        \'lamb_d\': 1.0,\n        \'use_curriculum_learning\': True,\n        \'cl_decay_steps\': 1000,\n        \'TDAY\': 288,\n    }\n\n    print(f"\\n[Config]")\n    print(f"  Device: {device}")\n    print(f"  Nodes: {num_nodes}")\n    print(f"  Epochs: {num_epochs}")\n    print(f"  Batch size: {batch_size}")\n    print(f"  RNN units: {config[\'rnn_units\']}")\n    print(f"  Prototypes: {config[\'prototype_num\']}")\n\n    # Create adjacency matrix\n    print(f"\\n[1/6] Creating adjacency matrix...")\n    adj_mx = create_adjacency_matrix(num_nodes)\n    print(f"  ✓ Adjacency matrix: {adj_mx.shape}")\n\n    # Generate synthetic data\n    print(f"\\n[2/6] Generating synthetic data...")\n    num_samples = 500  # Small dataset for quick test\n    X_data, y_data = generate_synthetic_data(num_samples, num_nodes, input_window, output_window)\n    print(f"  ✓ X shape: {X_data.shape}")\n    print(f"  ✓ y shape: {y_data.shape}")\n\n    # Split into train/val\n    split_idx = int(0.8 * len(X_data))\n    X_train, X_val = X_data[:split_idx], X_data[split_idx:]\n    y_train, y_val = y_data[:split_idx], y_data[split_idx:]\n    print(f"  ✓ Train samples: {len(X_train)}, Val samples: {len(X_val)}")\n\n    # Create data feature dict\n    data_feature = {\n        \'num_nodes\': num_nodes,\n        \'feature_dim\': 3,\n        \'output_dim\': 1,\n        \'adj_mx\': adj_mx,\n        \'scaler\': None,  # No scaling for synthetic data\n    }\n\n    # Initialize model\n    print(f"\\n[3/6] Initializing model...")\n    try:\n        model = STSSDL(config, data_feature)\n        model = model.to(device)\n        param_count = sum(p.numel() for p in model.parameters())\n        print(f"  ✓ Model initialized: {param_count:,} parameters")\n    except Exception as e:\n        print(f"  ❌ Model initialization failed: {e}")\n        import traceback\n        traceback.print_exc()\n        return False\n\n    # Setup optimizer\n    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n    print(f"  ✓ Optimizer: Adam(lr=0.001)")\n\n    # Training loop\n    print(f"\\n[4/6] Training for {num_epochs} epochs...")\n    train_losses = []\n    val_losses = []\n\n    for epoch in range(num_epochs):\n        model.train()\n        epoch_losses = []\n\n        # Mini-batch training\n        num_batches = len(X_train) // batch_size\n        for batch_idx in range(num_batches):\n            start_idx = batch_idx * batch_size\n            end_idx = start_idx + batch_size\n\n            # Create batch\n            X_batch = torch.FloatTensor(X_train[start_idx:end_idx]).to(device)\n            y_batch = torch.FloatTensor(y_train[start_idx:end_idx]).to(device)\n\n            batch = {\'X\': X_batch, \'y\': y_batch}\n\n            # Forward pass\n            optimizer.zero_grad()\n            try:\n                loss = model.calculate_loss(batch)\n            except Exception as e:\n                print(f"\\n  ❌ Forward pass failed at epoch {epoch}, batch {batch_idx}: {e}")\n                import traceback\n                traceback.print_exc()\n                return False\n\n            # Backward pass\n            try:\n                loss.backward()\n                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)\n                optimizer.step()\n            except Exception as e:\n                print(f"\\n  ❌ Backward pass failed at epoch {epoch}, batch {batch_idx}: {e}")\n                import traceback\n                traceback.print_exc()\n                return False\n\n            epoch_losses.append(loss.item())\n\n        avg_train_loss = np.mean(epoch_losses)\n        train_losses.append(avg_train_loss)\n\n        # Validation\n        model.eval()\n        val_batch_losses = []\n        with torch.no_grad():\n            num_val_batches = len(X_val) // batch_size\n            for batch_idx in range(num_val_batches):\n                start_idx = batch_idx * batch_size\n                end_idx = start_idx + batch_size\n\n                X_batch = torch.FloatTensor(X_val[start_idx:end_idx]).to(device)\n                y_batch = torch.FloatTensor(y_val[start_idx:end_idx]).to(device)\n\n                batch = {\'X\': X_batch, \'y\': y_batch}\n\n                try:\n                    loss = model.calculate_loss(batch)\n                    val_batch_losses.append(loss.item())\n                except Exception as e:\n                    print(f"\\n  ⚠ Validation failed at epoch {epoch}: {e}")\n\n        avg_val_loss = np.mean(val_batch_losses) if val_batch_losses else float(\'nan\')\n        val_losses.append(avg_val_loss)\n\n        print(f"  Epoch {epoch+1}/{num_epochs} - Train Loss: {avg_train_loss:.4f}, Val Loss: {avg_val_loss:.4f}")\n\n    # Test prediction\n    print(f"\\n[5/6] Testing prediction...")\n    model.eval()\n    with torch.no_grad():\n        test_batch = {\n            \'X\': torch.FloatTensor(X_val[:batch_size]).to(device),\n            \'y\': torch.FloatTensor(y_val[:batch_size]).to(device)\n        }\n\n        try:\n            predictions = model.predict(test_batch)\n            print(f"  ✓ Prediction shape: {predictions.shape}")\n            print(f"  ✓ Prediction range: [{predictions.min():.2f}, {predictions.max():.2f}]")\n        except Exception as e:\n            print(f"  ❌ Prediction failed: {e}")\n            import traceback\n            traceback.print_exc()\n            return False\n\n    # Summary\n    print(f"\\n[6/6] Training Summary")\n    print(f"  Initial train loss: {train_losses[0]:.4f}")\n    print(f"  Final train loss: {train_losses[-1]:.4f}")\n    print(f"  Loss reduction: {(train_losses[0] - train_losses[-1]) / train_losses[0] * 100:.1f}%")\n\n    if not np.isnan(val_losses[-1]):\n        print(f"  Final val loss: {val_losses[-1]:.4f}")\n\n    # Check convergence\n    if train_losses[-1] < train_losses[0]:\n        print(f"\\n  ✓ Training converged (loss decreased)")\n        converged = True\n    else:\n        print(f"\\n  ⚠ Training did not converge (loss increased)")\n        converged = False\n\n    print("="*80)\n    print(f"Completed: {datetime.now()}")\n    print("="*80)\n\n    return converged\n\n\nif __name__ == "__main__":\n    print("\\n" + "="*80)\n    print("ST-SSDL MINIMAL TRAINING BENCHMARK")\n    print("="*80 + "\\n")\n\n    success = run_training_benchmark(num_epochs=5, num_nodes=20, batch_size=8)\n\n    if success:\n        print("\\n✅ BENCHMARK PASSED: Training completed successfully")\n        sys.exit(0)\n    else:\n        print("\\n❌ BENCHMARK FAILED: Training encountered errors")\n        sys.exit(1)\n'}
