2025-11-26 08:32:57 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/private/shk/codex/tests/test_gridded_tnp_verification.py', 'content': '"""\nComprehensive Verification Test for GriddedTNP Model Integration in LibCity\n\nThis script performs end-to-end verification of the GriddedTNP model including:\n1. Model instantiation and parameter validation\n2. Forward pass with synthetic data\n3. Loss calculation\n4. Training simulation\n5. Metrics evaluation (MAE, RMSE, MAPE)\n"""\n\nimport sys\nimport os\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \'..\', \'Bigscity-LibCity\'))\n\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport numpy as np\nimport json\nfrom datetime import datetime\nimport time\n\n# Test configuration\nTEST_CONFIG = {\n    \'batch_size\': 8,\n    \'input_window\': 12,\n    \'output_window\': 12,\n    \'num_nodes\': 207,  # METR-LA size\n    \'feature_dim\': 2,\n    \'output_dim\': 1,\n    \'num_train_batches\': 10,\n    \'num_test_batches\': 5,\n    \'device\': \'cuda\' if torch.cuda.is_available() else \'cpu\'\n}\n\nclass MockScaler:\n    """Mock scaler for testing without full LibCity dependencies"""\n    def inverse_transform(self, x):\n        return x\n\ndef print_section(title):\n    """Print formatted section header"""\n    print("\\n" + "=" * 80)\n    print(f" {title}")\n    print("=" * 80)\n\ndef test_1_file_existence():\n    """Test 1: Verify all required files exist"""\n    print_section("TEST 1: File Existence Check")\n\n    files_to_check = [\n        ("Model File", "Bigscity-LibCity/libcity/model/traffic_speed_prediction/GriddedTNP.py"),\n        ("Config File", "Bigscity-LibCity/libcity/config/model/traffic_state_pred/GriddedTNP.json"),\n        ("Init File", "Bigscity-LibCity/libcity/model/traffic_speed_prediction/__init__.py")\n    ]\n\n    all_exist = True\n    for name, path in files_to_check:\n        full_path = os.path.join(os.path.dirname(__file__), \'..\', path)\n        exists = os.path.exists(full_path)\n        status = "✓" if exists else "✗"\n        print(f"{status} {name}: {path}")\n        if not exists:\n            all_exist = False\n\n    return all_exist\n\ndef test_2_model_import():\n    """Test 2: Import GriddedTNP model"""\n    print_section("TEST 2: Model Import")\n\n    try:\n        from libcity.model.traffic_speed_prediction.GriddedTNP import GriddedTNP, GridEncoder, GridDecoder\n        print("✓ Successfully imported GriddedTNP")\n        print("✓ Successfully imported GridEncoder")\n        print("✓ Successfully imported GridDecoder")\n        return True, (GriddedTNP, GridEncoder, GridDecoder)\n    except Exception as e:\n        print(f"✗ Import failed: {e}")\n        return False, None\n\ndef test_3_model_instantiation(classes):\n    """Test 3: Instantiate model with various configurations"""\n    print_section("TEST 3: Model Instantiation")\n\n    GriddedTNP, GridEncoder, GridDecoder = classes\n\n    configs = [\n        {"name": "Small", "hidden_dim": 64, "num_heads": 2, "num_layers": 2, "grid_size": 16},\n        {"name": "Medium", "hidden_dim": 128, "num_heads": 4, "num_layers": 3, "grid_size": 32},\n        {"name": "Large", "hidden_dim": 256, "num_heads": 8, "num_layers": 4, "grid_size": 64}\n    ]\n\n    models = []\n    for cfg in configs:\n        try:\n            config = {\n                \'input_window\': TEST_CONFIG[\'input_window\'],\n                \'output_window\': TEST_CONFIG[\'output_window\'],\n                \'hidden_dim\': cfg[\'hidden_dim\'],\n                \'num_heads\': cfg[\'num_heads\'],\n                \'num_layers\': cfg[\'num_layers\'],\n                \'grid_size\': cfg[\'grid_size\'],\n                \'dropout\': 0.1,\n                \'device\': torch.device(TEST_CONFIG[\'device\'])\n            }\n\n            data_feature = {\n                \'num_nodes\': TEST_CONFIG[\'num_nodes\'],\n                \'feature_dim\': TEST_CONFIG[\'feature_dim\'],\n                \'output_dim\': TEST_CONFIG[\'output_dim\'],\n                \'scaler\': MockScaler()\n            }\n\n            model = GriddedTNP(config, data_feature)\n            num_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n\n            print(f"✓ {cfg[\'name\']} model: {num_params:,} parameters")\n            print(f"  └─ Config: hidden={cfg[\'hidden_dim\']}, heads={cfg[\'num_heads\']}, "\n                  f"layers={cfg[\'num_layers\']}, grid={cfg[\'grid_size\']}")\n\n            models.append(model)\n        except Exception as e:\n            print(f"✗ {cfg[\'name\']} model failed: {e}")\n            return False, None\n\n    return True, models[1]  # Return medium model for further testing\n\ndef test_4_forward_pass(model):\n    """Test 4: Forward pass with synthetic data"""\n    print_section("TEST 4: Forward Pass")\n\n    try:\n        model.eval()\n        device = torch.device(TEST_CONFIG[\'device\'])\n        model = model.to(device)\n\n        # Create synthetic batch\n        batch = {\n            \'X\': torch.randn(\n                TEST_CONFIG[\'batch_size\'],\n                TEST_CONFIG[\'input_window\'],\n                TEST_CONFIG[\'num_nodes\'],\n                TEST_CONFIG[\'feature_dim\']\n            ).to(device),\n            \'y\': torch.randn(\n                TEST_CONFIG[\'batch_size\'],\n                TEST_CONFIG[\'output_window\'],\n                TEST_CONFIG[\'num_nodes\'],\n                TEST_CONFIG[\'output_dim\']\n            ).to(device)\n        }\n\n        # Forward pass\n        start_time = time.time()\n        with torch.no_grad():\n            output = model(batch)\n        forward_time = time.time() - start_time\n\n        # Validate output shape\n        expected_shape = (\n            TEST_CONFIG[\'batch_size\'],\n            TEST_CONFIG[\'output_window\'],\n            TEST_CONFIG[\'num_nodes\'],\n            TEST_CONFIG[\'output_dim\']\n        )\n\n        if output.shape == expected_shape:\n            print(f"✓ Output shape correct: {output.shape}")\n        else:\n            print(f"✗ Output shape mismatch: expected {expected_shape}, got {output.shape}")\n            return False\n\n        print(f"✓ Forward pass completed in {forward_time:.4f}s")\n        print(f"✓ Output statistics: mean={output.mean():.4f}, std={output.std():.4f}")\n\n        return True\n    except Exception as e:\n        print(f"✗ Forward pass failed: {e}")\n        import traceback\n        traceback.print_exc()\n        return False\n\ndef test_5_loss_calculation(model):\n    """Test 5: Loss calculation"""\n    print_section("TEST 5: Loss Calculation")\n\n    try:\n        device = torch.device(TEST_CONFIG[\'device\'])\n        model = model.to(device)\n\n        batch = {\n            \'X\': torch.randn(\n                TEST_CONFIG[\'batch_size\'],\n                TEST_CONFIG[\'input_window\'],\n                TEST_CONFIG[\'num_nodes\'],\n                TEST_CONFIG[\'feature_dim\']\n            ).to(device),\n            \'y\': torch.randn(\n                TEST_CONFIG[\'batch_size\'],\n                TEST_CONFIG[\'output_window\'],\n                TEST_CONFIG[\'num_nodes\'],\n                TEST_CONFIG[\'output_dim\']\n            ).to(device)\n        }\n\n        loss = model.calculate_loss(batch)\n\n        if torch.isnan(loss) or torch.isinf(loss):\n            print(f"✗ Loss is NaN or Inf: {loss.item()}")\n            return False\n\n        print(f"✓ Loss calculated: {loss.item():.6f}")\n        print(f"✓ Loss is finite and non-negative")\n\n        return True\n    except Exception as e:\n        print(f"✗ Loss calculation failed: {e}")\n        import traceback\n        traceback.print_exc()\n        return False\n\ndef test_6_training_simulation(model):\n    """Test 6: Training simulation with synthetic data"""\n    print_section("TEST 6: Training Simulation")\n\n    try:\n        device = torch.device(TEST_CONFIG[\'device\'])\n        model = model.to(device)\n        model.train()\n\n        optimizer = optim.Adam(model.parameters(), lr=0.001)\n\n        # Generate synthetic training data\n        train_losses = []\n\n        print(f"\\nTraining for {TEST_CONFIG[\'num_train_batches\']} batches...")\n        for i in range(TEST_CONFIG[\'num_train_batches\']):\n            batch = {\n                \'X\': torch.randn(\n                    TEST_CONFIG[\'batch_size\'],\n                    TEST_CONFIG[\'input_window\'],\n                    TEST_CONFIG[\'num_nodes\'],\n                    TEST_CONFIG[\'feature_dim\']\n                ).to(device),\n                \'y\': torch.randn(\n                    TEST_CONFIG[\'batch_size\'],\n                    TEST_CONFIG[\'output_window\'],\n                    TEST_CONFIG[\'num_nodes\'],\n                    TEST_CONFIG[\'output_dim\']\n                ).to(device)\n            }\n\n            optimizer.zero_grad()\n            loss = model.calculate_loss(batch)\n            loss.backward()\n            optimizer.step()\n\n            train_losses.append(loss.item())\n\n            if (i + 1) % 5 == 0:\n                print(f"  Batch {i+1}/{TEST_CONFIG[\'num_train_batches\']}: Loss = {loss.item():.6f}")\n\n        print(f"\\n✓ Training completed")\n        print(f"✓ Initial loss: {train_losses[0]:.6f}")\n        print(f"✓ Final loss: {train_losses[-1]:.6f}")\n\n        # Check if loss decreased (should decrease with synthetic data)\n        if train_losses[-1] < train_losses[0] * 1.5:  # Allow some variance\n            print(f"✓ Loss trend is reasonable")\n\n        return True, train_losses\n    except Exception as e:\n        print(f"✗ Training simulation failed: {e}")\n        import traceback\n        traceback.print_exc()\n        return False, None\n\ndef test_7_inference_metrics(model):\n    """Test 7: Inference and metrics calculation"""\n    print_section("TEST 7: Inference and Metrics")\n\n    try:\n        device = torch.device(TEST_CONFIG[\'device\'])\n        model = model.to(device)\n        model.eval()\n\n        # Generate test data\n        all_predictions = []\n        all_targets = []\n\n        print(f"\\nRunning inference on {TEST_CONFIG[\'num_test_batches\']} batches...")\n        with torch.no_grad():\n            for i in range(TEST_CONFIG[\'num_test_batches\']):\n                batch = {\n                    \'X\': torch.randn(\n                        TEST_CONFIG[\'batch_size\'],\n                        TEST_CONFIG[\'input_window\'],\n                        TEST_CONFIG[\'num_nodes\'],\n                        TEST_CONFIG[\'feature_dim\']\n                    ).to(device),\n                    \'y\': torch.randn(\n                        TEST_CONFIG[\'batch_size\'],\n                        TEST_CONFIG[\'output_window\'],\n                        TEST_CONFIG[\'num_nodes\'],\n                        TEST_CONFIG[\'output_dim\']\n                    ).to(device)\n                }\n\n                predictions = model.predict(batch)\n                all_predictions.append(predictions.cpu().numpy())\n                all_targets.append(batch[\'y\'].cpu().numpy())\n\n        # Concatenate all batches\n        predictions = np.concatenate(all_predictions, axis=0)\n        targets = np.concatenate(all_targets, axis=0)\n\n        # Calculate metrics\n        mae = np.mean(np.abs(predictions - targets))\n        rmse = np.sqrt(np.mean((predictions - targets) ** 2))\n\n        # MAPE (avoid division by zero)\n        mask = targets != 0\n        mape = np.mean(np.abs((predictions[mask] - targets[mask]) / targets[mask])) * 100 if mask.any() else 0\n\n        print(f"\\n✓ Metrics calculated on {predictions.shape[0]} samples:")\n        print(f"  ├─ MAE:  {mae:.6f}")\n        print(f"  ├─ RMSE: {rmse:.6f}")\n        print(f"  └─ MAPE: {mape:.2f}%")\n\n        return True, {\'mae\': mae, \'rmse\': rmse, \'mape\': mape}\n    except Exception as e:\n        print(f"✗ Metrics calculation failed: {e}")\n        import traceback\n        traceback.print_exc()\n        return False, None\n\ndef test_8_config_file_validation():\n    """Test 8: Validate configuration file"""\n    print_section("TEST 8: Configuration File Validation")\n\n    try:\n        config_path = os.path.join(\n            os.path.dirname(__file__),\n            \'..\',\n            \'Bigscity-LibCity/libcity/config/model/traffic_state_pred/GriddedTNP.json\'\n        )\n\n        with open(config_path, \'r\') as f:\n            config = json.load(f)\n\n        required_params = [\n            \'hidden_dim\', \'num_heads\', \'num_layers\', \'dropout\', \'grid_size\',\n            \'learning_rate\', \'max_epoch\'\n        ]\n\n        missing = []\n        for param in required_params:\n            if param not in config:\n                missing.append(param)\n\n        if missing:\n            print(f"✗ Missing required parameters: {missing}")\n            return False\n\n        print("✓ All required parameters present")\n        print(f"\\nConfiguration summary:")\n        print(f"  ├─ Architecture:")\n        print(f"  │  ├─ hidden_dim: {config[\'hidden_dim\']}")\n        print(f"  │  ├─ num_heads: {config[\'num_heads\']}")\n        print(f"  │  ├─ num_layers: {config[\'num_layers\']}")\n        print(f"  │  └─ grid_size: {config[\'grid_size\']}")\n        print(f"  └─ Training:")\n        print(f"     ├─ learning_rate: {config[\'learning_rate\']}")\n        print(f"     ├─ max_epoch: {config[\'max_epoch\']}")\n        print(f"     └─ patience: {config.get(\'patience\', \'N/A\')}")\n\n        return True\n    except Exception as e:\n        print(f"✗ Config validation failed: {e}")\n        return False\n\ndef save_verification_report(results, metrics):\n    """Save verification report to file"""\n    print_section("Saving Verification Report")\n\n    report = {\n        \'timestamp\': datetime.now().isoformat(),\n        \'test_config\': TEST_CONFIG,\n        \'test_results\': results,\n        \'metrics\': metrics,\n        \'status\': \'PASSED\' if all(results.values()) else \'FAILED\'\n    }\n\n    report_path = os.path.join(os.path.dirname(__file__), \'..\', \'data/runs/gridded_tnp_verification.json\')\n    os.makedirs(os.path.dirname(report_path), exist_ok=True)\n\n    with open(report_path, \'w\') as f:\n        json.dump(report, f, indent=2)\n\n    print(f"✓ Report saved to: {report_path}")\n\n    return report_path\n\ndef main():\n    """Main test execution"""\n    print("\\n" + "=" * 80)\n    print(" GriddedTNP Model - Comprehensive Verification Test Suite")\n    print(" " + datetime.now().strftime("%Y-%m-%d %H:%M:%S"))\n    print("=" * 80)\n\n    print(f"\\nTest Environment:")\n    print(f"  ├─ PyTorch version: {torch.__version__}")\n    print(f"  ├─ CUDA available: {torch.cuda.is_available()}")\n    print(f"  └─ Device: {TEST_CONFIG[\'device\']}")\n\n    results = {}\n    metrics = {}\n\n    # Run all tests\n    results[\'file_existence\'] = test_1_file_existence()\n\n    if not results[\'file_existence\']:\n        print("\\n⚠ Cannot proceed without required files")\n        return\n\n    success, classes = test_2_model_import()\n    results[\'model_import\'] = success\n\n    if not success:\n        print("\\n⚠ Cannot proceed without model import")\n        return\n\n    success, model = test_3_model_instantiation(classes)\n    results[\'model_instantiation\'] = success\n\n    if not success:\n        print("\\n⚠ Cannot proceed without model instantiation")\n        return\n\n    results[\'forward_pass\'] = test_4_forward_pass(model)\n    results[\'loss_calculation\'] = test_5_loss_calculation(model)\n\n    success, train_losses = test_6_training_simulation(model)\n    results[\'training_simulation\'] = success\n\n    success, test_metrics = test_7_inference_metrics(model)\n    results[\'inference_metrics\'] = success\n    if test_metrics:\n        metrics.update(test_metrics)\n\n    results[\'config_validation\'] = test_8_config_file_validation()\n\n    # Print summary\n    print_section("Test Summary")\n\n    passed = sum(1 for v in results.values() if v)\n    total = len(results)\n\n    print(f"\\nResults: {passed}/{total} tests passed")\n    print("\\nDetailed Results:")\n    for test_name, passed in results.items():\n        status = "✓ PASSED" if passed else "✗ FAILED"\n        print(f"  {status}: {test_name}")\n\n    if metrics:\n        print("\\nTest Metrics (synthetic data):")\n        print(f"  ├─ MAE:  {metrics.get(\'mae\', \'N/A\'):.6f}")\n        print(f"  ├─ RMSE: {metrics.get(\'rmse\', \'N/A\'):.6f}")\n        print(f"  └─ MAPE: {metrics.get(\'mape\', \'N/A\'):.2f}%")\n\n    # Save report\n    report_path = save_verification_report(results, metrics)\n\n    # Final verdict\n    print("\\n" + "=" * 80)\n    if all(results.values()):\n        print(" ✓ ALL TESTS PASSED - Model is ready for deployment")\n    else:\n        print(" ✗ SOME TESTS FAILED - Review errors above")\n    print("=" * 80)\n\n    return all(results.values())\n\nif __name__ == "__main__":\n    success = main()\n    sys.exit(0 if success else 1)\n'}
