n        adj_mx = np.random.rand(num_nodes, num_nodes)\n        adj_mx = (adj_mx + adj_mx.T) / 2\n\n        return {\n            \'num_nodes\': num_nodes,\n            \'feature_dim\': 1,\n            \'output_dim\': 1,\n            \'adj_mx\': adj_mx,\n            \'scaler\': None,\n        }\n\n    def test_model_initialization(self, config, data_feature_small):\n        """Test if model can be initialized without errors"""\n        model = STSSDL(config, data_feature_small)\n        assert model is not None\n        assert model.num_nodes == 10\n        print("✓ Model initialization test passed")\n\n    def test_model_parameters(self, config, data_feature_small):\n        """Test if model has trainable parameters"""\n        model = STSSDL(config, data_feature_small)\n        params = list(model.parameters())\n        assert len(params) > 0\n\n        # Check if parameters are trainable\n        trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n        assert trainable_params > 0\n        print(f"✓ Model has {trainable_params:,} trainable parameters")\n\n    def test_forward_pass_small(self, config, data_feature_small):\n        """Test forward pass with small batch"""\n        model = STSSDL(config, data_feature_small)\n        model.eval()\n\n        batch_size = 2\n        num_nodes = 10\n        input_window = 12\n\n        # Create dummy batch with proper shape: (batch, time, nodes, features)\n        # Feature dim 3: [speed, time_of_day, historical_speed]\n        batch = {\n            \'X\': torch.randn(batch_size, input_window, num_nodes, 3),\n            \'y\': torch.randn(batch_size, config[\'output_window\'], num_nodes, 1)\n        }\n\n        with torch.no_grad():\n            output = model.predict(batch)\n\n        assert output.shape == (batch_size, config[\'output_window\'], num_nodes, 1)\n        assert not torch.isnan(output).any()\n        print("✓ Forward pass test (small) passed")\n\n    def test_forward_pass_medium(self, config, data_feature_medium):\n        """Test forward pass with medium-sized network"""\n        model = STSSDL(config, data_feature_medium)\n        model.eval()\n\n        batch_size = 4\n        num_nodes = 50\n        input_window = 12\n\n        batch = {\n            \'X\': torch.randn(batch_size, input_window, num_nodes, 3),\n            \'y\': torch.randn(batch_size, config[\'output_window\'], num_nodes, 1)\n        }\n\n        with torch.no_grad():\n            output = model.predict(batch)\n\n        assert output.shape == (batch_size, config[\'output_window\'], num_nodes, 1)\n        assert not torch.isnan(output).any()\n        print("✓ Forward pass test (medium) passed")\n\n    def test_loss_calculation(self, config, data_feature_small):\n        """Test loss calculation"""\n        model = STSSDL(config, data_feature_small)\n        model.train()\n\n        batch_size = 2\n        num_nodes = 10\n        input_window = 12\n\n        batch = {\n            \'X\': torch.randn(batch_size, input_window, num_nodes, 3),\n            \'y\': torch.randn(batch_size, config[\'output_window\'], num_nodes, 1)\n        }\n\n        loss = model.calculate_loss(batch)\n\n        assert loss.item() > 0\n        assert not torch.isnan(loss)\n        assert loss.requires_grad\n        print(f"✓ Loss calculation test passed (loss={loss.item():.4f})")\n\n    def test_backward_pass(self, config, data_feature_small):\n        """Test backward pass and gradient computation"""\n        model = STSSDL(config, data_feature_small)\n        model.train()\n\n        batch_size = 2\n        num_nodes = 10\n        input_window = 12\n\n        batch = {\n            \'X\': torch.randn(batch_size, input_window, num_nodes, 3),\n            \'y\': torch.randn(batch_size, config[\'output_window\'], num_nodes, 1)\n        }\n\n        loss = model.calculate_loss(batch)\n        loss.backward()\n\n        # Check if gradients are computed\n        has_gradients = False\n        for param in model.parameters():\n            if param.grad is not None:\n                has_gradients = True\n                assert not torch.isnan(param.grad).any()\n\n        assert has_gradients\n        print("✓ Backward pass test passed")\n\n    def test_training_step(self, config, data_feature_small):\n        """Test a complete training step"""\n        model = STSSDL(config, data_feature_small)\n        optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n\n        batch_size = 2\n        num_nodes = 10\n        input_window = 12\n\n        batch = {\n            \'X\': torch.randn(batch_size, input_window, num_nodes, 3),\n            \'y\': torch.randn(batch_size, config[\'output_window\'], num_nodes, 1)\n        }\n\n        # Training step\n        model.train()\n        optimizer.zero_grad()\n        loss = model.calculate_loss(batch)\n        loss.backward()\n        optimizer.step()\n\n        assert loss.item() > 0\n        print(f"✓ Training step test passed (loss={loss.item():.4f})")\n\n    def test_config_variations(self, data_feature_small):\n        """Test model with different configuration parameters"""\n        configs = [\n            {\'use_STE\': False, \'rnn_units\': 32},\n            {\'use_curriculum_learning\': False, \'rnn_units\': 64},\n            {\'adaptive_embedding_dim\': 0, \'rnn_units\': 64},\n        ]\n\n        base_config = {\n            \'device\': torch.device(\'cpu\'),\n            \'input_window\': 12,\n            \'output_window\': 12,\n            \'rnn_layers\': 1,\n            \'cheb_k\': 3,\n            \'prototype_num\': 10,\n            \'prototype_dim\': 32,\n            \'tod_embed_dim\': 8,\n            \'cl_decay_steps\': 2000,\n            \'use_curriculum_learning\': True,\n            \'use_STE\': True,\n            \'adaptive_embedding_dim\': 24,\n            \'node_embedding_dim\': 10,\n            \'input_embedding_dim\': 64,\n            \'TDAY\': 288,\n            \'lamb_c\': 0.1,\n            \'lamb_d\': 1.0,\n        }\n\n        for i, variant in enumerate(configs):\n            config = {**base_config, **variant}\n            model = STSSDL(config, data_feature_small)\n            assert model is not None\n            print(f"✓ Config variation {i+1} test passed")\n\n    def test_device_compatibility(self, config, data_feature_small):\n        """Test model works on CPU (GPU test only if available)"""\n        model = STSSDL(config, data_feature_small)\n        model.to(\'cpu\')\n\n        batch = {\n            \'X\': torch.randn(2, 12, 10, 3),\n            \'y\': torch.randn(2, 12, 10, 1)\n        }\n\n        loss = model.calculate_loss(batch)\n        assert loss.device.type == \'cpu\'\n        print("✓ CPU compatibility test passed")\n\n        if torch.cuda.is_available():\n            model = model.to(\'cuda\')\n            batch = {\n                \'X\': torch.randn(2, 12, 10, 3).cuda(),\n                \'y\': torch.randn(2, 12, 10, 1).cuda()\n            }\n            loss = model.calculate_loss(batch)\n            assert loss.device.type == \'cuda\'\n            print("✓ GPU compatibility test passed")\n        else:\n            print("⊗ GPU not available, skipping GPU test")\n\n\nclass TestSTSSDLAdvanced:\n    """Advanced tests for ST-SSDL model functionality"""\n\n    def test_prototype_mechanism(self):\n        """Test the prototype querying mechanism"""\n        config = {\n            \'device\': torch.device(\'cpu\'),\n            \'input_window\': 12,\n            \'output_window\': 12,\n            \'rnn_units\': 64,\n            \'rnn_layers\': 1,\n            \'cheb_k\': 3,\n            \'prototype_num\': 10,\n            \'prototype_dim\': 32,\n            \'use_STE\': True,\n            \'adaptive_embedding_dim\': 24,\n            \'node_embedding_dim\': 10,\n            \'input_embedding_dim\': 64,\n        }\n\n        data_feature = {\n            \'num_nodes\': 10,\n            \'feature_dim\': 1,\n            \'output_dim\': 1,\n            \'adj_mx\': np.eye(10),\n        }\n\n        model = STSSDL(config, data_feature)\n\n        # Check prototypes exist\n        assert hasattr(model.model, \'prototypes\')\n        assert \'prototypes\' in model.model.prototypes\n        assert \'Wq\' in model.model.prototypes\n\n        print("✓ Prototype mechanism test passed")\n\n    def test_batches_seen_counter(self):\n        """Test that batches_seen counter increments during training"""\n        config = {\n            \'device\': torch.device(\'cpu\'),\n            \'input_window\': 12,\n            \'output_window\': 12,\n            \'rnn_units\': 32,\n            \'use_curriculum_learning\': True,\n        }\n\n        data_feature = {\n            \'num_nodes\': 5,\n            \'feature_dim\': 1,\n            \'output_dim\': 1,\n            \'adj_mx\': np.eye(5),\n        }\n\n        model = STSSDL(config, data_feature)\n        initial_count = model.batches_seen\n\n        batch = {\n            \'X\': torch.randn(2, 12, 5, 3),\n            \'y\': torch.randn(2, 12, 5, 1)\n        }\n\n        model.calculate_loss(batch)\n        assert model.batches_seen == initial_count + 1\n\n        model.calculate_loss(batch)\n        assert model.batches_seen == initial_count + 2\n\n        print("✓ Batches seen counter test passed")\n\n\ndef test_import():\n    """Test if model can be imported properly"""\n    try:\n        from libcity.model.traffic_speed_prediction.STSSDL import STSSDL\n        print("✓ Import test passed")\n        return True\n    except ImportError as e:\n        print(f"✗ Import test failed: {e}")\n        return False\n\n\nif __name__ == "__main__":\n    print("=" * 60)\n    print("ST-SSDL Model Integration Tests")\n    print("=" * 60)\n\n    # Run import test first\n    if not test_import():\n        sys.exit(1)\n\n    # Run pytest\n    pytest.main([__file__, \'-v\', \'-s\'])\n'}
