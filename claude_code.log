8), f"Expected (4, 32, 128), got {output.shape}"\n    print(f"✓ Forward pass successful")\n    print(f"  Input: {x.shape} -> Output: {output.shape}")\n    print(f"  Output mean: {output.mean().item():.4f}, std: {output.std().item():.4f}")\nexcept Exception as e:\n    print(f"✗ GridEncoder test failed: {e}")\n    import traceback\n    traceback.print_exc()\n\n# Test 2: GridDecoder standalone\nprint("\\n[TEST 2: GridDecoder Component]")\nprint("-" * 70)\n\nclass GridDecoder(nn.Module):\n    """Grid Decoder: Maps from grid representation back to target locations."""\n\n    def __init__(self, hidden_dim, output_dim, dropout=0.1):\n        super().__init__()\n        self.hidden_dim = hidden_dim\n        self.output_dim = output_dim\n\n        self.attention = nn.MultiheadAttention(\n            embed_dim=hidden_dim,\n            num_heads=4,\n            dropout=dropout,\n            batch_first=True\n        )\n\n        self.norm = nn.LayerNorm(hidden_dim)\n        self.dropout = nn.Dropout(dropout)\n\n        self.mlp = nn.Sequential(\n            nn.Linear(hidden_dim, hidden_dim * 2),\n            nn.ReLU(),\n            nn.Dropout(dropout),\n            nn.Linear(hidden_dim * 2, hidden_dim)\n        )\n\n    def forward(self, grid_features, query_features):\n        decoded, _ = self.attention(query_features, grid_features, grid_features)\n        decoded = self.norm(query_features + self.dropout(decoded))\n        decoded = decoded + self.dropout(self.mlp(decoded))\n        return decoded\n\ntry:\n    decoder = GridDecoder(hidden_dim=128, output_dim=1, dropout=0.1)\n    print(f"✓ GridDecoder instantiated")\n    print(f"  Parameters: {sum(p.numel() for p in decoder.parameters()):,}")\n\n    # Forward pass test\n    batch_size = 4\n    grid_features = torch.randn(batch_size, 32, 128)\n    query_features = torch.randn(batch_size, 50, 128)\n    output = decoder(grid_features, query_features)\n\n    assert output.shape == (batch_size, 50, 128), f"Expected (4, 50, 128),