2025-11-25 04:38:19 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/private/shk/codex/scripts/model_config_generator.py', 'content': '#!/usr/bin/env python3\n"""\nLibCity Model Config Generator\n\nThis script generates configuration files for new models in LibCity.\nIt can be used to quickly create standardized configs for ported models.\n"""\n\nimport json\nimport os\nimport argparse\nfrom typing import Dict, Any\n\n\nDEFAULT_TRAFFIC_STATE_CONFIG = {\n    "scaler": "standard",\n    "load_external": False,\n    "normal_external": False,\n    "ext_scaler": "none",\n    "add_time_in_day": True,\n    "add_day_in_week": True,\n    "max_epoch": 100,\n    "learner": "adam",\n    "learning_rate": 0.001,\n    "lr_decay": True,\n    "lr_scheduler": "multisteplr",\n    "lr_decay_ratio": 0.5,\n    "steps": [50, 75],\n    "clip_grad_norm": True,\n    "max_grad_norm": 5,\n    "use_early_stop": True,\n    "patience": 15,\n    "log_every": 1,\n    "saved": True,\n    "save_mode": "best",\n    "monitor_metric": "MAE"\n}\n\n\ndef create_model_config(\n    model_name: str,\n    model_params: Dict[str, Any],\n    task: str = "traffic_state_pred",\n    output_dir: str = None\n) -> str:\n    """\n    Create a configuration file for a LibCity model.\n\n    Args:\n        model_name: Name of the model (e.g., \'LSTGAN\')\n        model_params: Dictionary of model-specific parameters\n        task: Task type (default: \'traffic_state_pred\')\n        output_dir: Output directory (default: current directory)\n\n    Returns:\n        Path to created config file\n    """\n    # Merge model params with defaults\n    config = DEFAULT_TRAFFIC_STATE_CONFIG.copy()\n    config.update(model_params)\n\n    # Create output directory if needed\n    if output_dir is None:\n        output_dir = "."\n    os.makedirs(output_dir, exist_ok=True)\n\n    # Write config file\n    output_path = os.path.join(output_dir, f"{model_name}.json")\n    with open(output_path, \'w\') as f:\n        json.dump(config, f, indent=2)\n\n    print(f"Created config file: {output_path}")\n    return output_path\n\n\ndef create_dataset_config(\n    model_name: str,\n    dataset_name: str,\n    dataset_params: Dict[str, Any] = None,\n    output_dir: str = None\n) -> str:\n    """\n    Create a dataset-specific configuration for a model.\n\n    Args:\n        model_name: Name of the model\n        dataset_name: Name of the dataset (e.g., \'METR_LA\')\n        dataset_params: Dataset-specific parameters\n        output_dir: Output directory\n\n    Returns:\n        Path to created config file\n    """\n    if dataset_params is None:\n        dataset_params = {}\n\n    config = DEFAULT_TRAFFIC_STATE_CONFIG.copy()\n    config.update(dataset_params)\n\n    if output_dir is None:\n        output_dir = "."\n    os.makedirs(output_dir, exist_ok=True)\n\n    output_path = os.path.join(output_dir, f"{model_name}_{dataset_name}.json")\n    with open(output_path, \'w\') as f:\n        json.dump(config, f, indent=2)\n\n    print(f"Created dataset config: {output_path}")\n    return output_path\n\n\ndef generate_run_script(\n    model_name: str,\n    dataset_name: str,\n    output_path: str = None\n) -> str:\n    """\n    Generate a bash script to run a model on a dataset.\n\n    Args:\n        model_name: Name of the model\n        dataset_name: Name of the dataset\n        output_path: Path for the script (default: run_{model}_{dataset}.sh)\n\n    Returns:\n        Path to created script\n    """\n    if output_path is None:\n        output_path = f"run_{model_name}_{dataset_name}.sh"\n\n    script_content = f"""#!/bin/bash\n# Auto-generated script to run {model_name} on {dataset_name}\n\nMODEL="{model_name}"\nDATASET="{dataset_name}"\nTASK="traffic_state_pred"\n\n# Default parameters (can be overridden via command line)\nEPOCHS="${{1:-100}}"\nBATCH_SIZE="${{2:-64}}"\nGPU="${{3:-0}}"\n\necho "Running $MODEL on $DATASET"\necho "Epochs: $EPOCHS, Batch Size: $BATCH_SIZE, GPU: $GPU"\n\npython run_model.py \\\\\n    --task $TASK \\\\\n    --model $MODEL \\\\\n    --dataset $DATASET \\\\\n    --max_epoch $EPOCHS \\\\\n    --batch_size $BATCH_SIZE \\\\\n    --gpu_id $GPU \\\\\n    --saved_model True \\\\\n    --log_level INFO\n\necho "Training complete!"\n"""\n\n    with open(output_path, \'w\') as f:\n        f.write(script_content)\n\n    # Make executable\n    os.chmod(output_path, 0o755)\n\n    print(f"Created run script: {output_path}")\n    return output_path\n\n\ndef main():\n    parser = argparse.ArgumentParser(description="Generate LibCity model configurations")\n    parser.add_argument("--model", required=True, help="Model name")\n    parser.add_argument("--dataset", help="Dataset name (for dataset-specific configs)")\n    parser.add_argument("--params", help="JSON string of model parameters")\n    parser.add_argument("--output-dir", help="Output directory")\n    parser.add_argument("--generate-script", action="store_true",\n                       help="Generate run script")\n\n    args = parser.parse_args()\n\n    # Parse model parameters\n    model_params = {}\n    if args.params:\n        model_params = json.loads(args.params)\n\n    # Create config\n    if args.dataset:\n        create_dataset_config(args.model, args.dataset, model_params, args.output_dir)\n        if args.generate_script:\n            generate_run_script(args.model, args.dataset)\n    else:\n        create_model_config(args.model, model_params, output_dir=args.output_dir)\n\n\nif __name__ == "__main__":\n    # Example usage if run directly\n    import sys\n\n    if len(sys.argv) == 1:\n        print("LibCity Model Config Generator")\n        print("\\nExample usage:")\n        print(\'  python model_config_generator.py --model LSTGAN --params \\\'{"hidden_dim": 64}\\\'\')\n        print(\'  python model_config_generator.py --model MLCAFormer --dataset METR_LA --generate-script\')\n        sys.exit(0)\n\n    main()\n'}
