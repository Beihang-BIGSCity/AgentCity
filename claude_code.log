2025-11-25 12:25:38 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/private/shk/codex/scripts/gridded_tnp_adapter.py', 'content': '"""\nDataset Adapter for GriddedTNP Model in LibCity\n\nThis module provides utilities to adapt various dataset formats to the GriddedTNP model\'s\nexpected input format. It handles conversions between different spatio-temporal representations.\n"""\n\nimport numpy as np\nimport torch\nfrom typing import Dict, Tuple, Optional\n\n\nclass GriddedTNPDatasetAdapter:\n    """\n    Adapter to convert LibCity datasets to GriddedTNP compatible format.\n\n    The GriddedTNP model expects data in a specific format that may differ from\n    LibCity\'s standard TrafficStateDataset format. This adapter handles the conversion.\n    """\n\n    def __init__(self, num_nodes: int, feature_dim: int, output_dim: int):\n        """\n        Initialize the dataset adapter.\n\n        Args:\n            num_nodes: Number of spatial nodes/sensors\n            feature_dim: Input feature dimension\n            output_dim: Output feature dimension\n        """\n        self.num_nodes = num_nodes\n        self.feature_dim = feature_dim\n        self.output_dim = output_dim\n\n    def adapt_batch(self, batch: Dict[str, torch.Tensor]) -> Dict[str, torch.Tensor]:\n        """\n        Adapt a batch from LibCity format to GriddedTNP format.\n\n        Args:\n            batch: Dictionary containing \'X\' and \'y\' tensors in LibCity format\n                   X: (batch_size, input_window, num_nodes, feature_dim)\n                   y: (batch_size, output_window, num_nodes, output_dim)\n\n        Returns:\n            Adapted batch dictionary compatible with GriddedTNP\n        """\n        # LibCity\'s standard format already matches GriddedTNP\'s expected format\n        # This method is here for extensibility if additional preprocessing is needed\n        return batch\n\n    def create_spatial_features(self,\n                               locations: Optional[np.ndarray] = None) -> torch.Tensor:\n        """\n        Create spatial feature embeddings from node locations.\n\n        Args:\n            locations: Optional array of shape (num_nodes, spatial_dim) containing\n                      spatial coordinates (lat, lon, etc.)\n\n        Returns:\n            Spatial feature tensor of shape (num_nodes, spatial_feature_dim)\n        """\n        if locations is None:\n            # Create default spatial features using node indices\n            locations = np.arange(self.num_nodes).reshape(-1, 1)\n\n        # Normalize locations to [0, 1] range\n        loc_min = locations.min(axis=0, keepdims=True)\n        loc_max = locations.max(axis=0, keepdims=True)\n        normalized_locations = (locations - loc_min) / (loc_max - loc_min + 1e-8)\n\n        return torch.FloatTensor(normalized_locations)\n\n    def process_irregular_grid(self,\n                               observations: np.ndarray,\n                               locations: np.ndarray,\n                               timestamps: np.ndarray,\n                               target_grid_size: Tuple[int, int] = (32, 32)) -> Dict[str, torch.Tensor]:\n        """\n        Convert irregular spatio-temporal observations to regular grid format.\n\n        This is useful when dealing with non-uniform sensor deployments or\n        missing data patterns that need to be gridded.\n\n        Args:\n            observations: Array of shape (num_obs, feature_dim)\n            locations: Array of shape (num_obs, 2) with (lat, lon) coordinates\n            timestamps: Array of shape (num_obs,) with time indices\n            target_grid_size: Desired output grid size (height, width)\n\n        Returns:\n            Dictionary with gridded data tensors\n        """\n# Implementation for gridding irregular observations\n        # This is a placeholder - actual implementation would depend on specific needs\n\n        grid_height, grid_width = target_grid_size\n\n        # Create spatial bins\n        lat_bins = np.linspace(locations[:, 0].min(), locations[:, 0].max(), grid_height + 1)\n        lon_bins = np.linspace(locations[:, 1].min(), locations[:, 1].max(), grid_width + 1)\n\n        # Digitize locations into grid cells\n        lat_indices = np.digitize(locations[:, 0], lat_bins) - 1\n        lon_indices = np.digitize(locations[:, 1], lon_bins) - 1\n\n        # Clip to valid range\n        lat_indices = np.clip(lat_indices, 0, grid_height - 1)\n        lon_indices = np.clip(lon_indices, 0, grid_width - 1)\n\n        # Create gridded tensor\n        num_times = int(timestamps.max()) + 1\n        gridded_data = np.zeros((num_times, grid_height, grid_width, observations.shape[1]))\n        counts = np.zeros((num_times, grid_height, grid_width))\n\n        # Aggregate observations into grid cells\n        for i in range(len(observations)):\n            t = int(timestamps[i])\n            h = lat_indices[i]\n            w = lon_indices[i]\n            gridded_data[t, h, w] += observations[i]\n            counts[t, h, w] += 1\n\n        # Average observations in each cell\n        mask = counts > 0\n        gridded_data[mask] /= counts[mask][..., np.newaxis]\n\n        return {\n            \'gridded_data\': torch.FloatTensor(gridded_data),\n            \'counts\': torch.FloatTensor(counts),\n            \'mask\': torch.BoolTensor(mask)\n        }\n\n\nclass WeatherDataAdapter:\n    """\n    Adapter for converting weather/climate data to GriddedTNP format.\n\n    The original GriddedTNP paper used ERA5 weather data, so this adapter\n    helps convert similar gridded climate datasets.\n    """\n\n    def __init__(self, grid_shape: Tuple[int, int]):\n        """\n        Initialize weather data adapter.\n\n        Args:\n            grid_shape: Shape of the spatial grid (height, width)\n        """\n        self.grid_shape = grid_shape\n\n    def convert_netcdf_to_libcity(self,\n                                  netcdf_path: str,\n                                  variable_names: list) -> Dict[str, np.ndarray]:\n        """\n        Convert NetCDF weather data to LibCity compatible format.\n\n        Args:\n            netcdf_path: Path to NetCDF file\n            variable_names: List of variable names to extract\n\n        Returns:\n            Dictionary with converted data\n        """\n        try:\n            import xarray as xr\n        except ImportError:\n            raise ImportError("xarray is required for NetCDF processing. Install with: pip install xarray")\n\n        # Load NetCDF file\n        ds = xr.open_dataset(netcdf_path)\n\n        data_dict = {}\n        for var in variable_names:\n            if var in ds:\n                data_dict[var] = ds[var].values\n            else:\n                print(f"Warning: Variable {var} not found in NetCDF file")\n\n        ds.close()\n        return data_dict\n\n\ndef create_training_config(model_name: str = "GriddedTNP",\n                          dataset_name: str = "METR_LA",\n                          custom_params: Optional[Dict] = None) -> Dict:\n    """\n    Generate a training configuration for GriddedTNP model.\n\n    Args:\n        model_name: Name of the model\n        dataset_name: Name of the dataset\n        custom_params: Optional dictionary of custom parameters to override defaults\n\n    Returns:\n        Complete configuration dictionary\n    """\n    base_config = {\n        \'task\': \'traffic_state_pred\',\n        \'model\': model_name,\n        \'dataset\': dataset_name,\n        \'exp_id\': f\'{model_name}_{dataset_name}\',\n\n        # Model architecture\n        \'hidden_dim\': 128,\n        \'num_heads\': 4,\n        \'num_layers\': 3,\n        \'dropout\': 0.1,\n        \'grid_size\': 32,\n\n        # Data processing\n        \'input_window\': 12,\n        \'output_window\': 12,\n        \'scaler\': \'standard\',\n\n        # Training\n        \'batch_size\': 64,\n        \'max_epoch\': 100,\n        \'learner\': \'adam\',\n        \'learning_rate\': 0.001,\n        \'lr_decay\': True,\n        \'lr_scheduler\': \'cosinelr\',\n        \'clip_grad_norm\': True,\n        \'max_grad_norm\': 5,\n\n        # Evaluation\n        \'use_early_stop\': True,\n        \'patience\': 20,\n        \'metrics\': [\'MAE\', \'RMSE\', \'MAPE\'],\n    }\n\n    if custom_params:\n        base_config.update(custom_params)\n\n    return base_config\n\n\n# Example usage functions\ndef example_usage():\n    """\n    Example of how to use the GriddedTNP model with LibCity.\n    """\n    usage_example = """\n    # Basic Usage Example for GriddedTNP in LibCity\n\n    ## 1. Training the model from command line:\n\n    ```bash\n    python run_model.py --task traffic_state_pred --model GriddedTNP --dataset METR_LA\n    ```\n\n    ## 2. Using custom configuration:\n\n    ```python\n    from libcity.config import ConfigParser\n    from libcity.data import get_dataset\n    from libcity.executor import get_executor\n    from libcity.model import get_model\n\n    # Create config\n    config = ConfigParser()\n    config[\'model\'] = \'GriddedTNP\'\n    config[\'dataset\'] = \'METR_LA\'\n    config[\'hidden_dim\'] = 256\n    config[\'num_layers\'] = 4\n\n    # Load dataset\n    dataset = get_dataset(config)\n\n    # Create model\n    model = get_model(config, dataset.get_data_feature())\n\n    # Train\n    executor = get_executor(config, model, dataset)\n    executor.train()\n    ```\n\n    ## 3. Using the dataset adapter:\n\n    ```python\n    from scripts.gridded_tnp_adapter import GriddedTNPDatasetAdapter\n\n    adapter = GriddedTNPDatasetAdapter(\n        num_nodes=207,  # e.g., METR_LA has 207 sensors\n        feature_dim=2,\n        output_dim=1\n    )\n\n    # Adapt batch during training\n    adapted_batch = adapter.adapt_batch(batch)\n    predictions = model(adapted_batch)\n    ```\n\n    ## 4. Converting weather data:\n\n    ```python\n    from scripts.gridded_tnp_adapter import WeatherDataAdapter\n\n    weather_adapter = WeatherDataAdapter(grid_shape=(64, 64))\n    data = weather_adapter.convert_netcdf_to_libcity(\n        \'era5_data.nc\',\n        [\'temperature_2m\', \'wind_speed_10m\']\n    )\n    ```\n    """\n\n    return usage_example\n\n\nif __name__ == "__main__":\n    # Print example usage\n    print(example_usage())\n\n    # Create a sample configuration\n    config = create_training_config(\n        model_name=\'GriddedTNP\',\n        dataset_name=\'PEMS04\',\n        custom_params={\'num_layers\': 4, \'hidden_dim\': 256}\n    )\n\n    print("\\nSample Configuration:")\n    import json\n    print(json.dumps(config, indent=2))\n'}
