2025-11-26 09:02:39 | INFO | Tool Write called with {'file_path': 'Bigscity-LibCity/libcity/model/traffic_speed_prediction/STELLA.py', 'content': 'from logging import getLogger\nimport torch\nimport torch.nn as nn\nimport numpy as np\nfrom libcity.model import loss\nfrom libcity.model.abstract_traffic_state_model import AbstractTrafficStateModel\nfrom sklearn.preprocessing import StandardScaler\n\n\nclass MLP(nn.Module):\n    """Multi-layer Perceptron with optional residual connection"""\n\n    def __init__(self, input_dim, hidden_dim, res_conn, dropout):\n        super(MLP, self).__init__()\n        self.input_dim = input_dim\n        self.hidden_dim = hidden_dim\n        self.res_conn = res_conn\n\n        if self.res_conn:\n            self.model = nn.Sequential(\n                nn.Linear(self.input_dim, self.hidden_dim),\n                nn.ReLU(),\n                nn.Linear(self.hidden_dim, self.hidden_dim),\n                nn.Dropout(p=dropout)\n            )\n        else:\n            self.model = nn.Sequential(\n                nn.Linear(self.input_dim, self.hidden_dim),\n                nn.ReLU(),\n                nn.Dropout(p=dropout)\n            )\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        # x: [B, C, N, D]\n        if self.res_conn:\n            out = self.model(x) + x\n        else:\n            out = self.model(x)\n        return out\n\n\nclass SpatialEmbedding(nn.Module):\n    """Spatial embedding for node positions"""\n\n    def __init__(self, node_dim, num_nodes, if_rel=False):\n        super(SpatialEmbedding, self).__init__()\n        self.if_rel = if_rel\n        self.num_nodes = num_nodes\n\n        if self.if_rel is False:\n            self.embedding = nn.Sequential(\n                nn.Linear(3, node_dim),\n                nn.ReLU(),\n                nn.Linear(node_dim, node_dim)\n            )\n        else:\n            self.embedding = nn.Embedding(num_nodes, node_dim)\n\n    def forward(self, x):\n        if self.if_rel is False:\n            x = self.embedding(x)\n        else:\n            node_id = torch.Tensor(np.arange(self.num_nodes)).to(x.device)\n            x = self.embedding(node_id.long())\n        return x\n\n\nclass TemporalEmbedding(nn.Module):\n    """Temporal embedding for time features"""\n\n    def __init__(self, time_dim):\n        super(TemporalEmbedding, self).__init__()\n\n        self.hour_size = 24\n        self.day_size = 32\n        self.month_size = 13\n\n        self.hour_in_day_embed = nn.Embedding(self.hour_size, time_dim)\n        self.day_in_month_embed = nn.Embedding(self.day_size, time_dim)\n        self.month_in_year_embed = nn.Embedding(self.month_size, time_dim)\n\n    def forward(self, x):\n        _, f = x.shape\n        hour_x = self.hour_in_day_embed((x[..., 2] * self.hour_size).long()) if f > 2 else 0.\n        day_x = self.day_in_month_embed((x[..., 1] * self.day_size).long()) if f > 1 else 0.\n        month_x = self.month_in_year_embed((x[..., 0] * self.month_size).long())\n\n        return hour_x + day_x + month_x\n\n\nclass PositionEmbedding(nn.Module):\n    """Combines spatial and temporal embeddings"""\n\n    def __init__(self, d_model, num_nodes, node_positions=None, if_rel=False):\n        super(PositionEmbedding, self).__init__()\n\n        self.randomly_init = if_rel\n\n        # Handle node positions - if not provided, use random initialization\n        if node_positions is not None and not if_rel:\n            scaler = StandardScaler()\n            scaler.fit(node_positions)\n            node_pos = scaler.transform(node_positions)\n            self.node_pos = torch.from_numpy(node_pos).float()\n        else:\n            # Use learnable embeddings if no positions provided\n            self.node_pos = None\n\n        self.time_emb = TemporalEmbedding(d_model)\n        self.node_emb = SpatialEmbedding(d_model, num_nodes, if_rel or node_positions is None)\n\n    def forward(self, x, x_mark):\n        # x in [B, C, N, D]\n        B, C, N, _ = x.shape\n\n        # x_mark in [B, f], time_emb in [B, C, N, D]\n        time_emb = self.time_emb(x_mark).repeat(C, N, 1, 1).permute(2, 0, 1, 3)\n\n        # node_pos in [N, 3] or None, node_emb in [B, C, N, D]\n        if self.node_pos is not None:\n            pos = self.node_pos.to(x.device)\n            node_emb = self.node_emb(pos).repeat(B, C, 1, 1)\n        else:\n            # Use learnable embeddings\n            dummy_pos = torch.zeros(N, 3).to(x.device)\n            node_emb = self.node_emb(dummy_pos).repeat(B, C, 1, 1)\n\n        emb = x + time_emb + node_emb\n        return emb\n\n\nclass STELLACore(nn.Module):\n    """STELLA: Spatial-Temporal Embedded Lightweight Model for Atmospheric Time Series Forecasting"""\n\n    def __init__(self, num_nodes, num_features, input_len, d_model, output_len,\n                 num_layer, if_rel, res_conn, dropout, node_positions=None):\n        super().__init__()\n\n        # attributes\n        self.num_nodes = num_nodes\n        self.num_features = num_features\n        self.input_len = input_len\n        self.d_model = d_model\n        self.output_len = output_len\n        self.num_layer = num_layer\n        self.if_rel = if_rel\n        self.res_conn = res_conn\n        self.dropout = dropout\n\n        # input embedding layer\n        self.input_embedding = nn.Linear(self.input_len, self.d_model)\n\n        # positional encoding\n        self.pos_embedding = PositionEmbedding(self.d_model, self.num_nodes, node_positions, self.if_rel)\n\n        # MLP encoder\n        self.encoder = nn.Sequential(\n            *[MLP(self.d_model, self.d_model, self.res_conn, self.dropout) for _ in range(self.num_layer)]\n        )\n\n        # regression output layer\n        self.output_layer = nn.Linear(self.d_model, self.output_len)\n\n    def forward(self, history_data: torch.Tensor, time_features: torch.Tensor) -> torch.Tensor:\n        """Forward pass\n\n        Args:\n            history_data: [B, L, N, C] historical data\n            time_features: [B, T] temporal features (month, day, hour normalized to [0,1])\n\n        Returns:\n            torch.Tensor: prediction with shape [B, F, N, C]\n        """\n        # Extract data features\n        x = history_data[..., :self.num_features]  # [B, L, N, C]\n\n        # embedding\n        x = x.transpose(1, -1)  # [B, C, N, L]\n        x = self.input_embedding(x)  # [B, C, N, D]\n        x = self.pos_embedding(x, time_features)  # [B, C, N, D]\n\n        # encoding\n        output = self.encoder(x)  # [B, C, N, D]\n\n        # output\n        prediction = self.output_layer(output).transpose(1, -1)  # [B, F, N, C]\n\n        return prediction\n\n\nclass STELLA(AbstractTrafficStateModel):\n    """\n    STELLA adapter for LibCity framework\n\n    Paper: On the Integration of Spatial-Temporal Knowledge: A Lightweight Approach\n           to Atmospheric Time Series Forecasting (NeurIPS 2025)\n\n    Original Repository: https://github.com/GestaltCogTeam/STELLA\n    """\n\n    def __init__(self, config, data_feature):\n        super().__init__(config, data_feature)\n\n        # Get data features from LibCity dataset\n        self._scaler = self.data_feature.get(\'scaler\')\n        self.num_nodes = self.data_feature.get(\'num_nodes\', 1)\n        self.feature_dim = self.data_feature.get(\'feature_dim\', 1)\n        self.output_dim = self.data_feature.get(\'output_dim\', 1)\n\n        # Get node positions if available (optional for STELLA)\n        self.node_positions = self.data_feature.get(\'node_positions\', None)\n\n        # Initialize logger\n        self._logger = getLogger()\n\n        # Get model parameters from config\n        self.device = config.get(\'device\', torch.device(\'cpu\'))\n        self.input_window = config.get(\'input_window\', 12)\n        self.output_window = config.get(\'output_window\', 12)\n\n        # STELLA-specific parameters\n        self.d_model = config.get(\'d_model\', 32)\n        self.num_layer = config.get(\'num_layer\', 2)\n        self.if_rel = config.get(\'if_rel\', False)  # Use relative positional encoding\n        self.res_conn = config.get(\'res_conn\', True)  # Use residual connections\n        self.dropout = config.get(\'dropout\', 0.2)\n\n        # Build STELLA model\n        self.model = STELLACore(\n            num_nodes=self.num_nodes,\n            num_features=self.feature_dim,\n            input_len=self.input_window,\n            d_model=self.d_model,\n            output_len=self.output_window,\n            num_layer=self.num_layer,\n            if_rel=self.if_rel,\n            res_conn=self.res_conn,\n            dropout=self.dropout,\n            node_positions=self.node_positions\n        ).to(self.device)\n\n        self._logger.info(f\'STELLA initialized with {self.num_nodes} nodes, \'\n                         f\'d_model={self.d_model}, num_layers={self.num_layer}\')\n\n    def forward(self, batch):\n        """\n        Forward pass through the model\n\n        Args:\n            batch: Dictionary containing \'X\' with shape [B, L, N, C]\n                   and optionally temporal features\n\n        Returns:\n            torch.Tensor: predictions with shape [B, F, N, C]\n        """\n        # Get input data\n        x = batch[\'X\']  # [B, L, N, C]\n\n        # Extract or construct temporal features\n        # LibCity typically provides time features in the data\n        # If not available, we create dummy temporal features\n        if \'X_ext\' in batch and batch[\'X_ext\'] is not None:\n            # Use external features if available (should contain time info)\n            time_features = batch[\'X_ext\'][:, 0, 0, :]  # [B, T]\n        else:\n            # Create dummy temporal features (normalized month, day, hour)\n            batch_size = x.shape[0]\n            time_features = torch.zeros(batch_size, 3).to(x.device)\n\n        # Forward through STELLA model\n        output = self.model(x, time_features)\n\n        return output\n\n    def predict(self, batch):\n        """\n        Multi-step prediction\n\n        Args:\n            batch: Input batch\n\n        Returns:\n            torch.Tensor: predictions\n        """\n        return self.forward(batch)\n\n    def calculate_loss(self, batch):\n        """\n        Calculate loss for training\n\n        Args:\n            batch: Input batch containing \'X\' and \'y\'\n\n        Returns:\n            torch.Tensor: loss value\n        """\n        # Get ground truth\n        y_true = batch[\'y\']\n\n        # Get predictions\n        y_predicted = self.predict(batch)\n\n        # Inverse transform (denormalize)\n        y_true = self._scaler.inverse_transform(y_true[..., :self.output_dim])\n        y_predicted = self._scaler.inverse_transform(y_predicted[..., :self.output_dim])\n\n        # Calculate MAE loss (as used in original STELLA paper)\n        res = loss.masked_mae_torch(y_predicted, y_true, null_val=0.0)\n\n        return res\n'}
