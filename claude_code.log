2025-11-26 09:04:06 | INFO | Tool Write called with {'file_path': 'automation/stella_integration_helper.py', 'content': '"""\nSTELLA Integration Helper Script for LibCity\n\nThis script provides utilities for testing and running the STELLA model\nwithin the LibCity framework.\n"""\n\nimport json\nimport os\n\n\ndef generate_stella_config(\n    dataset_name="METR_LA",\n    input_window=12,\n    output_window=12,\n    d_model=32,\n    num_layer=2,\n    batch_size=32,\n    learning_rate=0.0005\n):\n    """\n    Generate a complete configuration for running STELLA on a specific dataset.\n\n    Args:\n        dataset_name: Name of the LibCity dataset\n        input_window: Input sequence length\n        output_window: Output prediction length\n        d_model: Hidden dimension size\n        num_layer: Number of MLP layers\n        batch_size: Training batch size\n        learning_rate: Learning rate\n\n    Returns:\n        dict: Complete configuration dictionary\n    """\n    config = {\n        "task": "traffic_state_pred",\n        "model": "STELLA",\n        "dataset": dataset_name,\n        "input_window": input_window,\n        "output_window": output_window,\n        "train_rate": 0.7,\n        "eval_rate": 0.1,\n        "batch_size": batch_size,\n        "learning_rate": learning_rate,\n        "d_model": d_model,\n        "num_layer": num_layer,\n        "if_rel": False,\n        "res_conn": True,\n        "dropout": 0.2,\n        "max_epoch": 100,\n        "learner": "adam",\n        "weight_decay": 0.0005,\n        "lr_decay": True,\n        "lr_scheduler": "multisteplr",\n        "lr_decay_ratio": 0.5,\n        "steps": [1, 50],\n        "clip_grad_norm": True,\n        "max_grad_norm": 5.0,\n        "use_early_stop": True,\n        "patience": 10,\n        "log_level": "INFO",\n        "gpu": True,\n        "gpu_id": 0\n    }\n    return config\n\n\ndef generate_run_command(dataset_name="METR_LA", config_file=None):\n    """\n    Generate the command to run STELLA model in LibCity.\n\n    Args:\n        dataset_name: Dataset name\n        config_file: Optional config file path\n\n    Returns:\n        str: Command string\n    """\n    if config_file:\n        return f"python run_model.py --task traffic_state_pred --model STELLA --dataset {dataset_name} --config_file {config_file}"\n    else:\n        return f"python run_model.py --task traffic_state_pred --model STELLA --dataset {dataset_name}"\n\n\ndef generate_batch_script(datasets=None, output_file="run_stella_batch.sh"):\n    """\n    Generate a batch script to run STELLA on multiple datasets.\n\n    Args:\n        datasets: List of dataset names\n        output_file: Output shell script filename\n\n    Returns:\n        str: Path to generated script\n    """\n    if datasets is None:\n        datasets = ["METR_LA", "PEMS_BAY", "PEMSD4", "PEMSD8"]\n\n    script_lines = [\n        "#!/bin/bash",\n        "# Batch script for running STELLA on multiple datasets",\n        "# Generated by STELLA integration helper",\n        "",\n        "cd Bigscity-LibCity",\n        ""\n    ]\n\n    for dataset in datasets:\n        script_lines.append(f"echo \'Running STELLA on {dataset}...\'")\n        script_lines.append(generate_run_command(dataset))\n        script_lines.append("")\n\n    script_content = "\\n".join(script_lines)\n\n    with open(output_file, \'w\') as f:\n        f.write(script_content)\n\n    # Make script executable\n    os.chmod(output_file, 0o755)\n\n    return output_file\n\n\ndef create_experiment_config(\n    experiment_name="stella_experiment",\n    base_config=None,\n    param_grid=None\n):\n    """\n    Create configuration for hyperparameter experiments.\n\n    Args:\n        experiment_name: Name for the experiment\n        base_config: Base configuration dictionary\n        param_grid: Dictionary of parameters to sweep\n\n    Returns:\n        list: List of configuration dictionaries\n    """\n    if base_config is None:\n        base_config = generate_stella_config()\n\n    if param_grid is None:\n        param_grid = {\n            \'d_model\': [16, 32, 64],\n            \'num_layer\': [1, 2, 3],\n            \'learning_rate\': [0.0001, 0.0005, 0.001]\n        }\n\n    configs = []\n    import itertools\n\n    # Generate all combinations\n    keys = param_grid.keys()\n    values = param_grid.values()\n\n    for combination in itertools.product(*values):\n        config = base_config.copy()\n        for key, value in zip(keys, combination):\n            config[key] = value\n        config[\'exp_id\'] = f"{experiment_name}_{len(configs)}"\n        configs.append(config)\n\n    return configs\n\n\ndef save_config(config, filename):\n    """Save configuration to JSON file."""\n    with open(filename, \'w\') as f:\n        json.dump(config, f, indent=2)\n    print(f"Configuration saved to {filename}")\n\n\n# Example usage\nif __name__ == "__main__":\n    # Generate default config\n    config = generate_stella_config(dataset_name="METR_LA")\n    print("Generated STELLA configuration:")\n    print(json.dumps(config, indent=2))\n\n    # Generate run command\n    cmd = generate_run_command("METR_LA")\n    print(f"\\nRun command:\\n{cmd}")\n\n    # Generate batch script\n    script_path = generate_batch_script()\n    print(f"\\nBatch script generated: {script_path}")\n'}
