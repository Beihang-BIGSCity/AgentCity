opout=0.1,\n        batch_first=True\n    )\n    transformer = nn.TransformerEncoder(transformer_layer, num_layers=3)\n    grid_processed = transformer(grid_features)\n    print(f"✓ Transformer processed: {grid_processed.shape}")\n\n    # Step 5: Decode\n    query_features = torch.randn(batch_size, output_window * num_nodes, hidden_dim)\n    decoder = GridDecoder(hidden_dim=hidden_dim, output_dim=output_dim)\n    decoded = decoder(grid_processed, query_features)\n    print(f"✓ Decoded: {decoded.shape}")\n\n    # Step 6: Output projection\n    output_proj = nn.Linear(hidden_dim, output_dim)\n    predictions = output_proj(decoded)\n    predictions = predictions.reshape(batch_size, output_window, num_nodes, output_dim)\n    print(f"✓ Final predictions: {predictions.shape}")\n\n    print(f"\\n✓ PIPELINE TEST PASSED")\n    print(f"  Total parameters in full model: ~{(sum(p.numel() for p in encoder.parameters()) + sum(p.numel() for p in decoder.parameters()) + sum(p.numel() for p in transformer.parameters())) / 1e6:.2f}M")\n\nexcept Exception as e:\n    print(f"✗ Pipeline test failed: {e}")\n    import traceback\n    traceback.print_exc()\n\n# Test 4: Memory and computational checks\nprint("\\n[TEST 4: Memory & Computation Checks]")\nprint("-" * 70)\n\ntry:\n    batch_sizes = [1, 4, 16, 32]\n    print("Testing different batch sizes:")\n    for bs in batch_sizes:\n        x = torch.randn(bs, 100, 64)\n        encoder = GridEncoder(64, 128, 32)\n        with torch.no_grad():\n            output = encoder(x)\n        print(f"  Batch size {bs:2d}: Input {x.shape} -> Output {output.shape} ✓")\n\n    print("\\nTesting different grid sizes:")\n    grid_sizes = [16, 32, 64, 128]\n    for gs in grid_sizes:\n        encoder = GridEncoder(64, 128, gs)\n        x = torch.randn(4, 100, 64)\n        with torch.no_grad():\n            output = encoder(x)\n        params = sum(p.numel() for p in encoder.parameters())\n        print(f"  Grid size {gs:3d}: Output {output.shape}, Parameters