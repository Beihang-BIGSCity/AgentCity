MSE", "masked_RMSE"],\n        "max_epoch": 100,\n        "learner": "adam",\n        "learning_rate": learning_rate,\n        "weight_decay": 0,\n        "lr_decay": True,\n        "lr_scheduler": "multisteplr",\n        "lr_decay_ratio": 0.5,\n        "steps": [20, 40, 60, 80],\n        "clip_grad_norm": True,\n        "max_grad_norm": 5,\n        "use_early_stop": True,\n        "patience": 15\n    }\n\n    if output_path is None:\n        output_path = f"SRSNet_{dataset_name}.json"\n\n    with open(output_path, "w") as f:\n        json.dump(config, f, indent=2)\n\n    print(f"✅ Configuration saved to: {output_path}")\n    print(f"📊 Dataset: {dataset_name}")\n    print(f"📏 Input/Output: {input_window}/{output_window}")\n    print(f"🔧 Model: patch_len={patch_len}, stride={stride}, d_model={d_model}")\n\n    return config\n\n\n# ==============================================================================\n# Quick Test Function\n# ==============================================================================\n\ndef quick_test(num_nodes=207, input_window=96, output_window=96, batch_size=32):\n    """\n    Quick validation test for SRSNet model.\n\n    Args:\n        num_nodes: Number of nodes (spatial dimension)\n        input_window: Input sequence length\n        output_window: Output sequence length\n        batch_size: Batch size for testing\n    """\n\n    print("=" * 70)\n    print("🧪 SRSNet Quick Validation Test")\n    print("=" * 70)\n\n    try:\n        from libcity.model.traffic_speed_prediction.SRSNet import SRSNet\n        print("✅ Successfully imported SRSNet from LibCity")\n    except ImportError as e:\n        print(f"❌ Failed to import SRSNet: {e}")\n        return False\n\n    # Create test config\n    config = {\n        \'input_window\': input_window,\n        \'output_window\': output_window,\n        \'patch_len\': 16,\n        \'stride\': 8,\n        \'d_model\': 128,\n        \'hidden_size\': 256,\n        \'dropout\': 0.1,\n        \'device\': torch.device(\'cuda\' if torch.cuda.is_available() else \'cpu\')\n    }\n\n    # Create test data_feature\n    data_feature = {\n        \'scaler\': None,\n        \'num_nodes\': num_nodes,\n        \'feature_dim\': 1,\n        \'output_dim\': 1\n    }\n\n    print(f"\\n📋 Test Configuration:")\n    print(f"   Nodes: {num_nodes}")\n    print(f"   Input Window: {input_window}")\n    print(f"   Output Window: {output_window}")\n    print(f"   Batch Size: {batch_size}")\n    print(f"   Device: {config[\'device\']}")\n\n    # Initialize model\n    try:\n        model = SRSNet(config, data_feature)\n        print("✅ Model initialized successfully")\n    except Exception as e:\n        print(f"❌ Failed to initialize model: {e}")\n        return False\n\n    # Create dummy batch\n    batch = {\n        \'X\': torch.randn(batch_size, input_window, num_nodes, 1, device=config[\'device\']),\n        \'y\': torch.randn(batch_size, output_window, num_nodes, 1, device=config[\'device\'])\n    }\n\n    # Test forward pass\n    try:\n        model = model.to(config[\'device\'])\n        output = model.forward(batch)\n        print(f"✅ Forward pass successful")\n        print(f"   Input shape: {batch[\'X\'].shape}")\n        print(f"   Output shape: {output.shape}")\n\n        expected_shape = (batch_size, output_window, num_nodes, 1)\n        if output.shape == expected_shape:\n            print(f"✅ Output shape matches expected: {expected_shape}")\n        else:\n            print(f"⚠️  Output shape mismatch!")\n            print(f"   Expected: {expected_shape}")\n            print(f"   Got: {output.shape}")\n            return False\n\n    except Exception as e:\n        print(f"❌ Forward pass failed: {e}")\n        import traceback\n        traceback.print_exc()\n        return False\n\n    # Test prediction\n    try:\n        pred = model.predict(batch)\n        print(f"✅ Prediction successful")\n    except Exception as e:\n        print(f"❌ Prediction failed: {e}")\n        return False\n\n    # Count parameters\n    total_params = sum(p.numel() for p in model.parameters())\n    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    print(f"\\n📊 Model Statistics:")\n    print(f"   Total parameters: {total_params:,}")\n    print(f"   Trainable parameters: {trainable_params:,}")\n\n    print("\\n" + "=" * 70)\n    print("✅ All tests passed!")\n    print("=" * 70)\n\n    return True\n\n\n# ==============================================================================\n# Hyperparameter Tuning Templates\n# ==============================================================================\n\ndef generate_hyperparam_search_configs(base_output_dir="configs/srsnet_search"):\n    """\n    Generate multiple configurations for hyperparameter search.\n    """\n\n    output_dir = Path(base_output_dir)\n    output_dir.mkdir(parents=True, exist_ok=True)\n\n    # Define search space\n    patch_lens = [8, 12, 16, 24]\n    strides = [4, 8, 12]\n    d_models = [64, 128, 256]\n    learning_rates = [0.0001, 0.0005, 0.001, 0.002]\n\n    configs_generated = 0\n\n    print(f"🔍 Generating hyperparameter search configurations...")\n    print(f"📁 Output directory: {output_dir}")\n\n    # Generate configs for different patch configurations\n    for patch_len in patch_lens:\n        for stride in strides:\n            if stride < patch_len:  # Only valid combinations\n                for d_model in d_models:\n                    config_name = f"patch{patch_len}_stride{stride}_dim{d_model}.json"\n                    config_path = output_dir / config_name\n\n                    generate_config(\n                        dataset_name="search",\n                        patch_len=patch_len,\n                        stride=stride,\n                        d_model=d_model,\n                        hidden_size=d_model * 2,\n                        learning_rate=0.001,\n                        output_path=str(config_path)\n                    )\n                    configs_generated += 1\n\n    # Generate configs for different learning rates (with best patch config)\n    for lr in learning_rates:\n        config_name = f"lr{lr}.json"\n        config_path = output_dir / config_name\n\n        generate_config(\n            dataset_name="search",\n            patch_len=16,\n            stride=8,\n            d_model=128,\n            learning_rate=lr,\n            output_path=str(config_path)\n        )\n        configs_generated += 1\n\n    print(f"\\n✅ Generated {configs_generated} configurations for hyperparameter search")\n    print(f"📝 Use these configs with: python run_model.py --model SRSNet --config_file <config_path>")\n\n\n# ==============================================================================\n# Main CLI\n# ==============================================================================\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description="SRSNet Integration Helper for LibCity",\n        formatter_class=argparse.RawDescriptionHelpFormatter,\n        epilog="""\nExamples:\n  # Quick validation test\n  python srsnet_helper.py test\n\n  # Generate config for METR_LA dataset\n  python srsnet_helper.py config --dataset METR_LA --input_window 12 --output_window 12\n\n  # Generate hyperparameter search configs\n  python srsnet_helper.py hypersearch\n        """\n    )\n\n    subparsers = parser.add_subparsers(dest=\'command\', help=\'Command to run\')\n\n    # Test command\n    test_parser = subparsers.add_parser(\'test\', help=\'Run quick validation test\')\n    test_parser.add_argument(\'--num_nodes\', type=int, default=207, help=\'Number of nodes\')\n    test_parser.add_argument(\'--input_window\', type=int, default=96, help=\'Input sequence length\')\n    test_parser.add_argument(\'--output_window\', type=int, default=96, help=\'Output sequence length\')\n    test_parser.add_argument(\'--batch_size\', type=int, default=32, help=\'Batch size\')\n\n    # Config command\n    config_parser = subparsers.add_parser(\'config\', help=\'Generate configuration file\')\n    config_parser.add_argument(\'--dataset\', type=str, default=\'METR_LA\', help=\'Dataset name\')\n    config_parser.add_argument(\'--input_window\', type=int, default=96, help=\'Input sequence length\')\n    config_parser.add_argument(\'--output_window\', type=int, default=96, help=\'Output sequence length\')\n    config_parser.add_argument(\'--patch_len\', type=int, default=16, help=\'Patch length\')\n    config_parser.add_argument(\'--stride\', type=int, default=8, help=\'Stride\')\n    config_parser.add_argument(\'--d_model\', type=int, default=128, help=\'Model dimension\')\n    config_parser.add_argument(\'--hidden_size\', type=int, default=256, help=\'Hidden size\')\n    config_parser.add_argument(\'--learning_rate\', type=float, default=0.001, help=\'Learning rate\')\n    config_parser.add_argument(\'--output\', type=str, help=\'Output file path\')\n\n    # Hyperparameter search command\n    hypersearch_parser = subparsers.add_parser(\'hypersearch\', help=\'Generate hyperparameter search configs\')\n    hypersearch_parser.add_argument(\'--output_dir\', type=str, default=\'configs/srsnet_search\',\n                                     help=\'Output directory for configs\')\n\n    args = parser.parse_args()\n\n    if args.command == \'test\':\n        quick_test(\n            num_nodes=args.num_nodes,\n            input_window=args.input_window,\n            output_window=args.output_window,\n            batch_size=args.batch_size\n        )\n\n    elif args.command == \'config\':\n        generate_config(\n            dataset_name=args.dataset,\n            input_window=args.input_window,\n            output_window=args.output_window,\n            patch_len=args.patch_len,\n            stride=args.stride,\n            d_model=args.d_model,\n            hidden_size=args.hidden_size,\n            learning_rate=args.learning_rate,\n            output_path=args.output\n        )\n\n    elif args.command == \'hypersearch\':\n        generate_hyperparam_search_configs(args.output_dir)\n\n    else:\n        parser.print_help()\n\n\nif __name__ == "__main__":\n    main()\n'}
