ndow\': 12,\n        \'d_model\': 32,\n        \'num_layer\': 2,\n        \'if_rel\': False,\n        \'res_conn\': True,\n        \'dropout\': 0.2\n    }\n\n    data_feature = {\n        \'scaler\': None,  # Will need proper scaler for real use\n        \'num_nodes\': 207,\n        \'feature_dim\': 1,\n        \'output_dim\': 1,\n        \'node_positions\': None\n    }\n\n    # Create mock scaler\n    class MockScaler:\n        def inverse_transform(self, data):\n            return data\n\n    data_feature[\'scaler\'] = MockScaler()\n\n    # Create model\n    model = STELLA(config, data_feature)\n\n    # Create dummy batch\n    batch_size = 4\n    batch = {\n        \'X\': torch.randn(batch_size, 12, 207, 1),\n        \'y\': torch.randn(batch_size, 12, 207, 1)\n    }\n\n    # Test forward\n    output = model.forward(batch)\n    print(f"✓ Forward pass successful!")\n    print(f"  Output shape: {output.shape}")\n\n    # Test predict\n    pred = model.predict(batch)\n    assert pred.shape == batch[\'y\'].shape\n    print(f"✓ Predict method successful!")\n\n    # Test loss calculation\n    loss = model.calculate_loss(batch)\n    assert loss.item() >= 0\n    print(f"✓ Loss calculation successful!")\n    print(f"  Loss value: {loss.item():.4f}")\n\n    return True\n\n\ndef test_positional_embeddings():\n    """Test positional embedding components"""\n    print("\\nTesting positional embeddings...")\n\n    from libcity.model.traffic_speed_prediction.STELLA import (\n        PositionEmbedding, SpatialEmbedding, TemporalEmbedding\n    )\n\n    batch_size = 4\n    num_nodes = 207\n    d_model = 32\n\n    # Test temporal embedding\n    temp_emb = TemporalEmbedding(d_model)\n    time_features = torch.rand(batch_size, 3)\n    temp_out = temp_emb(time_features)\n    assert temp_out.shape == (batch_size, d_model)\n    print(f"✓ Temporal embedding test passed! Shape: {temp_out.shape}")\n\n    # Test spatial embedding (learnable)\n    spatial_emb = SpatialEmbedding(d_model, num_nodes, if_rel=True)\n    dummy_pos = torch.zeros(num_nodes, 3)\n    spatial_out = spatial_emb(dummy_pos)\n    assert spatial_out.shape == (num_nodes, d_model)\n    print(f"✓ Spatial embedding test passed! Shape: {spatial_out.shape}")\n\n    # Test position embedding\n    pos_emb = PositionEmbedding(d_model, num_nodes, node_positions=None, if_rel=True)\n    x = torch.randn(batch_size, 1, num_nodes, d_model)\n    pos_out = pos_emb(x, time_features)\n    assert pos_out.shape == x.shape\n    print(f"✓ Position embedding test passed! Shape: {pos_out.shape}")\n\n    return True\n\n\ndef test_with_node_positions():\n    """Test STELLA with actual node positions"""\n    print("\\nTesting with node positions...")\n\n    # Generate random node positions (latitude, longitude, altitude)\n    num_nodes = 207\n    node_positions = np.random.randn(num_nodes, 3)\n\n    # Model parameters\n    config = {\n        \'device\': torch.device(\'cpu\'),\n        \'input_window\': 12,\n        \'output_window\': 12,\n        \'d_model\': 32,\n        \'num_layer\': 2,\n        \'if_rel\': False,  # Use actual positions\n        \'res_conn\': True,\n        \'dropout\': 0.2\n    }\n\n    data_feature = {\n        \'scaler\': None,\n        \'num_nodes\': num_nodes,\n        \'feature_dim\': 1,\n        \'output_dim\': 1,\n        \'node_positions\': node_positions\n    }\n\n    class MockScaler:\n        def inverse_transform(self, data):\n            return data\n\n    data_feature[\'scaler\'] = MockScaler()\n\n    # Create model\n    model = STELLA(config, data_feature)\n\n    # Create batch\n    batch = {\n        \'X\': torch.randn(4, 12, num_nodes, 1),\n        \'y\': torch.randn(4, 12, num_nodes, 1)\n    }\n\n    # Forward pass\n    output = model.forward(batch)\n    print(f"✓ Model with node positions test passed!")\n    print(f"  Output shape: {output.shape}")\n\n    return True\n\n\ndef run_all_tests():\n    """Run all tests"""\n    print("="*60)\n    print("Running STELLA Model Tests")\n    print("="*60)\n\n    tests = [\n        ("STELLACore", test_stella_core),\n        ("STELLA LibCity Interface", test_stella_libcity),\n        ("Positional Embeddings", test_positional_embeddings),\n        ("Node Positions", test_with_node_positions)\n    ]\n\n    passed = 0\n    failed = 0\n\n    for test_name, test_func in tests:\n        try:\n            result = test_func()\n            if result:\n                passed += 1\n        except Exception as e:\n            print(f"✗ {test_name} failed: {str(e)}")\n            import traceback\n            traceback.print_exc()\n            failed += 1\n\n    print("\\n" + "="*60)\n    print(f"Test Results: {passed} passed, {failed} failed")\n    print("="*60)\n\n    return failed == 0\n\n\nif __name__ == "__main__":\n    success = run_all_tests()\n    sys.exit(0 if success else 1)\n'}
