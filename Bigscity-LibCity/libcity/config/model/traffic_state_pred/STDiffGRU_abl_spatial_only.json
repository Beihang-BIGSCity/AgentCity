{
  "hidden_dim": 32,
  "num_layers": 1,
  "dropout": 0.0,
  "num_diffusion_steps": 2,
  "loss_type": "masked_mae",
  "null_value": 0,
  "scaler": "standard",
  "load_external": true,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": true,
  "add_day_in_week": false,
  "max_epoch": 1,
  "learner": "adam",
  "learning_rate": 0.01,
  "lr_decay": true,
  "lr_scheduler": "multisteplr",
  "lr_decay_ratio": 0.1,
  "steps": [
    5,
    20,
    40,
    70
  ],
  "clip_grad_norm": true,
  "max_grad_norm": 5,
  "use_early_stop": true,
  "patience": 50,
  "temporal_module": "none",
  "spatial_module": "diffusion_gcn",
  "_ablation": "single-branch ablation of the STDiffGRU composition: temporal branch disabled (spatial/DiffusionGCN only)"
}
