{
  "model_name": "CPiRi",

  "input_window": 12,
  "output_window": 12,
  "input_dim": 1,
  "output_dim": 1,

  "spital_num_layers": 4,
  "revin": false,
  "from_pretrain": true,
  "hidden_size": 256,
  "dropout": 0.3,
  "num_attention_heads": 8,
  "intermediate_size": 1024,
  "null_val": 0.0,

  "use_external_sundial": false,
  "external_sundial_arch_dir": "",
  "external_sundial_ckpt": "",
  "freeze_temporal_encoder": true,
  "temporal_encoder_ckpt": "",

  "scaler": "standard",
  "load_external": false,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": false,
  "add_day_in_week": false,

  "max_epoch": 50,
  "batch_size": 8,
  "learner": "adam",
  "learning_rate": 0.001,
  "weight_decay": 0.00001,
  "lr_epsilon": 1e-8,
  "lr_decay": true,
  "lr_scheduler": "multisteplr",
  "lr_decay_ratio": 0.5,
  "steps": [10, 25, 40],
  "clip_grad_norm": true,
  "max_grad_norm": 5,
  "use_early_stop": true,
  "patience": 20
}
