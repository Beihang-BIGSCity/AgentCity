{
  "input_window": 12,
  "output_window": 12,

  "input_dim": 1,
  "output_dim": 1,

  "in_channel": 12,
  "hidden_channel": 192,
  "out_channel": 12,
  "head": 1,
  "dropout": 0.0,

  "scaler": "standard",
  "load_external": false,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": false,
  "add_day_in_week": false,

  "max_epoch": 100,
  "batch_size": 64,
  "learner": "adamw",
  "learning_rate": 0.001,
  "weight_decay": 0,
  "lr_decay": false,
  "clip_grad_norm": true,
  "max_grad_norm": 5,
  "use_early_stop": true,
  "patience": 30
}
