{
  "input_window": 12,
  "output_window": 12,
  "batch_size": 64,

  "first_layer_embedding_size": 64,
  "filters": [
    [64, 64, 64],
    [64, 64, 64],
    [64, 64, 64]
  ],
  "act_type": "GLU",
  "module_type": "individual",
  "use_mask": true,
  "temporal_emb": true,
  "spatial_emb": true,
  "strides": 4,
  "rho": 1.0,
  "out_layer_dim": 128,
  "adj_dtw_default": "identity",

  "scaler": "standard",
  "load_external": false,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": false,
  "add_day_in_week": false,

  "max_epoch": 100,
  "learner": "adam",
  "learning_rate": 0.001,
  "lr_decay": false,
  "clip_grad_norm": false,
  "use_early_stop": false
}
