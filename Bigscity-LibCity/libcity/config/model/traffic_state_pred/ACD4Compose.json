{
  "hidden_dim": 32,
  "depth": 1,
  "input_channels": 1,
  "encoder_module": "feature_embedding_encoder",
  "spatial_module": "adaptive_gcn",
  "temporal_module": "gated_dilated_tcn",
  "fusion_module": "concat",
  "head_module": "linear_head",
  "spatial_embed_dim": 10,
  "spatial_ks": 2,
  "spatial_use_prior_adj": false,
  "temporal_layers": 3,
  "temporal_kernel_size": 2,
  "temporal_base_dilation": 2,
  "dropout": 0.0,
  "input_window": 12,
  "output_window": 12,
  "output_dim": 1,
  "loss_type": "masked_mae",
  "null_value": 0,
  "dataset": "PEMSD4",
  "task": "traffic_state_pred",
  "data_col": [
    "traffic_flow"
  ],
  "add_time_in_day": true,
  "add_day_in_week": false,
  "load_external": false,
  "cache_dataset": false,
  "scaler": "standard",
  "train_rate": 0.6,
  "eval_rate": 0.2,
  "learning_rate": 0.01,
  "learner": "adam",
  "max_epoch": 1,
  "batch_size": 128,
  "clip_grad_norm": true,
  "max_grad_norm": 5,
  "use_early_stop": false,
  "lr_decay": false,
  "lr_scheduler": "none",
  "gpu": true,
  "gpu_id": 0,
  "gpu_id_note": "int 0, NOT the string '0': libcity/config/config_parser.py::_init_device passes gpu_id straight into torch.cuda.set_device(gpu_id) and torch.device('cuda:{gpu_id}'), which raise RuntimeError: Invalid device string: '0'. run_model.py's --gpu_id argument is type=int too. Same physical GPU index as the requested '0'."
}
