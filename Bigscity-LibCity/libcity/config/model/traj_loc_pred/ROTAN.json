{
    "model": "ROTAN",
    "poi_embed_dim": 128,
    "user_embed_dim": 128,
    "gps_embed_dim": 128,
    "time_embed_dim": 64,
    "cat_embed_dim": 128,
    "gcn_nhid": [32, 64],
    "gcn_dropout": 0.3,
    "transformer_nhid": 1024,
    "transformer_nlayers": 4,
    "transformer_nhead": 2,
    "transformer_dropout": 0.3,
    "node_attn_nhid": 128,
    "quadkey_n": 6,
    "quadkey_len": 25,
    "hour_weight": 0.7,
    "day_weight": 0.3,
    "encoder1_weight": 0.7,
    "encoder2_weight": 0.3,
    "time_loss_weight": 10,
