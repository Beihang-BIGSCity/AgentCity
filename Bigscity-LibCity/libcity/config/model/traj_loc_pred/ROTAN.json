    "time_units": 96,
    "cut_method": "time_interval",
    "window_size": 50,
    "batch_size": 128,
    "learning_rate": 0.001,
    "max_epoch": 60,
    "L2": 0.0008,
    "clip": 5.0,
    "optimizer": "adam",
    "lr_scheduler": "ReduceLROnPlateau",
    "lr_step": 5,
    "lr_decay": 0.1,
    "lr_scheduler_factor": 0.1,
    "warmup_lr_init": 0.0001,
    "weight_decay": 0.0008,
    "poi_pre_embedding": null,
    "time_pre_embedding": null,
    "poi_time_embed_state_dict": null,
    "poi_time_tgt_embed_state_dict": null,
