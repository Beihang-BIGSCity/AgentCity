{
  "dropout": 0.0,
  "rank": 6,

  "gcn_in_channel": 12,
  "gcn_hidden_channel": 64,
  "gcn_out_channel": 12,

  "tcn_kernel_size": 3,
  "tcn_dilation": 1,

  "input_window": 12,
  "output_window": 12,

  "scaler": "standard",
  "load_external": false,
  "normal_external": false,
  "ext_scaler": "none",
  "add_time_in_day": false,
  "add_day_in_week": false,

  "max_epoch": 100,
  "learner": "adam",
  "learning_rate": 0.03,
  "lr_decay": true,
  "lr_scheduler": "steplr",
  "lr_decay_ratio": 0.5,
  "lr_step_size": 10,
  "clip_grad_norm": false,
  "use_early_stop": false,
  "patience": 50,

  "batch_size": 64,
  "log_level": "INFO",
  "log_batch": 20
}
