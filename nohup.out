[STD-MAE:tuning] 2026-01-22 18:30:24 | INFO | Tool Bash called with {'command': 'cat > /tmp/stdmae_tuning.py << \'EOF\'\n"""\nSTD-MAE Hyperparameter Tuning Script\nExecutes Phase 1 grid search with 18 trials\n"""\n\nimport json\nimport os\nimport sys\nimport time\nimport itertools\nimport subprocess\nfrom datetime import datetime\nfrom pathlib import Path\nimport shutil\n\n# Add LibCity to path\nlibcity_path = "/home/wangwenrui/private/shk/agentCity/Bigscity-LibCity"\nsys.path.insert(0, libcity_path)\n\nclass STDMAETuner:\n    def __init__(self, libcity_root):\n        self.libcity_root = libcity_root\n        self.config_path = os.path.join(libcity_root, "libcity/config/model/traffic_state_pred/STDMAE.json")\n        self.base_config_path = os.path.join(libcity_root, "libcity/config/model/traffic_state_pred")\n        self.results = []\n        self.timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")\n        self.output_dir = f"/tmp/stdmae_tuning_{self.timestamp}"\n        Path(self.output_dir).mkdir(parents=True, exist_ok=True)\n        \n    def load_base_config(self):\n        """Load the base STD-MAE configuration"""\n        with open(self.config_path, \'r\') as f:\n            return json.load(f)\n    \n    def create_search_space(self):\n        """Create Phase 1 search space - 18 trials"""\n        return {\n            "learning_rate": [0.0005, 0.001, 0.002],\n            "batch_size": [32, 64],\n            "dropout": [0.0, 0.1, 0.2],\n            "residual_channels": [32],\n            "skip_channels": [256]\n        }\n    \n    def create_fixed_params(self):\n        """Fixed parameters for all trials"""\n        return {\n            "patch_size": 12,\n            "encoder_depth": 4,\n            "decoder_depth": 1,\n            "num_heads": 4,\n            "mask_ratio": 0.25,\n            "embed_dim": 96,\n            "long_history_window": 864,\n            "blocks": 4,\n            "layers": 2,\n            "max_epoch": 100,\n            "mlp_ratio": 4\n        }\n    \n    def generate_trials(self):\n        """Generate all trial combinations"""\n        search_space = self.create_search_space()\n        fixed = self.create_fixed_params()\n        \n        # Generate all combinations\n        param_names = list(search_space.keys())\n        param_values = [search_space[k] for k in param_names]\n        \n        trials = []\n        for combination in itertools.product(*param_values):\n            trial_params = dict(zip(param_names, combination))\n            trial_params.update(fixed)\n            trials.append(trial_params)\n        \n        return trials\n    \n    def run_trial(self, trial_id, params):\n        """Execute a single trial"""\n        base_config = self.load_base_config()\n        base_config.update(params)\n        \n        trial_dir = os.path.join(self.output_dir, f"trial_{trial_id}")\n        Path(trial_dir).mkdir(parents=True, exist_ok=True)\n        \n        # Save config for this trial\n        config_file = os.path.join(trial_dir, "config.json")\n        with open(config_file, \'w\') as f:\n            json.dump(base_config, f, indent=2)\n        \n        # Copy to standard location temporarily\n        backup_config = self.config_path + ".backup"\n        shutil.copy(self.config_path, backup_config)\n        \n        try:\n            shutil.copy(config_file, self.config_path)\n            \n            print(f"\\n{\'=\'*80}")\n            print(f"Trial {trial_id}: Starting")\n            print(f"{\'=\'*80}")\n            print(f"Learning Rate: {params.get(\'learning_rate\', \'N/A\')}")\n            print(f"Batch Size: {params.get(\'batch_size\', \'N/A\')}")\n            print(f"Dropout: {params.get(\'dropout\', \'N/A\')}")\n            print(f"Residual Channels: {params.get(\'residual_channels\', \'N/A\')}")\n            print(f"Skip Channels: {params.get(\'skip_channels\', \'N/A\')}")\n            print(f"Config saved to: {config_file}")\n            print(f"Trial dir: {trial_dir}")\n            \n            # Run training using run_model.py\n            run_script = os.path.join(self.libcity_root, "run_model.py")\n            cmd = [\n                "python", run_script,\n                "--task", "traffic_state_pred",\n                "--model", "STDMAE",\n                "--dataset", "METR_LA",\n                "--gpu", "0",\n                "--batch_size", str(params.get(\'batch_size\', 64)),\n                "--train", "True",\n                "--saved_model", "True"\n            ]\n            \n            start_time = time.time()\n            result = subprocess.run(cmd, cwd=self.libcity_root, capture_output=True, text=True, timeout=7200)\n            elapsed_time = time.time() - start_time\n            \n            # Parse results\n            trial_result = {\n                "trial_id": trial_id,\n                "params": params,\n                "elapsed_time": elapsed_time,\n                "status": "completed" if result.returncode == 0 else "failed",\n                "stdout": result.stdout[-2000:] if result.stdout else "",\n                "stderr": result.stderr[-2000:] if result.stderr else ""\n            }\n            \n            # Try to extract metrics from output\n            if result.returncode == 0:\n                print(f"Trial {trial_id}: COMPLETED in {elapsed_time:.1f}s")\n            else:\n                print(f"Trial {trial_id}: FAILED")\n                print(f"Error: {result.stderr[-500:]}")\n            \n            self.results.append(trial_result)\n            return trial_result\n            \n        except subprocess.TimeoutExpired:\n            trial_result = {\n                "trial_id": trial_id,\n                "params": params,\n                "elapsed_time": 7200,\n                "status": "timeout",\n                "stdout": "",\n                "stderr": "Trial timed out after 2 hours"\n            }\n            self.results.append(trial_result)\n            print(f"Trial {trial_id}: TIMEOUT")\n            return trial_result\n        \n        except Exception as e:\n            trial_result = {\n                "trial_id": trial_id,\n                "params": params,\n                "elapsed_time": 0,\n                "status": "error",\n                "stdout": "",\n                "stderr": str(e)\n            }\n            self.results.append(trial_result)\n            print(f"Trial {trial_id}: ERROR - {e}")\n            return trial_result\n        \n        finally:\n            # Restore backup\n            if os.path.exists(backup_config):\n                shutil.move(backup_config, self.config_path)\n    \n    def execute_phase1(self, max_trials=None):\n        """Execute Phase 1 tuning"""\n        trials = self.generate_trials()\n        \n        if max_trials:\n            trials = trials[:max_trials]\n        \n        print(f"\\n{\'=\'*80}")\n        print(f"STD-MAE Phase 1 Hyperparameter Tuning")\n        print(f"{\'=\'*80}")\n        print(f"Total Trials: {len(trials)}")\n        print(f"Output Directory: {self.output_dir}")\n        print(f"{\'=\'*80}\\n")\n        \n        for trial_id, params in enumerate(trials, 1):\n            try:\n                self.run_trial(trial_id, params)\n            except KeyboardInterrupt:\n                print(f"\\nTuning interrupted at trial {trial_id}")\n                break\n            except Exception as e:\n                print(f"Error in trial {trial_id}: {e}")\n                continue\n        \n        return self.results\n    \n    def save_results(self):\n        """Save all results to JSON"""\n        results_file = os.path.join(self.output_dir, "tuning_results.json")\n        with open(results_file, \'w\') as f:\n            json.dump({\n                "timestamp": self.timestamp,\n                "total_trials": len(self.results),\n                "output_dir": self.output_dir,\n                "results": self.results\n            }, f, indent=2)\n        \n        print(f"\\nResults saved to: {results_file}")\n        return results_file\n    \n    def print_summary(self):\n        """Print summary of tuning results"""\n        print(f"\\n{\'=\'*80}")\n        print(f"STD-MAE Tuning Summary")\n        print(f"{\'=\'*80}")\n        print(f"Total Trials: {len(self.results)}")\n        \n        completed = sum(1 for r in self.results if r.get(\'status\') == \'completed\')\n        failed = sum(1 for r in self.results if r.get(\'status\') == \'failed\')\n        timeout = sum(1 for r in self.results if r.get(\'status\') == \'timeout\')\n        error = sum(1 for r in self.results if r.get(\'status\') == \'error\')\n        \n        print(f"Completed: {completed}")\n        print(f"Failed: {failed}")\n        print(f"Timeout: {timeout}")\n        print(f"Error: {error}")\n        \n        if self.results:\n            avg_time = sum(r.get(\'elapsed_time\', 0) for r in self.results) / len(self.results)\n            print(f"Average Time per Trial: {avg_time:.1f}s")\n        \n        print(f"{\'=\'*80}\\n")\n\n\nif __name__ == "__main__":\n    tuner = STDMAETuner(libcity_path)\n    \n    # Execute Phase 1\n    print("Initializing STD-MAE Tuner...")\n    tuner.execute_phase1()\n    tuner.save_results()\n    tuner.print_summary()\n    \n    print(f"\\nTuning output directory: {tuner.output_dir}")\nEOF\npython /tmp/stdmae_tuning.py\n', 'description': 'Create and execute STD-MAE tuning script', 'timeout': 300000}
