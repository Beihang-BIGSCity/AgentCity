temp_dim_tid\': 64,\n            \'temp_dim_diw\': 64,\n            \'if_spatial\': True,\n            \'if_time_in_day\': True,\n            \'if_day_in_week\': True,\n            \'if_dne\': False,  # Disable DNE for faster testing\n            \'info_beta\': 0.001,\n            \'n_sample\': 1,\n            \'n_sample_avg\': 12,\n            \'use_difficulty_weighting\': False,\n            \'use_ib_loss\': True,\n            \'time_intervals\': 300,\n        }\n        \n        # Create minimal data_feature for METR_LA\n        data_feature = {\n            \'num_nodes\': 207,  # METR_LA has 207 nodes\n            \'feature_dim\': 1,\n            \'output_dim\': 1,\n            \'scaler\': MockScaler(),  # Simple scaler mock\n        }\n        \n        print(f"Config: num_nodes={data_feature[\'num_nodes\']}, device={config[\'device\']}")\n        \n        # Initialize model\n        model = RSTIB(config, data_feature)\n        print(f"[PASS] Model initialized successfully")\n        \n        # Check parameters\n        num_params = sum(p.numel() for p in model.parameters())\n        print(f"[INFO] Total parameters: {num_params:,}")\n        \n        # Check device placement\n        device_check = next(model.parameters()).device\n        print(f"[INFO] Model device: {device_check}")\n        \n        # Verify key components\n        assert hasattr(model, \'encoder\'), "Missing encoder"\n        assert hasattr(model, \'regression_layer\'), "Missing regression_layer"\n        assert hasattr(model, \'node_emb\'), "Missing node_emb"\n        assert hasattr(model, \'time_in_day_emb\'), "Missing time_in_day_emb"\n        print("[PASS] All key components present")\n        \n        return True, model, config, data_feature\n        \n    except Exception as e:\n        print(f"[FAIL] Initialization error: {str(e)}")\n        import traceback\n        traceback.print_exc()\n        return False, None, None, None\n\n\ndef test_3_forward_pass():\n    """Test 3: Forward Pass Test"""\n    print("\\n" + "=" * 80)\n    print("TEST 3: FORWARD PASS TEST")\n    print("=" * 80)\n    \n    try:\n        from libcity.model.traffic_speed_prediction.RSTIB import RSTIB\n        \n        # Get model from test 2\n        success, model, config, data_feature = test_2_initialization()\n        if not success:\n            return False\n        \n        model.eval()\n        \n        # Create dummy batch data matching LibCity format\n        B, L, N, output_window = 4, 12, 207, 12\n        \n        # X: [B, L, N, C] where C includes [speed, time_in_day, day_in_week]\n        X = torch.randn(B, L, N, 3)  # 3 features: speed, time_in_day, day_in_week\n        \n        # Normalize time features to valid ranges\n        X[..., 1] = torch.rand(B, L, N) * 0.99  # time_in_day: 0-1 (normalized)\n        X[..., 2] = torch.randint(0, 7, (B, L, N)).float()  # day_in_week: 0-6\n        \n        # y: [B, output_window, N, 1]\n        y = torch.randn(B, output_window, N, 1)\n        \n        batch = {\'X\': X, \'y\': y}\n        \n        print(f"[INFO] Input shape: {X.shape}")\n        print(f"[INFO] Input features: speed (0), time_in_day (1), day_in_week (2)")\n        \n        with torch.no_grad():\n            output = model(batch)\n        \n        expected_shape = (B, output_window, N, data_feature[\'output_dim\'])\n        print(f"[INFO] Output shape: {output.shape}")\n        print(f"[INFO] Expected shape: {expected_shape}")\n        \n        # Check output shape\n        assert output.shape == expected_shape, f"Shape mismatch: {output.shape} vs {expected_shape}"\n        print(f"[PASS] Output shape is correct: {output.shape}")\n        \n        # Check for NaN/Inf\n        assert not torch.isnan(output).any(), "Output contains NaN values"\n        assert not torch.isinf(output).any(), "Output contains Inf values"\n        print("[PASS] No NaN/Inf values in output")\n        \n        # Check output statistics\n        print(f"[INFO] Output stats: mean={output.mean():.4f}, std={output.std():.4f}, "\n              f"min={output.min():.4f}, max={output.max():.4f}")\n        \n        return True\n        \n    except Exception as e:\n        print(f"[FAIL] Forward pass error: {str(e)}")\n        import traceback\n        traceback.print_exc()\n        return False\n\n\ndef test_4_loss_calculation():\n    """Test 4: Loss Calculation Test"""\n    print("\\n" + "=" * 80)\n    print("TEST 4: LOSS CALCULATION TEST")\n    print("=" * 80)\n    \n    try:\n        from libcity.model.traffic_speed_prediction.RSTIB import RSTIB\n        \n        # Get model from test 2\n        success, model, config, data_feature = test_2_initialization()\n        if not success:\n            return False\n        \n        model.train()\n        \n        # Create dummy batch\n        B, L, N, output_window = 4, 12, 207, 12\n        X = torch.randn(B, L, N, 3)\n        X[..., 1] = torch.rand(B, L, N) * 0.99\n        X[..., 2] = torch.randint(0, 7, (B, L, N)).float()\n        y = torch.randn(B, output_window, N, 1)\n        \n        batch = {\'X\': X, \'y\': y}\n        \n        # Calculate loss\n        loss = model.calculate_loss(batch)\n        \n        print(f"[INFO] Loss value: {loss.item():.6f}")\n        \n        # Check loss is scalar\n        assert loss.dim() == 0, f"Loss should be scalar, got shape {loss.shape}"\n        print("[PASS] Loss is a scalar")\n        \n        # Check loss is finite\n        assert torch.isfinite(loss), "Loss is not finite"\n        print("[PASS] Loss is finite")\n        \n        # Check loss is positive (MAE/MSE based)\n        assert loss.item() > 0, f"Loss should be positive, got {loss.item()}"\n        print("[PASS] Loss is positive")\n        \n        # Test gradient computation\n        loss.backward()\n        \n        # Check gradients exist\n        has_grads = False\n        grad_count = 0\n        for name, param in model.named_parameters():\n            if param.grad