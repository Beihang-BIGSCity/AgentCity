dim\': 1,\n            \'output_dim\': 1,\n            \'scaler\': MockScaler(),\n        }\n\n        model = RSTIB(config, data_feature)\n        print(f"✓ PASS: Model initialized with {sum(p.numel() for p in model.parameters()):,} parameters")\n        return True, model\n    except Exception as e:\n        print(f"✗ FAIL: Initialization error: {e}")\n        traceback.print_exc()\n        return False, None\n\n\ndef test_forward_pass(model):\n    """Test 3: Forward Pass (Bug Fix #2 verification)"""\n    print("\\n" + "="*80)\n    print("TEST 3: FORWARD PASS (Bug Fix #2 - Device Placement)")\n    print("="*80)\n    try:\n        B, L, N, output_window = 4, 12, 207, 12\n        X = torch.randn(B, L, N, 3)\n        X[..., 1] = torch.rand(B, L, N) * 0.99\n        X[..., 2] = torch.randint(0, 7, (B, L, N)).float()\n        y = torch.randn(B, output_window, N, 1)\n\n        batch = {\'X\': X, \'y\': y}\n\n        with torch.no_grad():\n            output = model(batch)\n\n        print(f"  Input shape: {X.shape}")\n        print(f"  Output shape: {output.shape}")\n        assert output.shape == (B, output_window, N, 1), f"Wrong output shape: {output.shape}"\n        print("✓ PASS: Forward pass successful, device placement correct")\n        return True, batch\n    except Exception as e:\n        print(f"✗ FAIL: Forward pass error: {e}")\n        traceback.print_exc()\n        return False, None\n\n\ndef test_loss_calculation(model, batch):\n    """Test 4: Loss Calculation (Bug Fix #1 verification)"""\n    print("\\n" + "="*80)\n    print("TEST 4: LOSS CALCULATION (Bug Fix #1 - Tensor Shape)")\n    print("="*80)\n    try:\n        model.train()\n        loss = model.calculate_loss(batch)\n\n        print(f"  Loss value: {loss.item():.6f}")\n        assert torch.isfinite(loss), "Loss is not finite"\n        print("✓ PASS: Loss calculation successful, tensor shapes correct")\n        return True\n    except Exception as e:\n        print(f"✗ FAIL: Loss calculation error: {e}")\n        traceback.print_exc()\n        return False\n\n\ndef test_backward_pass(model, batch):\n    """Test 5: Backward Pass"""\n    print("\\n" + "="*80)\n    print("TEST 5: BACKWARD PASS")\n    print("="*80)\n    try:\n        model.train()\n        loss = model.calculate_loss(batch)\n        loss.backward()\n\n        # Check that gradients exist\n        has_grad = any(p.grad is not None for p in model.parameters() if p.requires_grad)\n        assert has_grad, "No gradients computed"\n\n        print("✓ PASS: Backward pass successful, gradients computed")\n        return True\n    except Exception as e:\n        print(f"✗ FAIL: Backward pass error: {e}")\n        traceback.print_exc()\n        return False\n\n\ndef test_dne_feature(RSTIB):\n    """Test 6: DNE Feature (Bug Fix #3 verification)"""\n    print("\\n" + "="*80)\n    print("TEST 6: DNE FEATURE (Bug Fix #3 - Batch Key Check)")\n    print("="*80)\n    try:\n        config = {\n            \'device\': torch.device(\'cpu\'),\n            \'input_window\': 12,\n            \'output_window\': 12,\n            \'input_dim\': 1,\n            \'embed_dim\': 64,\n            \'num_layer\': 2,\n            \'node_dim\': 64,\n            \'temp_dim_tid\': 64,\n            \'temp_dim_diw\': 64,\n            \'if_spatial\': True,\n            \'if_time_in_day\': True,\n            \'if_day_in_week\': True,\n            \'if_dne\': True,  # Enable DNE\n            \'mid_dim\': 64,\n            \'dne_act\': \'softmax\',\n            \'info_beta\': 0.001,\n            \'n_sample\': 1,\n            \'n_sample_avg\': 12,\n            \'use_difficulty_weighting\': False,\n            \'use_ib_loss\': True,\n            \'time_intervals\': 300,\n        }\n\n        data_feature = {\n            \'num_nodes\': 207,\n            \'feature_dim\': 1,\n            \'output_dim\': 1,\n            \'scaler\': MockScaler(),\n        }\n\n        model = RSTIB(config, data_feature)\n\n        # Test without \'te\' key (should gracefully skip DNE)\n        B, L, N, output_window = 4, 12, 207, 12\n        X = torch.randn(B, L, N, 3)\n        y = torch.randn(B, output_window, N, 1)\n        batch_no_te = {\'X\': X, \'y\': y}\n\n        with torch.no_grad():\n            output = model(batch_no_te)\n\n        print("  Test 6a: Without \'te\' key - ✓ PASS (graceful skip)")\n\n        # Test with \'te\' key (should use DNE)\n        batch_with_te = {\n            \'X\': X,\n            \'y\': y,\n            \'te\': torch.randint(0, 288, (B, L))  # Time encoding\n        }\n\n        with torch.no_grad():\n            output = model(batch_with_te)\n\n        print("  Test 6b: With \'te\' key - ✓ PASS (DNE used)")\n        print("✓ PASS: DNE feature works correctly with and without \'te\' key")\n        return True\n    except Exception as e:\n        print(f"✗ FAIL: DNE feature error: {e}")\n        traceback.print_exc()\n        return False\n\n\ndef main():\n    """Run all verification tests"""\n    print("\\n" + "#"*80)\n    print("# RSTIB BUG FIXES VERIFICATION")\n    print("# Testing all three critical bug fixes")\n    print("#"*80)\n\n    results = []\n\n    # Test 1: Import\n    success, RSTIB = test_import()\n    results.append(("Import", success))\n    if not success:\n        print("\\n❌ CRITICAL: Cannot proceed without successful import")\n        return False\n\n    # Test 2: Initialization\n    success, model = test_initialization(RSTIB)\n    results.append(("Initialization", success))\n    if not success:\n        print("\\n❌ CRITICAL: Cannot proceed without successful initialization")\n        return False\n\n    # Test 3: Forward Pass (Bug Fix #2)\n    success, batch = test_forward_pass(model)\n    results.append(("Forward Pass (Fix #2)", success))\n    if not success:\n        print("\\n❌ CRITICAL: Forward pass failed")\n        return False\n\n    # Test 4: Loss Calculation (Bug Fix #1)\n    success = test_loss_calculation(model, batch)\n    results.append(("Loss Calculation (Fix #1)", success))\n\n    # Test 5: Backward Pass\n    success = test_backward_pass(model, batch)\n    results.append(("Backward Pass", success))\n\n    # Test 6: DNE Feature (Bug Fix #3)\n    success = test_dne_feature(RSTIB)\n    results.append(("DNE Feature (Fix #3)", success))\n\n    # Summary\n    print("\\n" + "="*80)\n    print("VERIFICATION SUMMARY")\n    print("="*80)\n\n    for test_name, success in results:\n        status = "✓ PASS" if success else "✗ FAIL"\n        print(f"{test_name:.<50} {status}")\n\n    all_passed = all(success for _, success in results)\n\n    print("\\n" + "="*80)\n    if all_passed:\n        print("🎉 ALL TESTS PASSED! 🎉")\n        print("All three bug fixes are working correctly:")\n        print("  ✓ Bug Fix #1: Tensor shape mismatch resolved")\n        print("  ✓ Bug Fix #2: Device placement error fixed")\n        print("  ✓ Bug Fix #3: Batch key check error resolved")\n    else:\n        print("❌ SOME TESTS FAILED")\n        failed = [name for name, success in results if not success]\n        print(f"Failed tests: {\', \'.join(failed)}")\n    print("="*80)\n\n    return all_passed\n\n\nif __name__ == \'__main__\':\n    success = main()\n    sys.exit(0 if success else 1)\n'}
