Exception as e:\n        print(f"❌ Forward pass failed: {e}")\n        import traceback\n        traceback.print_exc()\n        return False\n\ndef test_loss_calculation():\n    """Test if loss calculation works."""\n    print("\\n" + "=" * 60)\n    print("Test 4: Loss calculation")\n    print("=" * 60)\n    try:\n        from libcity.model.traffic_speed_prediction.RSTIB import RSTIB\n\n        # Mock config\n        class MockConfig:\n            def get(self, key, default=None):\n                config_dict = {\n                    \'input_window\': 12,\n                    \'output_window\': 12,\n                    \'device\': torch.device(\'cpu\'),\n                    \'input_dim\': 1,\n                    \'embed_dim\': 64,\n                    \'num_layer\': 3,\n                    \'node_dim\': 64,\n                    \'temp_dim_tid\': 64,\n                    \'temp_dim_diw\': 64,\n                    \'if_spatial\': True,\n                    \'if_time_in_day\': True,\n                    \'if_day_in_week\': True,\n                    \'if_dne\': False,\n                    \'info_beta\': 0.001,\n                    \'n_sample\': 1,\n                    \'n_sample_avg\': 12,\n                    \'use_difficulty_weighting\': False,\n                    \'use_ib_loss\': True,\n                    \'time_intervals\': 300,\n                }\n                return config_dict.get(key, default)\n\n        # Mock data_feature with scaler\n        class MockScaler:\n            def inverse_transform(self, data):\n                return data\n\n        class MockDataFeature:\n            def get(self, key, default=None):\n                data_dict = {\n                    \'num_nodes\': 207,\n                    \'feature_dim\': 3,\n                    \'output_dim\': 1,\n                    \'scaler\': MockScaler(),\n                }\n                return data_dict.get(key, default)\n\n        config = MockConfig()\n        data_feature = MockDataFeature()\n\n        model = RSTIB(config, data_feature)\n        model.train()\n\n        # Create mock batch\n        batch_size = 4\n        num_nodes = 207\n        input_window = 12\n        output_window = 12\n        feature_dim = 3\n\n        X = torch.randn(batch_size, input_window, num_nodes, feature_dim)\n        y = torch.randn(batch_size, output_window, num_nodes, 1)\n        batch = {\'X\': X, \'y\': y}\n\n        # Calculate loss\n        loss = model.calculate_loss(batch)\n\n        print(f"✅ Loss calculation successful!")\n        print(f"   - Loss value: {loss.item():.4f}")\n        print(f"   - Loss is finite: {torch.isfinite(loss).item()}")\n        print(f"   - Loss requires grad: {loss.requires_grad}")\n\n        # Check loss properties\n        assert torch.isfinite(loss).item(), "Loss is not finite!"\n        assert loss.requires_grad, "Loss does not require gradients!"\n        print(f"   - Loss validation: PASSED ✓")\n\n        return True\n    except Exception as e:\n        print(f"❌ Loss calculation failed: {e}")\n        import traceback\n        traceback.print_exc()\n        return False\n\ndef main():\n    """Run all tests."""\n    print("\\n" + "🔧 RSTIB Model Adaptation Verification Tests 🔧".center(60))\n    print()\n\n    results = []\n    results.append(("Import Test", test_import()))\n    results.append(("Initialization Test", test_initialization()))\n    results.append(("Forward Pass Test", test_forward_pass()))\n    results.append(("Loss Calculation Test", test_loss_calculation()))\n\n    # Summary\n    print("\\n" + "=" * 60)\n    print("Test Summary")\n    print("=" * 60)\n    for name, result in results:\n        status = "✅ PASSED" if result else "❌ FAILED"\n        print(f"{name:<30} {status}")\n\n    print("\\n" + "=" * 60)\n    if all(r[1] for r in results):\n        print("🎉 All tests passed! RSTIB model is ready for use.")\n    else:\n        print("⚠️  Some tests failed. Please review the errors above.")\n    print("=" * 60)\n