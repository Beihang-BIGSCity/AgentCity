rid search with GPU acceleration\n    print("Starting grid search...")\n    print("=" * 80)\n    \n    try:\n        result = run_custom_grid_search(\n            repo_dir=repo_dir,\n            model_name="RSTIB",\n            dataset_name="METR_LA",\n            search_space=search_space,\n            task="traffic_state_pred",\n            config_file=None,\n            max_trials=None,  # No limit\n            gpu_id="0",  # Use GPU 0 for acceleration\n        )\n        \n        # Save results to file\n        results_file = Path("/home/wangwenrui/private/shk/agentCity/RSTIB_tuning_results.json")\n        with open(results_file, "w") as f:\n            json.dump(result, f, indent=2)\n        \n        print("\\n" + "=" * 80)\n        print("TUNING RESULTS")\n        print("=" * 80)\n        print(f"Strategy: {result.get(\'strategy\')}")\n        print(f"Status: {result.get(\'status\')}")\n        print(f"Best params: {json.dumps(result.get(\'best_params\', {}), indent=2)}")\n        print(f"Best metrics: {json.dumps(result.get(\'best_metrics\', {}), indent=2)}")\n        \n        trials = result.get(\'trials\', [])\n        print(f"Total trials completed: {len(trials)}")\n        \n        if trials:\n            print("\\nTop 5 trials by MAE:")\n            sorted_trials = sorted(\n                trials, \n                key=lambda t: t.get(\'metrics\', {}).get(\'mae\', float(\'inf\'))\n            )\n            for i, trial in enumerate(sorted_trials[:5], 1):\n                params = trial.get(\'params\', {})\n                metrics = trial.get(\'metrics\', {})\n                print(f"\\n  Trial {i}:")\n                print(f"    Params: {json.dumps(params)}")\n                print(f"    MAE: {metrics.get(\'mae\', \'N/A\')}")\n                print(f"    RMSE: {metrics.get(\'rmse\', \'N/A\')}")\n                print(f"    MAPE: {metrics.get(\'mape\', \'N/A\')}")\n                print(f"    Status: {trial.get(\'status\')}")\n        \n        print