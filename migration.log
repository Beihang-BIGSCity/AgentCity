[TGraphormer:migration] 2026-01-30 17:46:38 | INFO | Tool Write called with {'file_path': '/home/wangwenrui/shk/AgentCity/Bigscity-LibCity/libcity/model/traffic_speed_prediction/TGraphormer.py', 'content': '"""\nTGraphormer: Graphormer-based model for traffic speed prediction.\n\nThis module adapts the TGraphormer model to the LibCity framework.\nOriginal source: https://github.com/QI-Joe/TGraphormer\n\nKey adaptations:\n- Inherits from AbstractTrafficStateModel\n- Adapts forward signature to LibCity\'s batch format (dict with \'X\', \'y\' keys)\n- Transforms data from LibCity format [batch, time, nodes, features] to TGraphormer format\n- Computes graph structure (spatial positions, attention bias) from adjacency matrix\n- Integrates with LibCity\'s scaler for inverse transformation\n\nModel variants available:\n- micro: embed_dim=64, depth=6, heads=2\n- mini: embed_dim=128, depth=6, heads=4\n- small: embed_dim=192, depth=8, heads=6 (default)\n- med: embed_dim=384, depth=10, heads=8\n- big: embed_dim=768, depth=12, heads=12\n- large: embed_dim=1024, depth=24, heads=16\n- xl: embed_dim=1280, depth=32, heads=16\n"""\n\nimport math\nfrom functools import partial\nfrom typing import Optional, Callable, Union\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport numpy as np\nimport scipy.sparse as sp\nfrom scipy.sparse.csgraph import shortest_path\nfrom logging import getLogger\n\nfrom libcity.model.abstract_traffic_state_model import AbstractTrafficStateModel\nfrom libcity.model import loss\n\n\n# ============================================================================\n# Utility Modules from TGraphormer\n# ============================================================================\n\nclass Conv2D(nn.Module):\n    """\n    2D-convolution block from TGraphormer.\n    Used for converting traffic data features to embedding dimension.\n    """\n\n    def __init__(\n            self,\n            input_dims: int,\n            output_dims: int,\n            kernel_size: Union[tuple, list],\n            stride: Union[tuple, list] = (1, 1),\n            use_bias: bool = False,\n            activation: Optional[Callable[[torch.FloatTensor], torch.FloatTensor]] = F.gelu,\n    ):\n        super(Conv2D, self).__init__()\n        self.activation = activation\n        self.conv = nn.Conv2d(\n            input_dims,\n            output_dims,\n            kernel_size,\n            stride=stride,\n            padding=0,\n            bias=use_bias,\n        )\n        self.batch_norm = nn.BatchNorm2d(output_dims)\n\n    def forward(self, x):\n        """\n        Args:\n            x: (batch_size, input_dims, num_nodes, num_his)\n        Returns:\n            x: (batch_size, output_dims, num_nodes, num_his)\n        """\n        x = self.conv(x)\n        x = self.batch_norm(x)\n        if self.activation is not None:\n            x = self.activation(x)\n        return x\n\n\nclass FC(nn.Module):\n    """Fully-connected layer using 1x1 convolutions."""\n\n    def __init__(self, input_dims, units, activations, use_bias):\n        super(FC, self).__init__()\n        if isinstance(units, int):\n            units = [units]\n            input_dims = [input_dims]\n            activations = [activations]\n        elif isinstance(units, tuple):\n            units = list(units)\n            input_dims = list(input_dims)\n            activations = list(activations)\n        assert type(units) == list\n        self.convs = nn.ModuleList(\n            [\n                Conv2D(\n                    input_dims=input_dim,\n                    output_dims=num_unit,\n                    kernel_size=[1, 1],\n                    stride=[1, 1],\n                    use_bias=use_bias,\n                    activation=activation,\n                )\n                for input_dim, num_unit, activation in zip(\n                input_dims, units, activations\n            )\n            ]\n        )\n\n    def forward(self, x):\n        """\n        Args:\n            x: (batch_size, num_his, num_nodes, input_dim[0])\n        Returns:\n            x: (batch_size, num_his, num_nodes, units[-1])\n        """\n        x = x.contiguous().permute(0, 3, 2, 1)\n        for conv in self.convs:\n            x = conv(x)\n        x = x.contiguous().permute(0, 3, 2, 1)\n        return x\n\n\n# ============================================================================\n# Graphormer Core Modules\n# ============================================================================\n\nclass GraphNodeFeature(nn.Module):\n    """\n    Compute node features for each node in the graph.\n    Includes optional centrality encoding using in/out degree embeddings.\n    """\n\n    def __init__(\n            self,\n            node_feature_dim,\n            num_heads,\n            num_nodes,\n            num_in_degree,\n            num_out_degree,\n            hidden_dim,\n            start_conv=True,\n            centrality_encoding=True,\n            act_fn=\'gelu\',\n    ):\n        super(GraphNodeFeature, self).__init__()\n        self.num_heads = num_heads\n        self.num_nodes = num_nodes\n        self.start_conv = start_conv\n        self.centrality_encoding = centrality_encoding\n\n        self.activation = nn.GELU() if act_fn == \'gelu\' else nn.ReLU()\n        if self.start_conv:\n            self.fc = FC(\n                input_dims=[node_feature_dim, hidden_dim],\n                units=[hidden_dim, hidden_dim],\n                activations=[self.activation, None],\n                use_bias=False,\n            )\n            if centrality_encoding:\n                self.in_degree_encoder = nn.Embedding(\n                    num_in_degree + 1, hidden_dim, padding_idx=0\n                )\n                self.out_degree_encoder = nn.Embedding(\n                    num_out_degree + 1, hidden_dim, padding_idx=0\n                )\n\n    def forward(self, x, in_degree, out_degree):\n        if self.start_conv:\n            x = self.fc(x)\n        if self.centrality_encoding:\n            centrality_encodings = (\n                    self.in_degree_encoder(in_degree)\n                    + self.out_degree_encoder(out_degree)\n            )\n            x = x + centrality_encodings.unsqueeze(1)\n        return x\n\n\nclass GraphAttnBias(nn.Module):\n    """\n    Compute attention bias for each head based on graph structure.\n    Uses spatial position encoding based on shortest path distances.\n    """\n\n    def __init__(\n            self,\n            num_heads,\n            num_spatial,\n    ):\n        super(GraphAttnBias, self).__init__()\n        self.num_heads = num_heads\n        # Embedding based on distance (shortest path)\n        self.spatial_pos_encoder = nn.Embedding(num_spatial + 1, num_heads, padding_idx=0)\n\n    def forward(self, attn_bias, spatial_pos, x):\n        """\n        Args:\n            attn_bias: base attention bias [N, V, V]\n            spatial_pos: shortest path distances [N, V, V]\n            x: input tensor [N, T, V, D]\n        Returns:\n            graph_attn_bias: [N, num_heads, V, V]\n        """\n        N, T, V, D = x.shape\n        graph_attn_bias = attn_bias.clone()\n        graph_attn_bias = graph_attn_bias.unsqueeze(1).repeat(\n            1, self.num_heads, 1, 1\n        )  # [N, n_head, V, V]\n\n        # Spatial position bias\n        spatial_pos_bias = self.spatial_pos_encoder(spatial_pos).contiguous().permute(0, 3, 1, 2)\n        graph_attn_bias = graph_attn_bias + spatial_pos_bias\n\n        # Add base attn_bias again (following original implementation)\n        graph_attn_bias = graph_attn_bias + attn_bias.unsqueeze(1)\n\n        return graph_attn_bias\n\n\nclass MultiheadAttention(nn.Module):\n    """Multi-headed attention with graph attention bias."""\n\n    def __init__(\n            self,\n            embed_dim,\n            num_heads,\n            dropout=0.0,\n            bias=True,\n    ):\n        super().__init__()\n        self.embed_dim = embed_dim\n        self.num_heads = num_heads\n        self.dropout_module = nn.Dropout(dropout)\n\n        self.head_dim = embed_dim // num_heads\n        assert (\n                self.head_dim * num_heads == self.embed_dim\n        ), "embed_dim must be divisible by num_heads"\n        self.scaling = self.head_dim ** -0.5\n\n        self.k_proj = nn.Linear(embed_dim, embed_dim, bias=bias)\n        self.v_proj = nn.Linear(embed_dim, embed_dim, bias=bias)\n        self.q_proj = nn.Linear(embed_dim, embed_dim, bias=bias)\n        self.out_proj = nn.Linear(embed_dim, embed_dim, bias=bias)\n        self.reset_parameters()\n\n    def reset_parameters(self):\n        nn.init.xavier_uniform_(self.k_proj.weight, gain=1 / math.sqrt(2))\n        nn.init.xavier_uniform_(self.v_proj.weight, gain=1 / math.sqrt(2))\n        nn.init.xavier_uniform_(self.q_proj.weight, gain=1 / math.sqrt(2))\n        nn.init.xavier_uniform_(self.out_proj.weight)\n        if self.out_proj.bias is not None:\n            nn.init.constant_(self.out_proj.bias, 0.0)\n\n    def forward(\n            self,\n            query,\n            key: Optional[torch.Tensor],\n            value: Optional[torch.Tensor],\n            attn_bias: Optional[torch.Tensor],\n            key_padding_mask: Optional[torch.Tensor] = None,\n            need_weights: bool = False,\n            attn_mask: Optional[torch.Tensor] = None,\n    ):\n        """\n        Args:\n            query: [T, B, D]\n            key: [T, B, D]\n            value: [T, B, D]\n            attn_bias: [B, num_heads, T, T]\n        Returns:\n            attn: [T, B, D]\n            attn_weights: optional\n        """\n        tgt_len, bsz, embed_dim = query.size()\n        src_len = tgt_len\n\n        q = self.q_proj(query)\n        k = self.k_proj(query)\n        v = self.v_proj(query)\n        q *= self.scaling\n\n        q = q.contiguous().view(tgt_len, bsz * self.num_heads, self.head_dim).transpose(0, 1)\n        k = k.contiguous().view(-1, bsz * self.num_heads, self.head_dim).transpose(0, 1)\n        v = v.contiguous().view(-1, bsz * self.num_heads, self.head_dim).transpose(0, 1)\n\n        attn_weights = torch.bmm(q, k.contiguous().transpose(1, 2))\n\n        if attn_bias is not None:\n            attn_weights += attn_bias.view(bsz * self.num_heads, tgt_len, src_len)\n\n        if attn_mask is not None:\n            attn_mask = attn_mask.unsqueeze(0)\n            attn_weights += attn_mask\n\n        if key_padding_mask is not None:\n            attn_weights = attn_weights.view(bsz, self.num_heads, tgt_len, src_len)\n            attn_weights = attn_weights.masked_fill(\n                key_padding_mask.unsqueeze(1).unsqueeze(2).to(torch.bool),\n                float("-inf"),\n            )\n            attn_weights = attn_weights.view(bsz * self.num_heads, tgt_len, src_len)\n\n        attn_weights_float = F.softmax(attn_weights, dim=-1)\n        attn_weights = attn_weights_float.type_as(attn_weights)\n        attn_probs = self.dropout_module(attn_weights)\n\n        attn = torch.bmm(attn_probs, v)\n        attn = attn.transpose(0, 1).contiguous().view(tgt_len, bsz, embed_dim)\n        attn = self.out_proj(attn)\n\n        attn_weights_out = None\n        if need_weights:\n            attn_weights_out = attn_weights_float.contiguous().view(\n                bsz, self.num_heads, tgt_len, src_len\n            ).transpose(1, 0)\n\n        return attn, attn_weights_out\n\n\nclass GraphormerGraphEncoderLayer(nn.Module):\n    """Single Graphormer encoder layer with self-attention and FFN."""\n\n    def __init__(\n            self,\n            embedding_dim: int = 768,\n            ffn_embedding_dim: int = 3072,\n            num_attention_heads: int = 8,\n            dropout: float = 0.1,\n            attention_dropout: float = 0.1,\n            activation_dropout: float = 0.1,\n            activation_fn: str = "gelu",\n            pre_layernorm: bool = True,\n    ):\n        super().__init__()\n        self.embedding_dim = embedding_dim\n        self.num_attention_heads = num_attention_heads\n        self.attention_dropout = attention_dropout\n        self.pre_layernorm = pre_layernorm\n\n        self.dropout_module = nn.Dropout(dropout)\n        self.activation_dropout_module = nn.Dropout(activation_dropout)\n        self.activation_fn = nn.GELU() if activation_fn == "gelu" else nn.ReLU()\n\n        self.self_attn = MultiheadAttention(\n            self.embedding_dim,\n            num_attention_heads,\n            dropout=attention_dropout,\n        )\n        self.self_attn_layer_norm = nn.LayerNorm(self.embedding_dim, eps=1e-8)\n        self.fc1 = nn.Linear(self.embedding_dim, ffn_embedding_dim)\n        self.fc2 = nn.Linear(ffn_embedding_dim, self.embedding_dim)\n        self.final_layer_norm = nn.LayerNorm(self.embedding_dim, eps=1e-8)\n\n    def forward(\n            self,\n            x: torch.Tensor,\n            self_attn_bias: Optional[torch.Tensor] = None,\n            self_attn_mask: Optional[torch.Tensor] = None,\n            self_attn_padding_mask: Optional[torch.Tensor] = None,\n    ):\n        """\n        Args:\n            x: [T, B, D]\n        Returns:\n            x: [T, B, D]\n        """\n        residual = x\n        if self.pre_layernorm:\n            x = self.self_attn_layer_norm(x)\n        x, attn = self.self_attn(\n            query=x,\n            key=x,\n            value=x,\n            attn_bias=self_attn_bias,\n            key_padding_mask=self_attn_padding_mask,\n            need_weights=False,\n            attn_mask=self_attn_mask,\n        )\n        x = self.dropout_module(x)\n        x = residual + x\n        if not self.pre_layernorm:\n            x = self.self_attn_layer_norm(x)\n\n        residual = x\n        if self.pre_layernorm:\n            x = self.final_layer_norm(x)\n        x = self.activation_fn(self.fc1(x))\n        x = self.activation_dropout_module(x)\n        x = self.fc2(x)\n        x = self.dropout_module(x)\n        x = residual + x\n        if not self.pre_layernorm:\n            x = self.final_layer_norm(x)\n        return x, attn\n\n\nclass GraphormerGraphEncoder(nn.Module):\n    """Full Graphormer encoder with multiple layers."""\n\n    def __init__(\n            self,\n            node_feature_dim: int,\n            num_nodes: int,\n            num_in_degree: int,\n            num_out_degree: int,\n            num_spatial: int,\n            num_encoder_layers: int = 12,\n            embedding_dim: int = 768,\n            ffn_embedding_dim: int = 768,\n            num_attention_heads: int = 32,\n            dropout: float = 0.1,\n            attention_dropout: float = 0.1,\n            activation_dropout: float = 0.1,\n            encoder_normalize_before: bool = True,\n            pre_layernorm: bool = True,\n            activation_fn: str = "gelu",\n            centrality_encoding: bool = True,\n            attention_bias: bool = True,\n    ):\n        super().__init__()\n        self.dropout_module = nn.Dropout(dropout)\n        self.embedding_dim = embedding_dim\n        self.centrality_encoding = centrality_encoding\n        self.attention_bias = attention_bias\n\n        self.graph_node_feature = GraphNodeFeature(\n            node_feature_dim=node_feature_dim,\n            num_heads=num_attention_heads,\n            num_nodes=num_nodes,\n            num_in_degree=num_in_degree,\n            num_out_degree=num_out_degree,\n            hidden_dim=embedding_dim,\n            start_conv=True,\n            centrality_encoding=centrality_encoding,\n            act_fn=activation_fn,\n        )\n\n        if self.attention_bias:\n            self.graph_attn_bias = GraphAttnBias(\n                num_heads=num_attention_heads,\n                num_spatial=num_spatial,\n            )\n\n        if encoder_normalize_before:\n            self.emb_layer_norm = nn.LayerNorm(self.embedding_dim, eps=1e-8)\n        else:\n            self.emb_layer_norm = None\n\n        self.layers = nn.ModuleList([\n            GraphormerGraphEncoderLayer(\n                embedding_dim=embedding_dim,\n                ffn_embedding_dim=ffn_embedding_dim,\n                num_attention_heads=num_attention_heads,\n                dropout=dropout,\n                attention_dropout=attention_dropout,\n                activation_dropout=activation_dropout,\n                activation_fn=activation_fn,\n                pre_layernorm=pre_layernorm,\n            )\n            for _ in range(num_encoder_layers)\n        ])\n\n    def compute_mods(self, x, in_degree, out_degree, attn_bias, spatial_pos):\n        """Compute node features and attention bias."""\n        x = self.graph_node_feature(x, in_degree, out_degree)\n\n        graph_attn_bias = None\n        if self.attention_bias:\n            graph_attn_bias = self.graph_attn_bias(attn_bias, spatial_pos, x)\n        return x, graph_attn_bias\n\n    def forward(\n            self,\n            x,\n            attn_bias=None,\n            last_state_only: bool = True,\n    ):\n        """\n        Args:\n            x: [B, T, D]\n            attn_bias: [B, num_heads, T, T]\n        Returns:\n            inner_states: list of [T, B, D]\n        """\n        B, T, D = x.shape\n\n        if self.emb_layer_norm is not None:\n            x = self.emb_layer_norm(x)\n        x = self.dropout_module(x)\n\n        # B x T x D -> T x B x D\n        x = x.contiguous().transpose(0, 1)\n\n        inner_states = []\n        if not last_state_only:\n            inner_states.append(x)\n\n        for layer in self.layers:\n            x, attn = layer(\n                x,\n                self_attn_padding_mask=None,\n                self_attn_mask=None,\n                self_attn_bias=attn_bias,\n            )\n            if not last_state_only:\n                inner_states.append(x)\n\n        if last_state_only:\n            inner_states = [x]\n\n        return inner_states\n\n\n# ============================================================================\n# TGraphormer LibCity Adapter\n# ============================================================================\n\nclass TGraphormer(AbstractTrafficStateModel):\n    """\n    TGraphormer: Graphormer-based model for traffic speed prediction.\n\n    Adapted for LibCity framework from the original TGraphormer implementation.\n\n    Key features:\n    - Graphormer architecture with spatial attention bias\n    - Centrality encoding using node degree embeddings\n    - CLS token for global representation\n    - Convolutional prediction head\n\n    Config parameters:\n        - model_size: \'micro\', \'mini\', \'small\', \'med\', \'big\', \'large\', \'xl\'\n        - encoder_embed_dim: embedding dimension (overrides model_size)\n        - encoder_depth: number of transformer layers (overrides model_size)\n        - num_heads: number of attention heads (overrides model_size)\n        - dropout: dropout rate\n        - num_spatial: max spatial distance for encoding\n        - end_channel: intermediate prediction channel size\n        - use_conv: whether to use convolution for prediction\n        - cls_token: whether to use CLS token\n        - attention_bias: whether to use graph attention bias\n        - centrality_encoding: whether to use degree-based centrality encoding\n    """\n\n    # Model size configurations\n    MODEL_CONFIGS = {\n        \'micro\': {\'encoder_embed_dim\': 64, \'encoder_depth\': 6, \'num_heads\': 2},\n        \'mini\': {\'encoder_embed_dim\': 128, \'encoder_depth\': 6, \'num_heads\': 4},\n        \'small\': {\'encoder_embed_dim\': 192, \'encoder_depth\': 8, \'num_heads\': 6},\n        \'med\': {\'encoder_embed_dim\': 384, \'encoder_depth\': 10, \'num_heads\': 8},\n        \'big\': {\'encoder_embed_dim\': 768, \'encoder_depth\': 12, \'num_heads\': 12},\n        \'large\': {\'encoder_embed_dim\': 1024, \'encoder_depth\': 24, \'num_heads\': 16},\n        \'xl\': {\'encoder_embed_dim\': 1280, \'encoder_depth\': 32, \'num_heads\': 16},\n    }\n\n    def __init__(self, config, data_feature):\n        super().__init__(config, data_feature)\n\n        self._logger = getLogger()\n\n        # Data features from LibCity\n        self.adj_mx = data_feature.get(\'adj_mx\')\n        self.num_nodes = data_feature.get(\'num_nodes\', 1)\n        self.feature_dim = data_feature.get(\'feature_dim\', 1)\n        self.output_dim = data_feature.get(\'output_dim\', 1)\n        self._scaler = data_feature.get(\'scaler\')\n\n        # Model configuration\n        self.input_window = config.get(\'input_window\', 12)\n        self.output_window = config.get(\'output_window\', 12)\n        self.device = config.get(\'device\', torch.device(\'cpu\'))\n\n        # Model size selection\n        model_size = config.get(\'model_size\', \'small\')\n        if model_size in self.MODEL_CONFIGS:\n            default_config = self.MODEL_CONFIGS[model_size]\n        else:\n            default_config = self.MODEL_CONFIGS[\'small\']\n            self._logger.warning(f"Unknown model_size \'{model_size}\', using \'small\'")\n\n        # TGraphormer specific parameters\n        self.encoder_embed_dim = config.get(\'encoder_embed_dim\', default_config[\'encoder_embed_dim\'])\n        self.encoder_depth = config.get(\'encoder_depth\', default_config[\'encoder_depth\'])\n        self.num_heads = config.get(\'num_heads\', default_config[\'num_heads\'])\n        self.dropout = config.get(\'dropout\', 0.1)\n        self.num_spatial = config.get(\'num_spatial\', 512)\n        self.end_channel = config.get(\'end_channel\', 512)\n        self.use_conv = config.get(\'use_conv\', True)\n        self.cls_token = config.get(\'cls_token\', True)\n        self.attention_bias = config.get(\'attention_bias\', True)\n        self.centrality_encoding = config.get(\'centrality_encoding\', True)\n        self.sep_pos_embed = config.get(\'sep_pos_embed\', False)\n        self.batch_norm = config.get(\'batch_norm\', True)\n        self.act_fn = config.get(\'act_fn\', \'gelu\')\n\n        # Compute graph properties from adjacency matrix\n        self._compute_graph_properties()\n\n        # Build model components\n        self._build_model()\n\n        # Initialize weights\n        self.initialize_weights()\n\n        self._logger.info(f"TGraphormer initialized: size={model_size}, "\n                          f"embed_dim={self.encoder_embed_dim}, depth={self.encoder_depth}, "\n                          f"heads={self.num_heads}, nodes={self.num_nodes}")\n\n    def _compute_graph_properties(self):\n        """Compute graph properties from adjacency matrix for Graphormer."""\n        adj = self.adj_mx\n        if isinstance(adj, torch.Tensor):\n            adj = adj.cpu().numpy()\n\n        # Compute in-degree and out-degree\n        adj_binary = (adj > 0).astype(np.float32)\n        self.in_degree = np.sum(adj_binary, axis=0).astype(np.int64)\n        self.out_degree = np.sum(adj_binary, axis=1).astype(np.int64)\n\n        # Clamp degrees to avoid embedding index out of range\n        max_degree = min(self.num_spatial, 512)\n        self.in_degree = np.clip(self.in_degree, 0, max_degree)\n        self.out_degree = np.clip(self.out_degree, 0, max_degree)\n\n        # Compute shortest path distances for spatial encoding\n        # Use binary adjacency for shortest path computation\n        try:\n            dist_matrix = shortest_path(adj_binary, directed=False, unweighted=True)\n            dist_matrix = np.where(np.isinf(dist_matrix), self.num_spatial, dist_matrix)\n            self.spatial_pos = np.clip(dist_matrix.astype(np.int64), 0, self.num_spatial)\n        except Exception as e:\n            self._logger.warning(f"Failed to compute shortest paths: {e}. Using default.")\n            self.spatial_pos = np.ones((self.num_nodes, self.num_nodes), dtype=np.int64)\n\n        # Base attention bias (zeros)\n        self.base_attn_bias = np.zeros((self.num_nodes, self.num_nodes), dtype=np.float32)\n\n    def _build_model(self):\n        """Build the TGraphormer model components."""\n        # CLS token\n        if self.cls_token:\n            self.cls_token_embed = nn.Parameter(torch.zeros(1, 1, self.encoder_embed_dim))\n            if self.attention_bias:\n                self.cls_token_virtual_distance = nn.Embedding(1, self.num_heads)\n\n        # Position embeddings\n        if self.sep_pos_embed:\n            self.pos_embed_time = nn.Parameter(\n                torch.zeros(1, self.input_window, self.encoder_embed_dim)\n            )\n            self.pos_embed_space = nn.Parameter(\n                torch.zeros(1, self.num_nodes, self.encoder_embed_dim)\n            )\n            if self.cls_token:\n                self.pos_embed_cls = nn.Parameter(torch.zeros(1, 1, self.encoder_embed_dim))\n        else:\n            if self.cls_token:\n                self.pos_embed = nn.Parameter(\n                    torch.zeros(1, self.input_window * self.num_nodes + 1, self.encoder_embed_dim)\n                )\n            else:\n                self.pos_embed = nn.Parameter(\n                    torch.zeros(1, self.input_window * self.num_nodes, self.encoder_embed_dim)\n                )\n\n        # Graphormer encoder\n        self.blocks = GraphormerGraphEncoder(\n            node_feature_dim=self.feature_dim,\n            num_nodes=self.num_nodes,\n            num_in_degree=self.num_spatial,\n            num_out_degree=self.num_spatial,\n            num_spatial=self.num_spatial,\n            num_encoder_layers=self.encoder_depth,\n            embedding_dim=self.encoder_embed_dim,\n            ffn_embedding_dim=self.encoder_embed_dim * 4,\n            num_attention_heads=self.num_heads,\n            dropout=self.dropout,\n            centrality_encoding=self.centrality_encoding,\n            attention_bias=self.attention_bias,\n            activation_fn=self.act_fn,\n        )\n\n        # Layer normalization\n        self.norm = nn.LayerNorm(self.encoder_embed_dim, eps=1e-8)\n\n        # Prediction head\n        self.activation = nn.GELU() if self.act_fn == \'gelu\' else nn.ReLU()\n\n        if self.output_window > self.input_window:\n            self.fc_project = nn.Linear(\n                self.input_window * self.encoder_embed_dim,\n                self.output_window * self.end_channel\n            )\n            if self.batch_norm:\n                self.layer_norm = nn.LayerNorm(self.end_channel)\n            self.end_conv_2 = nn.Conv2d(\n                in_channels=self.end_channel,\n                out_channels=self.output_dim,\n                kernel_size=(1, 1),\n                bias=True\n            )\n        else:\n            if self.use_conv:\n                self.end_conv_1 = nn.Conv2d(\n                    in_channels=self.encoder_embed_dim,\n                    out_channels=self.end_channel,\n                    kernel_size=(1, 1),\n                    bias=False if self.batch_norm else True,\n                )\n                if self.batch_norm:\n                    self.pred_batch_norm = nn.BatchNorm2d(self.end_channel)\n                self.end_conv_2 = nn.Conv2d(\n                    in_channels=self.end_channel,\n                    out_channels=self.output_dim,\n                    kernel_size=(1, 1),\n                    bias=True\n                )\n            else:\n                self.fc_channel = nn.Linear(self.encoder_embed_dim, self.output_dim)\n                self.mlp_pred_dropout = nn.Dropout(0.5)\n                self.fc_his = nn.Linear(self.input_window, self.output_window)\n\n    def initialize_weights(self):\n        """Initialize model weights."""\n        # Position embeddings\n        if self.sep_pos_embed:\n            nn.init.trunc_normal_(self.pos_embed_time, std=0.02)\n            nn.init.trunc_normal_(self.pos_embed_space, std=0.02)\n            if self.cls_token:\n                nn.init.trunc_normal_(self.pos_embed_cls, std=0.02)\n        else:\n            nn.init.trunc_normal_(self.pos_embed, std=0.02)\n\n        # CLS token\n        if self.cls_token:\n            nn.init.trunc_normal_(self.cls_token_embed, std=0.02)\n            if self.attention_bias:\n                nn.init.trunc_normal_(self.cls_token_virtual_distance.weight, std=0.02)\n\n        # Centrality encoding\n        if self.centrality_encoding:\n            nn.init.trunc_normal_(\n                self.blocks.graph_node_feature.in_degree_encoder.weight,\n                mean=0.0, std=0.02\n            )\n            nn.init.trunc_normal_(\n                self.blocks.graph_node_feature.out_degree_encoder.weight,\n                mean=0.0, std=0.02\n            )\n\n        # Attention bias\n        if self.attention_bias:\n            nn.init.trunc_normal_(\n                self.blocks.graph_attn_bias.spatial_pos_encoder.weight,\n                mean=0.0, std=0.02\n            )\n\n        # Linear and LayerNorm layers\n        self.apply(self._init_weights)\n\n    def _init_weights(self, m):\n        """Initialize individual layer weights."""\n        if isinstance(m, nn.Linear):\n            nn.init.xavier_uniform_(m.weight)\n            if m.bias is not None:\n                nn.init.constant_(m.bias, 0)\n        elif isinstance(m, nn.LayerNorm):\n            nn.init.constant_(m.bias, 0)\n            nn.init.constant_(m.weight, 1.0)\n        elif isinstance(m, nn.BatchNorm2d):\n            nn.init.constant_(m.bias, 0)\n            nn.init.constant_(m.weight, 1.0)\n        elif isinstance(m, nn.Conv2d):\n            nn.init.xavier_uniform_(m.weight)\n            if m.bias is not None:\n                nn.init.constant_(m.bias, 0)\n\n    def _prepare_graph_data(self, batch_size):\n        """Prepare graph data tensors for the batch."""\n        device = self.device\n\n        # In/out degrees [batch, num_nodes]\n        in_degree = torch.from_numpy(self.in_degree).long().to(device)\n        out_degree = torch.from_numpy(self.out_degree).long().to(device)\n        in_degree = in_degree.unsqueeze(0).expand(batch_size, -1)\n        out_degree = out_degree.unsqueeze(0).expand(batch_size, -1)\n\n        # Spatial positions [batch, num_nodes, num_nodes]\n        spatial_pos = torch.from_numpy(self.spatial_pos).long().to(device)\n        spatial_pos = spatial_pos.unsqueeze(0).expand(batch_size, -1, -1)\n\n        # Base attention bias [batch, num_nodes, num_nodes]\n        attn_bias = torch.from_numpy(self.base_attn_bias).float().to(device)\n        attn_bias = attn_bias.unsqueeze(0).expand(batch_size, -1, -1)\n\n        return in_degree, out_degree, spatial_pos, attn_bias\n\n    def add_token_distance(self, attn_bias, device):\n        """Add virtual distance for CLS token to attention bias."""\n        if not self.attention_bias:\n            return None\n\n        N, n_heads, L, _ = attn_bias.shape\n\n        # Add row and column for CLS token\n        attn_bias = torch.cat(\n            [torch.zeros(N, n_heads, 1, L, device=device), attn_bias],\n            dim=2\n        )\n        attn_bias = torch.cat(\n            [torch.zeros(N, n_heads, L + 1, 1, device=device), attn_bias],\n            dim=3\n        )\n\n        # Add virtual distance bias\n        t = self.cls_token_virtual_distance.weight.repeat(N, 1).contiguous().view(-1, n_heads, 1)\n        attn_bias[:, :, 1:, 0] = attn_bias.clone()[:, :, 1:, 0] + t\n        attn_bias[:, :, 0, :] = attn_bias.clone()[:, :, 0, :] + t\n\n        return attn_bias\n\n    def forward_encoder(self, x, attn_bias):\n        """\n        Encode input through the Graphormer encoder.\n\n        Args:\n            x: [N, T, V, D] input tensor\n            attn_bias: [N, num_heads, V, V] attention bias\n        Returns:\n            x: encoded tensor\n            x_shape: original input shape\n        """\n        x_shape = list(x.shape)\n        N, T, V, D = x_shape\n\n        # Flatten to [N, T*V, D]\n        x = x.contiguous().view(N, -1, D)\n\n        # Add CLS token\n        if self.cls_token:\n            cls_embed = self.cls_token_embed.expand(N, -1, -1)\n            x = torch.cat((cls_embed, x), dim=1)\n\n        # Expand attention bias for time dimension\n        if self.attention_bias and attn_bias is not None:\n            attn_bias = attn_bias.repeat(1, 1, T, T)\n\n        # Add CLS token distance\n        if self.cls_token and self.attention_bias:\n            attn_bias = self.add_token_distance(attn_bias, x.device)\n\n        # Add position embeddings\n        if self.sep_pos_embed:\n            pos_embed = self.pos_embed_space.repeat(1, T, 1) + \\\n                        torch.repeat_interleave(self.pos_embed_time, V, dim=1)\n            pos_embed = pos_embed.expand(N, -1, -1)\n            if self.cls_token:\n                pos_embed_token = self.pos_embed_cls.expand(N, -1, -1)\n                pos_embed = torch.cat([pos_embed_token, pos_embed], dim=1)\n        else:\n            pos_embed = self.pos_embed[:, :, :].expand(N, -1, -1)\n\n        x = x + pos_embed\n\n        # Apply transformer blocks\n        inner_states = self.blocks(x, attn_bias)\n        x = inner_states[-1].contiguous().transpose(0, 1)\n\n        # Remove CLS token\n        if self.cls_token:\n            x = x[:, 1:, :]\n\n        return x, x_shape\n\n    def forward_pred(self, x, x_shape):\n        """\n        Prediction head: project encoded features to output.\n\n        Args:\n            x: [N, T*V, D] encoded tensor\n            x_shape: [N, T, V, D] original shape\n        Returns:\n            pred: [N, output_window, V, output_dim]\n        """\n        N, T, V, D = x_shape\n\n        if self.output_window > self.input_window:\n            # Project to larger time dimension\n            x = x.contiguous().view(N, V, T, D).view(N, V, T * D)\n            x = self.fc_project(x)\n            x = x.view(N, V, self.output_window, self.end_channel)\n            if hasattr(self, \'layer_norm\'):\n                x = self.layer_norm(x)\n            x = self.activation(x)\n            x = x.contiguous().transpose(1, 3)\n            x = self.end_conv_2(x)\n            x = x.contiguous().permute(0, 2, 3, 1)\n        else:\n            x = x.contiguous().view(N, T, V, D).transpose(1, 3)  # [N, D, V, T]\n            if self.use_conv:\n                x = self.end_conv_1(x)\n                if hasattr(self, \'pred_batch_norm\'):\n                    x = self.pred_batch_norm(x)\n                x = self.activation(x)\n                x = self.end_conv_2(x)\n                x = x.transpose(1, 3)  # [N, T, V, output_dim]\n            else:\n                x = self.fc_his(x).transpose(1, 3)\n                x = self.activation(x)\n                x = self.mlp_pred_dropout(x)\n                x = self.fc_channel(x)\n\n        return x\n\n    def forward(self, batch):\n        """\n        Forward pass for LibCity batch.\n\n        Args:\n            batch: dict with \'X\' key containing input tensor\n                   X shape: [batch, input_window, num_nodes, feature_dim]\n        Returns:\n            pred: [batch, output_window, num_nodes, output_dim]\n        """\n        x = batch[\'X\']  # [N, T, V, F]\n        N = x.shape[0]\n\n        # Prepare graph data\n        in_degree, out_degree, spatial_pos, attn_bias_base = self._prepare_graph_data(N)\n\n        # Compute node features and attention bias\n        x_embed, attn_bias = self.blocks.compute_mods(\n            x, in_degree, out_degree, attn_bias_base, spatial_pos\n        )\n\n        # Encode\n        latent, x_shape = self.forward_encoder(x_embed, attn_bias)\n        latent = self.norm(latent)\n\n        # Predict\n        pred = self.forward_pred(latent, x_shape)\n\n        return pred\n\n    def predict(self, batch):\n        """\n        Predict method for LibCity.\n\n        Args:\n            batch: dict with \'X\' key\n        Returns:\n            pred: [batch, output_window, num_nodes, output_dim]\n        """\n        return self.forward(batch)\n\n    def calculate_loss(self, batch):\n        """\n        Calculate loss for training.\n\n        Args:\n            batch: dict with \'X\' and \'y\' keys\n        Returns:\n            loss: scalar tensor\n        """\n        y_true = batch[\'y\']\n        y_predicted = self.predict(batch)\n\n        # Apply inverse scaler transformation\n        y_true = self._scaler.inverse_transform(y_true[..., :self.output_dim])\n        y_predicted = self._scaler.inverse_transform(y_predicted[..., :self.output_dim])\n\n        return loss.masked_mae_torch(y_predicted, y_true, 0)\n'}
